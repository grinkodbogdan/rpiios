diff --git a/xnu/files/bsd/dev/redwood_tissot_buttons.c b/xnu/files/bsd/dev/redwood_tissot_buttons.c
new file mode 100644
index 0000000..46cfc5f
--- /dev/null
+++ b/xnu/files/bsd/dev/redwood_tissot_buttons.c
@@ -0,0 +1,380 @@
+/*
+ * The buttons of the Xiaomi Mi A1 (tissot, MSM8953) -- power, volume up, volume down -- as a
+ * source of button records for /dev/redwood-touch (sys/redwood_input.h). Only with boot-arg
+ * tissot=1 (or tissot_buttons=1): every address below belongs to that phone. The POCO's
+ * buttons=1 and touchscreen=1 must NOT be given on it; their addresses are another SoC's.
+ *
+ * Unlike the POCO, one of the three is a pin of the SoC:
+ *   power        KPDPWR_N of the power-on block ("PON", peripheral 0x08 of slave 0) of the PM8953
+ *   volume down  RESIN_N of the same block
+ *   volume up    GPIO85 of the SoC (TLMM), pulled up; the key pulls it low
+ * The PM8953 sits on the SPMI bus behind the SoC's PMIC arbiter, here of version 2 (the POCO's
+ * is version 5: the channel table moved, and the observer channels are 0x8000 apart, not 0x80).
+ * Reads go through the "observer" channels, which every system has for every peripheral.
+ *
+ * THIS DRIVER DOES NOT WRITE TO THE PMIC. The only thing written there is the command word that
+ * asks the arbiter for a read. The SoC pin of volume up is set to an input with its pull-up, as
+ * the phone's own device tree has it (gpio_key_default); that is a register of the SoC, which
+ * makes no supply.
+ *
+ * What a press is: the PON's "real time status" has a bit per key, set while the key is held;
+ * the pin's level is low while volume up is held. A thread looks 60 times a second, and a key has
+ * changed when two looks in a row say so. A key that reads as held before it has ever been seen
+ * released is not believed.
+ *
+ * The mapping: the Mi A1 has a power key on the side and two volume keys; its home button is a
+ * capacitive one under the glass that the touch controller does not report (it is the
+ * fingerprint sensor's). Power is the side button (REDWOOD_BUTTON_LOCK).
+ *
+ * The bring-up is made in steps, each said in the log before it is made. Boot-arg
+ * tissot_buttons_steps=N stops after the first N:
+ *   1  map the arbiter and read its version
+ *   2  find the channel of the power-on block
+ *   3  ask it what it is                                (the first transfer on the bus)
+ *   4  read what the keys say now; set up volume up's pin
+ *   5  watch them                                       (the default)
+ *
+ * Register layouts: Linux drivers/spmi/spmi-pmic-arb.c (arbiter version 2),
+ * drivers/input/misc/pm8941-pwrkey.c, drivers/pinctrl/qcom/pinctrl-msm8953.c, and the phone's
+ * device tree (arch/arm64/boot/dts/qcom/msm8953-xiaomi-tissot.dts, msm8953.dtsi, pm8953.dtsi).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the PMIC arbiter, version 2 ----------------------------------------------------------------- */
+
+#define ARB_CORE_PHYS           0x0200f000UL    /* "core": the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       0x02c00000UL    /* "obsrvr": 0x1000 per system within each channel's 0x8000 */
+#define ARB_OBSERVER_SIZE       0x800000UL
+#define ARB_SYSTEM              0               /* the device tree's "qcom,ee" */
+
+#define ARB_VERSION             0x000
+#define ARB_VERSION_2           0x20010000u
+#define ARB_VERSION_3           0x30000000u
+#define ARB_CHANNEL(n)          (0x800 + 4 * (n))       /* [19:8] slave and peripheral; 0: unused */
+#define ARB_MAX_CHANNELS        512             /* the table fills the rest of "core" */
+
+#define OBSERVER_COMMAND        0x00
+#define OBSERVER_STATUS         0x08
+#define OBSERVER_DATA0          0x18
+#define OBSERVER_DATA1          0x1c
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_READ            (1u << 27)      /* "extended register read long"; [11:4] register, [2:0] bytes - 1 */
+#define READ_TIMEOUT_US         2000
+
+static vm_offset_t arb_core, arb_observer;
+static uint32_t arb_channels;
+
+static struct {
+	uint64_t reads, failed;
+} bus;
+
+static vm_offset_t
+channel_of(uint16_t id)
+{
+	for (uint32_t n = 0; n < arb_channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n));
+
+		if (map != 0 && ((map >> 8) & 0xfff) == id) {
+			return arb_observer + 0x8000UL * n + 0x1000UL * ARB_SYSTEM;
+		}
+	}
+	return 0;
+}
+
+static bool
+arb_ready(void)
+{
+	static int state;               /* 0 not looked at, 1 usable, -1 not */
+	uint32_t version;
+
+	if (state != 0) {
+		return state > 0;
+	}
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	version = rd(arb_core + ARB_VERSION);
+	printf("tissot-spmi: PMIC arbiter at %#lx, version %#x\n", ARB_CORE_PHYS, version);
+	if (version < ARB_VERSION_2 || version >= ARB_VERSION_3) {
+		printf("tissot-spmi: this driver knows version 2 of the arbiter only\n");
+		state = -1;
+		return false;
+	}
+	arb_channels = ARB_MAX_CHANNELS;
+	state = 1;
+	return true;
+}
+
+/*
+ * Read `count` (1 to 8) registers of a PMIC peripheral (`id` = slave << 8 | peripheral) from
+ * register `reg` on. Returns NULL, or what went wrong. Also for the touch screen's driver, which
+ * looks at the regulator that powers it.
+ */
+const char *
+redwood_tissot_spmi_read(uint16_t id, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	static struct {
+		uint16_t id;
+		vm_offset_t channel;
+	} known[8];
+	vm_offset_t channel = 0;
+	uint64_t start, interval;
+	uint32_t status, data[2];
+
+	if (count == 0 || count > 8) {
+		return "a read is of 1 to 8 registers";
+	}
+	if (!arb_ready()) {
+		return "no arbiter this driver knows";
+	}
+	for (unsigned i = 0; i < 8 && known[i].channel != 0; i++) {
+		if (known[i].id == id) {
+			channel = known[i].channel;
+		}
+	}
+	if (channel == 0) {
+		channel = channel_of(id);
+		if (channel == 0) {
+			return "no channel of the arbiter is that peripheral";
+		}
+		for (unsigned i = 0; i < 8; i++) {
+			if (known[i].channel == 0) {
+				known[i].id = id;
+				known[i].channel = channel;
+				break;
+			}
+		}
+	}
+
+	nanoseconds_to_absolutetime(READ_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	start = mach_absolute_time();
+	redwood_spmi_lock();
+	wr(channel + OBSERVER_COMMAND, COMMAND_READ | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + OBSERVER_STATUS);
+	} while (!(status & STATUS_DONE) && mach_absolute_time() - start < interval);
+	data[0] = rd(channel + OBSERVER_DATA0);
+	data[1] = count > 4 ? rd(channel + OBSERVER_DATA1) : 0;
+	redwood_spmi_unlock();
+
+	bus.reads++;
+	if (!(status & STATUS_DONE)) {
+		bus.failed++;
+		return "no answer from the arbiter";
+	}
+	if (status & (STATUS_DENIED | STATUS_FAILURE | STATUS_DROPPED)) {
+		bus.failed++;
+		return (status & STATUS_DENIED) ? "the arbiter refuses" : (status & STATUS_FAILURE) ?
+		       "the transfer failed (nobody at that address?)" : "the transfer was dropped";
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		bytes[i] = (uint8_t)(data[i / 4] >> (8 * (i % 4)));
+	}
+	return NULL;
+}
+
+/* ---- the keys -------------------------------------------------------------------------------------- */
+
+#define PON_ID                  0x008           /* slave 0, peripheral 0x08: registers 0x0800 */
+#define REG_TYPE                0x04
+#define REG_RT_STATUS           0x10
+#define PON_TYPE                0x01
+#define PON_KPDPWR              0x01            /* this generation's bits (pm8941-pwrkey.c) */
+#define PON_RESIN               0x02
+
+#define TLMM_PHYS               0x01000000UL
+#define TLMM_SIZE               0x300000UL
+#define PIN_VOLUME_UP           85
+#define PULL_UP                 3
+
+static vm_offset_t tlmm;
+
+#define POLL_MS                 16
+#define MINUTE_TICKS            (60 * 1000 / POLL_MS)
+
+static struct button {
+	const char *    name;
+	uint32_t        record;
+	bool            usable, live, last, down;
+	uint32_t        presses;
+} power = { .name = "power", .record = REDWOOD_BUTTON_LOCK },
+    volume_up = { .name = "volume up", .record = REDWOOD_BUTTON_VOLUME_UP },
+    volume_down = { .name = "volume down", .record = REDWOOD_BUTTON_VOLUME_DOWN };
+
+static void
+button_look(struct button *b, bool pressed)
+{
+	bool steady = pressed == b->last;
+
+	b->last = pressed;
+	if (!b->usable || !steady) {
+		return;
+	}
+	if (!b->live) {
+		if (!pressed) {
+			b->live = true;
+			printf("tissot-buttons: %s is released now: believed from here on\n", b->name);
+		}
+		return;
+	}
+	if (pressed == b->down) {
+		return;
+	}
+	b->down = pressed;
+	if (pressed) {
+		b->presses++;
+	}
+	printf("tissot-buttons: %s %s\n", b->name, pressed ? "PRESSED" : "released");
+	redwood_touch_post(pressed ? REDWOOD_BUTTON_DOWN : REDWOOD_BUTTON_UP, b->record, 0, 0);
+}
+
+static bool
+volume_up_held(void)
+{
+	return !(rd(tlmm + 0x1000UL * PIN_VOLUME_UP + 4) & 1);
+}
+
+static void
+buttons_poll(void)
+{
+	static unsigned said;
+	const char *problem;
+	uint8_t status;
+
+	if (power.usable) {
+		problem = redwood_tissot_spmi_read(PON_ID, REG_RT_STATUS, &status, 1);
+		if (problem == NULL) {
+			button_look(&power, status & PON_KPDPWR);
+			button_look(&volume_down, status & PON_RESIN);
+		} else if (said < 8) {
+			said++;
+			printf("tissot-buttons: reading the power-on block: %s\n", problem);
+		}
+	}
+	button_look(&volume_up, volume_up_held());
+}
+
+static void
+buttons_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t steps = (uint32_t)(uintptr_t)parameter;
+	const char *problem;
+	uint8_t is[2], status;
+
+	printf("tissot-buttons: step 1: the PMIC arbiter\n");
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	if (!arb_ready() || steps < 2) {
+		goto pin;
+	}
+
+	printf("tissot-buttons: step 2: the channel of the PM8953's power-on block\n");
+	if (channel_of(PON_ID) == 0) {
+		printf("tissot-buttons: no channel of the arbiter is the power-on block\n");
+		goto pin;
+	}
+	if (steps < 3) {
+		goto pin;
+	}
+
+	printf("tissot-buttons: step 3: read the type of the power-on block (0x0804, 2 registers)\n");
+	problem = redwood_tissot_spmi_read(PON_ID, REG_TYPE, is, 2);
+	if (problem != NULL) {
+		printf("tissot-buttons: %s\n", problem);
+		goto pin;
+	}
+	printf("tissot-buttons: the power-on block says type %#x, subtype %#x\n", is[0], is[1]);
+	if (is[0] != PON_TYPE) {
+		printf("tissot-buttons: ... which is not a power-on block: power and volume down left alone\n");
+		goto pin;
+	}
+	if (steps < 4) {
+		goto pin;
+	}
+	problem = redwood_tissot_spmi_read(PON_ID, REG_RT_STATUS, &status, 1);
+	if (problem != NULL) {
+		printf("tissot-buttons: %s\n", problem);
+		goto pin;
+	}
+	printf("tissot-buttons: status %#x: power %s, volume down %s\n", status, (status & PON_KPDPWR) ? "HELD" : "released",
+	    (status & PON_RESIN) ? "HELD" : "released");
+	power.usable = volume_down.usable = true;
+	power.last = status & PON_KPDPWR;
+	volume_down.last = status & PON_RESIN;
+pin:
+	if (steps >= 4) {
+		/* an input of the GPIO function, 2 mA, pulled up: gpio_key_default */
+		wr(tlmm + 0x1000UL * PIN_VOLUME_UP, PULL_UP | 0 << 2 | 0 << 6);
+		delay_for_interval(1, NSEC_PER_MSEC);
+		volume_up.usable = true;
+		volume_up.last = volume_up_held();
+		printf("tissot-buttons: volume up (gpio%u) reads %s\n", PIN_VOLUME_UP, volume_up.last ? "LOW (held)" : "high (released)");
+	}
+	power.live = power.usable && !power.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	if (steps < 5) {
+		printf("tissot-buttons: stopping here (tissot_buttons_steps=%u)\n", steps);
+		thread_terminate(current_thread());
+		return;
+	}
+
+	printf("tissot-buttons: step 5: watching%s%s%s, every %u ms\n", power.usable ? " power" : "",
+	    volume_up.usable ? " volume-up" : "", volume_down.usable ? " volume-down" : "", POLL_MS);
+	for (unsigned tick = 1;; tick++) {
+		buttons_poll();
+		if (tick % MINUTE_TICKS == 0) {
+			printf("tissot-buttons: %u presses of power, %u of volume up, %u of volume down; %llu reads of the bus, "
+			    "%llu failed\n", power.presses, volume_up.presses, volume_down.presses, bus.reads, bus.failed);
+		}
+		if (bus.failed >= 1000 && bus.failed * 2 > bus.reads) {
+			printf("tissot-buttons: more than half of the reads fail: power and volume down given up\n");
+			power.usable = volume_down.usable = false;
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+}
+
+void
+redwood_tissot_buttons_init(void)
+{
+	uint32_t enabled = 0, steps = 5;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("tissot_buttons", &enabled, sizeof(enabled))) {
+		PE_parse_boot_argn("tissot", &enabled, sizeof(enabled));
+	}
+	if (!enabled) {
+		return;
+	}
+	PE_parse_boot_argn("tissot_buttons_steps", &steps, sizeof(steps));
+	if (steps == 0) {
+		return;
+	}
+	if (kernel_thread_start(buttons_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/xnu/files/bsd/dev/redwood_tissot_emmc.c b/xnu/files/bsd/dev/redwood_tissot_emmc.c
new file mode 100644
index 0000000..6f41bb9
--- /dev/null
+++ b/xnu/files/bsd/dev/redwood_tissot_emmc.c
@@ -0,0 +1,528 @@
+/*
+ * The Mi A1's storage (tissot: 64 GB of eMMC on the Snapdragon 625's SDCC1): a block device and a
+ * character device for the whole of it and for every GPT partition -- /dev/emmc, /dev/emmc_NAME
+ * and /dev/remmc, /dev/remmc_NAME -- and the root filesystem from one of them with emmc_root=NAME.
+ * Only with boot-arg tissot_emmc=1 (or tissot=1): every address below belongs to that phone.
+ *
+ * Why a root on the storage, where the POCO's is a RAM disk: the iOS image (userland/system.apfs,
+ * 2.4 GB) is held in memory there, the POCO has 8 GB; the Mi A1 has 4, with the modem's and the
+ * firmware's regions cut out of it, and no 2.4 GB piece of it is left beside the kernel. So the
+ * image is written to a partition from the computer (fastboot flash userdata system.apfs) and
+ * read from there, block by block, as the APFS driver asks for them.
+ *
+ * Nothing is ever written to the eMMC. The root takes writes all the same -- a RAM disk root
+ * does, and user space expects to -- into memory: a written block is kept in a table of 4 KB
+ * pages, and a read of it is served from there (the same as the Raspberry Pi port's root). They
+ * last until the phone restarts.
+ *
+ * There is no storage driver below this one: the controller is driven directly, by programmed
+ * I/O, one request at a time, by the code in redwood_tissot_emmc_core.h (the boot shim's own,
+ * mia1/emmc/emmc_core.h in rpiios: the same file). The bootloader leaves the card asleep and the
+ * controller off; that code wakes both.
+ *
+ * For QEMU, which has no eMMC model: with emmc_pci=1 instead, the same driver reads an SD card
+ * on QEMU's sdhci-pci (-device sdhci-pci -device sd-card,drive=D), found through the PCI
+ * configuration space of QEMU's "virt" machine. That is how this driver is tested.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/redwood_input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static uint32_t
+emmc_rd32(uintptr_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static void
+emmc_wr32(uintptr_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+emmc_udelay(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+#define emmc_log(...) printf("tissot-emmc: " __VA_ARGS__)
+
+#include "redwood_tissot_emmc_core.h"
+
+/* the phone */
+#define SDCC1_HC_PHYS           0x07824900UL
+#define SDCC1_CORE_PHYS         0x07824000UL
+#define GCC_PHYS                0x01800000UL
+#define GCC_SIZE                0x80000UL
+
+/* QEMU virt: PCI configuration space (ECAM) above 4 GB, and memory for a BAR nobody gave out */
+#define QEMU_ECAM_PHYS          0x4010000000ULL
+#define QEMU_ECAM_LOW_PHYS      0x3f000000ULL           /* with highmem=off */
+#define QEMU_BAR_SPARE          0x10f00000u
+#define SDHCI_PCI_ID            0x00071b36u             /* Red Hat's sdhci-pci */
+
+#define MAX_PARTS               128
+#define PAGE_BYTES              4096u
+#define OVERLAY_BUCKETS         4096
+
+struct part {
+	char            name[37];
+	uint64_t        first, sectors;         /* of 512 bytes */
+	uint32_t        bsize;                  /* the block size the device is counted in (spec_open sets 512) */
+};
+
+static struct emmc emmc = { .name = "tissot-emmc" };
+static struct part parts[MAX_PARTS];            /* 0: the whole device */
+static uint32_t nparts;
+static int bmajor = -1, cmajor = -1;
+static bool ready, tried;
+static uint8_t *bounce;                         /* one request's worth, for the controller */
+#define BOUNCE_BYTES            (256u * 1024)
+
+static LCK_GRP_DECLARE(emmc_lck_grp, "tissot-emmc");
+static LCK_MTX_DECLARE(emmc_lock, &emmc_lck_grp);
+
+/* ---- what has been written: kept in memory ------------------------------------------------------- */
+
+struct overlay_page {
+	struct overlay_page *   next;
+	uint32_t                part;
+	uint64_t                page;           /* byte offset / PAGE_BYTES, in the partition */
+	uint8_t                 data[PAGE_BYTES];
+};
+
+static struct overlay_page *overlay[OVERLAY_BUCKETS];
+static uint64_t overlay_pages;
+
+static struct overlay_page *
+overlay_find(uint32_t part, uint64_t page)
+{
+	struct overlay_page *o = overlay[(page * 31 + part) % OVERLAY_BUCKETS];
+
+	while (o != NULL && (o->part != part || o->page != page)) {
+		o = o->next;
+	}
+	return o;
+}
+
+/* ---- reads and writes -------------------------------------------------------------------------- */
+
+/* Sectors of a partition from the eMMC, through the bounce buffer. The lock is held. */
+static int
+emmc_read_sectors(uint32_t part, uint64_t sector, uint64_t count, uint8_t *to)
+{
+	while (count > 0) {
+		uint32_t now = count > BOUNCE_BYTES / 512 ? BOUNCE_BYTES / 512 : (uint32_t)count;
+
+		if (emmc_io(&emmc, parts[part].first + sector, now, bounce, 0) != 0) {
+			return EIO;
+		}
+		memcpy(to, bounce, (size_t)now * 512);
+		sector += now;
+		count -= now;
+		to += (uint64_t)now * 512;
+	}
+	return 0;
+}
+
+/* `length` bytes from `offset` of a partition (both multiples of 512): the eMMC, then what was written over it. */
+static int
+part_read(uint32_t part, uint64_t offset, uint8_t *to, uint64_t length)
+{
+	int error;
+
+	lck_mtx_lock(&emmc_lock);
+	error = emmc_read_sectors(part, offset / 512, length / 512, to);
+	if (error == 0 && overlay_pages != 0) {
+		for (uint64_t page = offset / PAGE_BYTES; page * PAGE_BYTES < offset + length; page++) {
+			struct overlay_page *o = overlay_find(part, page);
+			uint64_t from, end;
+
+			if (o == NULL) {
+				continue;
+			}
+			from = page * PAGE_BYTES > offset ? page * PAGE_BYTES : offset;
+			end = (page + 1) * PAGE_BYTES < offset + length ? (page + 1) * PAGE_BYTES : offset + length;
+			memcpy(to + (from - offset), o->data + (from - page * PAGE_BYTES), end - from);
+		}
+	}
+	lck_mtx_unlock(&emmc_lock);
+	return error;
+}
+
+/* Into memory, never to the eMMC: a page first written is filled from the eMMC, then written over. */
+static int
+part_write(uint32_t part, uint64_t offset, const uint8_t *from, uint64_t length)
+{
+	int error = 0;
+
+	lck_mtx_lock(&emmc_lock);
+	for (uint64_t page = offset / PAGE_BYTES; error == 0 && page * PAGE_BYTES < offset + length; page++) {
+		struct overlay_page *o = overlay_find(part, page);
+		uint64_t start, end;
+
+		if (o == NULL) {
+			o = kalloc_type(struct overlay_page, Z_WAITOK | Z_ZERO);
+			if (o == NULL) {
+				error = ENOSPC;
+				break;
+			}
+			o->part = part;
+			o->page = page;
+			if ((page + 1) * PAGE_BYTES <= parts[part].sectors * 512) {
+				error = emmc_read_sectors(part, page * (PAGE_BYTES / 512), PAGE_BYTES / 512, o->data);
+			}
+			if (error != 0) {
+				kfree_type(struct overlay_page, o);
+				break;
+			}
+			o->next = overlay[(page * 31 + part) % OVERLAY_BUCKETS];
+			overlay[(page * 31 + part) % OVERLAY_BUCKETS] = o;
+			overlay_pages++;
+		}
+		start = page * PAGE_BYTES > offset ? page * PAGE_BYTES : offset;
+		end = (page + 1) * PAGE_BYTES < offset + length ? (page + 1) * PAGE_BYTES : offset + length;
+		memcpy(o->data + (start - page * PAGE_BYTES), from + (start - offset), end - start);
+	}
+	lck_mtx_unlock(&emmc_lock);
+	return error;
+}
+
+/* ---- the devices ------------------------------------------------------------------------------- */
+
+static int
+emmc_open(dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return ready && (uint32_t)minor(dev) < nparts ? 0 : ENXIO;
+}
+
+static int
+emmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	return 0;
+}
+
+static void
+emmc_strategy(buf_t bp)
+{
+	uint32_t part = (uint32_t)minor(buf_device(bp));
+	uint64_t offset, length, size;
+	int error;
+
+	if (!ready || part >= nparts) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+	size = parts[part].sectors * 512;
+	offset = (uint64_t)buf_blkno(bp) * parts[part].bsize;
+	length = buf_count(bp);
+	if (offset >= size || (offset | length) % 512 != 0) {
+		buf_seterror(bp, offset == size ? 0 : EINVAL);
+		buf_setresid(bp, buf_count(bp));
+		buf_biodone(bp);
+		return;
+	}
+	if (offset + length > size) {
+		length = size - offset;
+	}
+	if (buf_flags(bp) & B_READ) {
+		error = part_read(part, offset, (uint8_t *)buf_dataptr(bp), length);
+	} else {
+		error = part_write(part, offset, (const uint8_t *)buf_dataptr(bp), length);
+	}
+	buf_setresid(bp, (uint32_t)(buf_count(bp) - (error ? 0 : length)));
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+emmc_ioctl(dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	uint32_t part = (uint32_t)minor(dev);
+
+	if (!ready || part >= nparts) {
+		return ENXIO;
+	}
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = parts[part].bsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (*(uint32_t *)data < 512 || *(uint32_t *)data > PAGE_BYTES || (*(uint32_t *)data & (*(uint32_t *)data - 1)) != 0) {
+			return EINVAL;
+		}
+		parts[part].bsize = *(uint32_t *)data;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*(uint32_t *)data = 512;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = parts[part].sectors * 512 / parts[part].bsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = 1;          /* into memory */
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*(uint64_t *)data = BOUNCE_BYTES / parts[part].bsize;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+emmc_psize(dev_t dev)
+{
+	uint32_t part = (uint32_t)minor(dev);
+
+	return ready && part < nparts ? (int)parts[part].bsize : -1;
+}
+
+/* /dev/remmc_NAME: through memory of this kernel's (uiomove), never the reader's own. */
+static int
+emmc_rw(dev_t dev, struct uio *uio, int write)
+{
+	uint32_t part = (uint32_t)minor(dev);
+	uint64_t size;
+	uint8_t *buffer;
+	int error = 0;
+
+	if (!ready || part >= nparts) {
+		return ENXIO;
+	}
+	size = parts[part].sectors * 512;
+	if (uio_offset(uio) < 0 || uio_offset(uio) % 512 != 0 || uio_resid(uio) % 512 != 0) {
+		return EINVAL;
+	}
+	buffer = kalloc_data(BOUNCE_BYTES, Z_WAITOK);
+	if (buffer == NULL) {
+		return ENOMEM;
+	}
+	while (error == 0 && uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < size) {
+		uint64_t at = (uint64_t)uio_offset(uio), want = (uint64_t)uio_resid(uio);
+
+		want = want > BOUNCE_BYTES ? BOUNCE_BYTES : want;
+		want = want > size - at ? size - at : want;
+		if (write) {
+			error = uiomove((caddr_t)buffer, (int)want, uio);
+			if (error == 0) {
+				error = part_write(part, at, buffer, want);
+			}
+		} else {
+			error = part_read(part, at, buffer, want);
+			if (error == 0) {
+				error = uiomove((caddr_t)buffer, (int)want, uio);
+			}
+		}
+	}
+	kfree_data(buffer, BOUNCE_BYTES);
+	return error;
+}
+
+static int
+emmc_cread(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return emmc_rw(dev, uio, 0);
+}
+
+static int
+emmc_cwrite(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return emmc_rw(dev, uio, 1);
+}
+
+static const struct bdevsw emmc_bdevsw = {
+	.d_open = emmc_open, .d_close = emmc_close, .d_strategy = emmc_strategy, .d_ioctl = emmc_ioctl,
+	.d_dump = eno_dump, .d_psize = emmc_psize, .d_type = D_DISK,
+};
+
+static const struct cdevsw emmc_cdevsw = {
+	.d_open = emmc_open, .d_close = emmc_close, .d_read = emmc_cread, .d_write = emmc_cwrite,
+	.d_ioctl = emmc_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = D_DISK,
+};
+
+/* ---- bring-up ---------------------------------------------------------------------------------- */
+
+static int
+add_part(__unused void *context, const struct emmc_part *p)
+{
+	if (nparts >= MAX_PARTS) {
+		return 1;
+	}
+	strlcpy(parts[nparts].name, p->name, sizeof(parts[nparts].name));
+	parts[nparts].first = p->first;
+	parts[nparts].sectors = p->sectors;
+	parts[nparts].bsize = 512;
+	nparts++;
+	return 0;
+}
+
+/* QEMU: the first sdhci-pci on bus 0, its BAR given an address if the firmware gave it none. */
+static uintptr_t
+qemu_sdhci(void)
+{
+	uint64_t ecams[2] = { QEMU_ECAM_PHYS, QEMU_ECAM_LOW_PHYS };
+
+	for (int e = 0; e < 2; e++) {
+		vm_offset_t ecam = ml_io_map((vm_offset_t)ecams[e], 32 * 0x8000);
+
+		for (uint32_t device = 0; device < 32; device++) {
+			vm_offset_t config = ecam + device * 0x8000;
+			uint32_t bar;
+
+			if (emmc_rd32(config) != SDHCI_PCI_ID) {
+				continue;
+			}
+			bar = emmc_rd32(config + 0x10) & ~0xfu;
+			if (bar == 0) {
+				emmc_wr32(config + 0x10, QEMU_BAR_SPARE);
+				bar = QEMU_BAR_SPARE;
+			}
+			emmc_wr32(config + 0x04, emmc_rd32(config + 0x04) | 2);    /* memory space on */
+			printf("tissot-emmc: sdhci-pci at 00:%02x.0 (ECAM %#llx), registers at %#x\n", device, ecams[e], bar);
+			return ml_io_map(bar, 0x1000);
+		}
+	}
+	printf("tissot-emmc: emmc_pci=1 but no sdhci-pci on bus 0\n");
+	return 0;
+}
+
+static void
+make_nodes(void)
+{
+	for (uint32_t n = 0; n < nparts; n++) {
+		char name[48];
+
+		snprintf(name, sizeof(name), n == 0 ? "emmc" : "emmc_%s", parts[n].name);
+		devfs_make_node(makedev(bmajor, n), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "%s", name);
+		devfs_make_node(makedev(cmajor, n), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "r%s", name);
+	}
+}
+
+void
+redwood_tissot_emmc_init(void)
+{
+	uint32_t phone = 0, pci = 0;
+	static uint8_t sector[512];
+
+	if (tried) {
+		return;
+	}
+	tried = true;
+	if (!PE_parse_boot_argn("tissot_emmc", &phone, sizeof(phone))) {
+		PE_parse_boot_argn("tissot", &phone, sizeof(phone));
+	}
+	PE_parse_boot_argn("emmc_pci", &pci, sizeof(pci));
+	if (!phone && !pci) {
+		return;
+	}
+	if (pci) {
+		emmc.hc = qemu_sdhci();
+	} else {
+		emmc.core = ml_io_map(SDCC1_CORE_PHYS, 0x1000);        /* "hc" is in the same page */
+		emmc.gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+		emmc.hc = emmc.core + (SDCC1_HC_PHYS - SDCC1_CORE_PHYS);
+	}
+	if (emmc.hc == 0) {
+		return;
+	}
+	bounce = kalloc_data(BOUNCE_BYTES, Z_WAITOK);
+	lck_mtx_lock(&emmc_lock);
+	if (bounce == NULL || emmc_init(&emmc) != 0) {
+		lck_mtx_unlock(&emmc_lock);
+		printf("tissot-emmc: no storage\n");
+		return;
+	}
+	strlcpy(parts[0].name, "(whole)", sizeof(parts[0].name));
+	parts[0].first = 0;
+	parts[0].sectors = emmc.sectors;
+	parts[0].bsize = 512;
+	nparts = 1;
+	emmc_gpt_walk(&emmc, sector, add_part, NULL);
+	lck_mtx_unlock(&emmc_lock);
+
+	bmajor = bdevsw_add(-1, &emmc_bdevsw);
+	cmajor = cdevsw_add(-1, &emmc_cdevsw);
+	if (bmajor < 0 || cmajor < 0) {
+		printf("tissot-emmc: no device numbers left\n");
+		return;
+	}
+	ready = true;
+	make_nodes();
+	printf("tissot-emmc: %u partitions:", nparts - 1);
+	for (uint32_t n = 1; n < nparts; n++) {
+		printf(" %s (%llu MB)", parts[n].name, parts[n].sectors / 2048);
+	}
+	printf("\n");
+}
+
+/*
+ * The root, for IOFindBSDRoot: emmc_root=NAME (here "emmc_NAME"). NODEV if there is no such partition. The partition
+ * is to hold an APFS container (fastboot flash NAME userland/system.apfs): said if it does not.
+ */
+dev_t
+redwood_tissot_emmc_root(const char *name)
+{
+	static uint8_t block[512];
+
+	redwood_tissot_emmc_init();
+	if (!ready) {
+		return NODEV;
+	}
+	for (uint32_t n = 0; n < nparts; n++) {
+		char full[48];
+
+		snprintf(full, sizeof(full), n == 0 ? "emmc" : "emmc_%s", parts[n].name);
+		if (strcmp(full, name) != 0) {
+			continue;
+		}
+		if (part_read(n, 0, block, 512) == 0) {
+			printf("tissot-emmc: root %s: %s\n", name,
+			    memcmp(block + 32, "NXSB", 4) == 0 ? "an APFS container" : "NOT an APFS container (was the image written to it?)");
+		}
+		return makedev(bmajor, n);
+	}
+	printf("tissot-emmc: no partition %s for the root\n", name);
+	return NODEV;
+}
+
+/* one of this driver's devices (the APFS driver puts requests to it together: each costs a transfer) */
+bool
+redwood_tissot_emmc_dev(dev_t dev)
+{
+	return ready && (major(dev) == bmajor || major(dev) == cmajor);
+}
+
+/* A line for the log: what has been read, and how much is held in memory for writes. */
+void
+redwood_tissot_emmc_report(void)
+{
+	if (ready) {
+		printf("tissot-emmc: %llu reads (%llu MB), %llu errors; %llu pages written into memory (%llu MB)\n", emmc.reads,
+		    emmc.read_sectors / 2048, emmc.errors, overlay_pages, overlay_pages * PAGE_BYTES >> 20);
+	}
+}
diff --git a/xnu/files/bsd/dev/redwood_tissot_emmc_core.h b/xnu/files/bsd/dev/redwood_tissot_emmc_core.h
new file mode 100644
index 0000000..6f54a7e
--- /dev/null
+++ b/xnu/files/bsd/dev/redwood_tissot_emmc_core.h
@@ -0,0 +1,670 @@
+/*
+ * eMMC (and SD) over an SDHCI controller, by programmed I/O: what the Mi A1's boot shim and its
+ * kernel driver (bsd/dev/redwood_tissot_emmc.c, which carries a copy of this file) both use to
+ * read the phone's storage. No interrupts, no DMA, one request at a time.
+ *
+ * The Mi A1's eMMC is on the Snapdragon 625's SDCC1: a standard SDHCI register block ("hc",
+ * 0x07824900) beside Qualcomm's own ("core", 0x07824000). The bootloader (LK's aboot) puts the
+ * card to sleep and switches the controller out of SDHCI mode before it starts us
+ * (target_uninit: mmc_put_card_to_sleep, sdhci_mode_disable), so everything is done again here,
+ * in the order LK's platform/msm_shared/sdhci_msm.c and mmc_sdhci.c do it:
+ *   - the SDCC1 clocks on and the core clock at 50 MHz (GCC: GPLL0 / 16)
+ *   - SDHCI mode on, a reset, Qualcomm's power-control handshake acknowledged
+ *   - the card from sleep to idle (CMD0), then identified and selected at 400 kHz
+ *   - 8 data lines, high speed timing, 50 MHz (a card that refuses stays at 1 line, 25 MHz)
+ * The same code reads an SD card in a plain SDHCI (msm = 0: QEMU's sdhci-pci, which has no
+ * eMMC model, and the Mi A1's microSD slot on SDCC2).
+ *
+ * The includer defines, before including this file:
+ *   uint32_t emmc_rd32(uintptr_t address), void emmc_wr32(uintptr_t address, uint32_t value)
+ *   void emmc_udelay(uint32_t microseconds)
+ *   void emmc_log(const char *format, ...)       (printf-like: %s %u %x %llx are used)
+ *
+ * Register layouts: the SD Host Controller Simplified Specification 3.00; JEDEC eMMC 5.0
+ * (JESD84-B50); LK (lk2nd) platform/msm_shared/{sdhci,sdhci_msm,mmc_sdhci}.c,
+ * platform/msm8953/{msm8953-clock.c,include/platform/iomap.h}; Linux drivers/mmc/host/sdhci-msm.c.
+ */
+#ifndef EMMC_CORE_H
+#define EMMC_CORE_H
+
+/* ---- SDHCI ------------------------------------------------------------------------------------- */
+
+#define SDHCI_ARGUMENT2         0x00
+#define SDHCI_BLOCK             0x04            /* [11:0] size, [31:16] count */
+#define SDHCI_ARGUMENT          0x08
+#define SDHCI_COMMAND           0x0c            /* [15:0] transfer mode, [31:16] command: one write */
+#define SDHCI_RESPONSE          0x10            /* 4 words */
+#define SDHCI_DATA              0x20
+#define SDHCI_PRESENT           0x24
+#define SDHCI_HOST_CONTROL      0x28            /* [7:0] host control 1, [15:8] power */
+#define SDHCI_CLOCK             0x2c            /* [15:0] clock, [19:16] timeout, [26:24] reset */
+#define SDHCI_INT_STATUS        0x30            /* [15:0] normal, [31:16] errors */
+#define SDHCI_INT_ENABLE        0x34
+#define SDHCI_SIGNAL_ENABLE     0x38
+#define SDHCI_CONTROL2          0x3c            /* [31:16] host control 2 */
+#define SDHCI_CAPS              0x40
+#define SDHCI_VERSION           0xfc            /* [23:16] specification version */
+
+#define PRESENT_CMD_INHIBIT     (1u << 0)
+#define PRESENT_DAT_INHIBIT     (1u << 1)
+#define PRESENT_CARD            (1u << 16)
+
+#define HOST_4BIT               (1u << 1)
+#define HOST_HIGH_SPEED         (1u << 2)
+#define HOST_8BIT               (1u << 5)
+#define POWER_ON                (1u << 8)
+#define POWER_180               (5u << 9)
+#define POWER_330               (7u << 9)
+
+#define CLOCK_INTERNAL          (1u << 0)
+#define CLOCK_STABLE            (1u << 1)
+#define CLOCK_CARD              (1u << 2)
+#define TIMEOUT_MAX             (0xeu << 16)
+#define RESET_ALL               (1u << 24)
+#define RESET_CMD               (1u << 25)
+#define RESET_DATA              (1u << 26)
+
+#define INT_COMMAND_DONE        (1u << 0)
+#define INT_TRANSFER_DONE       (1u << 1)
+#define INT_READ_READY          (1u << 5)
+#define INT_WRITE_READY         (1u << 4)
+#define INT_ERROR               (1u << 15)
+#define INT_ERRORS              0xffff0000u
+
+#define MODE_BLOCK_COUNT        (1u << 1)
+#define MODE_AUTO_CMD12         (1u << 2)
+#define MODE_READ               (1u << 4)
+#define MODE_MULTI              (1u << 5)
+
+#define RESP_NONE               0
+#define RESP_136                1
+#define RESP_48                 2
+#define RESP_48_BUSY            3
+#define CMD_CRC                 (1u << 3)
+#define CMD_INDEX               (1u << 4)
+#define CMD_DATA                (1u << 5)
+#define R1                      (RESP_48 | CMD_CRC | CMD_INDEX)
+#define R1B                     (RESP_48_BUSY | CMD_CRC | CMD_INDEX)
+#define R2                      (RESP_136 | CMD_CRC)
+#define R3                      RESP_48
+
+/* ---- Qualcomm's side of SDCC (the "core" registers) and its clocks ------------------------------ */
+
+#define MSM_HC_MODE             0x78            /* [0] SDHCI mode, [13] FF_CLK_SW_RST_DIS */
+#define MSM_PWRCTL_STATUS       0xdc            /* [0] bus on, [1] bus off, [2] I/O low, [3] I/O high */
+#define MSM_PWRCTL_MASK         0xe0
+#define MSM_PWRCTL_CLEAR        0xe4
+#define MSM_PWRCTL_CTL          0xe8            /* [0] bus on/off done, [2] I/O switch done */
+#define MSM_VERSION             0x50
+#define MSM_VENDOR_SPEC         0x10c           /* of "hc" */
+#define MSM_VENDOR_CAPS0        0x11c           /* of "hc": capabilities as the controller says them */
+
+#define GCC_SDCC1_CMD_RCGR      0x42004         /* of the global clock controller, 0x01800000 */
+#define GCC_SDCC1_CFG_RCGR      0x42008
+#define GCC_SDCC1_APPS_CBCR     0x42018
+#define GCC_SDCC1_AHB_CBCR      0x4201c
+#define RCGR_UPDATE             (1u << 0)
+#define CBCR_ENABLE             (1u << 0)
+#define CBCR_OFF                (1u << 31)
+#define GPLL0_SOURCE            1
+#define SDCC_CLOCK_HZ           50000000u       /* GPLL0 (800 MHz) / 16 */
+
+/* ---- the card ---------------------------------------------------------------------------------- */
+
+#define EXT_CSD_PARTITION_CONFIG 179            /* [2:0] which area is accessed: 0 the user area */
+#define EXT_CSD_BUS_WIDTH       183
+#define EXT_CSD_HS_TIMING       185
+#define EXT_CSD_REV             192
+#define EXT_CSD_SECTORS         212             /* 4 bytes, little endian */
+
+struct emmc {
+	/* filled in by the includer */
+	uintptr_t       hc;             /* the SDHCI registers */
+	uintptr_t       core;           /* Qualcomm's, 0 for a plain SDHCI */
+	uintptr_t       gcc;            /* the global clock controller, 0 to leave the clock as it is */
+	const char *    name;
+	/* what the card is */
+	int             sd;             /* an SD card, not eMMC */
+	int             sectors_addressed; /* high capacity: the argument is a sector, not a byte */
+	uint32_t        rca;
+	uint64_t        sectors;        /* of 512 bytes, in the user area */
+	uint32_t        width;          /* data lines */
+	uint32_t        hz;
+	uint32_t        cid[4];
+	/* how it has gone */
+	uint64_t        reads, read_sectors, writes, written_sectors, errors;
+	uint32_t        last_error;     /* SDHCI's error bits of the last failure */
+	uint32_t        base_hz;
+};
+
+static inline uint32_t
+hc_rd(struct emmc *e, uint32_t reg)
+{
+	return emmc_rd32(e->hc + reg);
+}
+
+static inline void
+hc_wr(struct emmc *e, uint32_t reg, uint32_t value)
+{
+	emmc_wr32(e->hc + reg, value);
+}
+
+static int
+emmc_wait(struct emmc *e, uint32_t reg, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t waited = 0; (hc_rd(e, reg) & mask) != want; waited++) {
+		if (waited >= us) {
+			return -1;
+		}
+		emmc_udelay(1);
+	}
+	return 0;
+}
+
+/*
+ * Qualcomm's controller asks software, through its "power irq", whether a change of bus power or
+ * of I/O voltage has been made, and holds the change until it is told so. Nothing takes that
+ * interrupt here, so the request is looked for and acknowledged after every such change.
+ */
+static void
+msm_power_ack(struct emmc *e, uint32_t us)
+{
+	uint32_t status = 0;
+
+	if (e->core == 0) {
+		return;
+	}
+	for (uint32_t waited = 0; waited < us; waited += 10) {
+		status = emmc_rd32(e->core + MSM_PWRCTL_STATUS);
+		if (status != 0) {
+			break;
+		}
+		emmc_udelay(10);
+	}
+	if (status == 0) {
+		return;
+	}
+	emmc_wr32(e->core + MSM_PWRCTL_CLEAR, status);
+	emmc_wr32(e->core + MSM_PWRCTL_CTL, ((status & 3) ? 1u : 0) | ((status & 0xc) ? 4u : 0));
+}
+
+static int
+emmc_reset(struct emmc *e, uint32_t which)
+{
+	hc_wr(e, SDHCI_CLOCK, hc_rd(e, SDHCI_CLOCK) | which);
+	if (emmc_wait(e, SDHCI_CLOCK, which, 0, 100000) != 0) {
+		emmc_log("%s: the controller does not come out of reset (%x)\n", e->name, hc_rd(e, SDHCI_CLOCK));
+		return -1;
+	}
+	return 0;
+}
+
+static int
+emmc_set_clock(struct emmc *e, uint32_t hz)
+{
+	uint32_t divider = 0, clock;
+
+	if (hz < e->base_hz) {
+		for (divider = 1; divider < 0x3ff && e->base_hz / (2 * divider) > hz; divider++) {
+		}
+	}
+	hc_wr(e, SDHCI_CLOCK, hc_rd(e, SDHCI_CLOCK) & ~0xffffu);
+	clock = (divider & 0xff) << 8 | ((divider >> 8) & 3) << 6 | CLOCK_INTERNAL;
+	hc_wr(e, SDHCI_CLOCK, (hc_rd(e, SDHCI_CLOCK) & ~0xfffffu) | clock | TIMEOUT_MAX);
+	if (emmc_wait(e, SDHCI_CLOCK, CLOCK_STABLE, CLOCK_STABLE, 100000) != 0) {
+		emmc_log("%s: the clock does not settle\n", e->name);
+		return -1;
+	}
+	hc_wr(e, SDHCI_CLOCK, hc_rd(e, SDHCI_CLOCK) | CLOCK_CARD);
+	e->hz = divider ? e->base_hz / (2 * divider) : e->base_hz;
+	emmc_udelay(1000);
+	return 0;
+}
+
+/* One command. `response` gets 1 word (48-bit responses) or 4 (136-bit). Returns 0 or -1. */
+static int
+emmc_command(struct emmc *e, uint32_t index, uint32_t argument, uint32_t flags, uint32_t mode, uint32_t *response)
+{
+	uint32_t status, inhibit = PRESENT_CMD_INHIBIT;
+
+	if ((flags & 3) == RESP_48_BUSY || (flags & CMD_DATA)) {
+		inhibit |= PRESENT_DAT_INHIBIT;
+	}
+	if (emmc_wait(e, SDHCI_PRESENT, inhibit, 0, 100000) != 0) {
+		emmc_log("%s: CMD%u: the controller stays busy (%x)\n", e->name, index, hc_rd(e, SDHCI_PRESENT));
+		emmc_reset(e, RESET_CMD | RESET_DATA);
+		return -1;
+	}
+	hc_wr(e, SDHCI_INT_STATUS, 0xffffffffu);
+	hc_wr(e, SDHCI_ARGUMENT, argument);
+	hc_wr(e, SDHCI_COMMAND, (index << 8 | flags) << 16 | mode);
+	for (uint32_t waited = 0;; waited++) {
+		status = hc_rd(e, SDHCI_INT_STATUS);
+		if (status & (INT_COMMAND_DONE | INT_ERROR)) {
+			break;
+		}
+		if (waited >= 1000000) {
+			emmc_log("%s: CMD%u: no answer\n", e->name, index);
+			emmc_reset(e, RESET_CMD | RESET_DATA);
+			return -1;
+		}
+		emmc_udelay(1);
+	}
+	if (status & INT_ERROR) {
+		e->last_error = status & INT_ERRORS;
+		hc_wr(e, SDHCI_INT_STATUS, status);
+		emmc_reset(e, RESET_CMD | RESET_DATA);
+		return -1;
+	}
+	hc_wr(e, SDHCI_INT_STATUS, INT_COMMAND_DONE);
+	if (response != NULL) {
+		response[0] = hc_rd(e, SDHCI_RESPONSE);
+		if ((flags & 3) == RESP_136) {
+			response[1] = hc_rd(e, SDHCI_RESPONSE + 4);
+			response[2] = hc_rd(e, SDHCI_RESPONSE + 8);
+			response[3] = hc_rd(e, SDHCI_RESPONSE + 12);
+		}
+	}
+	if ((flags & 3) == RESP_48_BUSY) {
+		if (emmc_wait(e, SDHCI_INT_STATUS, INT_TRANSFER_DONE | INT_ERROR, INT_TRANSFER_DONE, 1000000) != 0 &&
+		    emmc_wait(e, SDHCI_PRESENT, PRESENT_DAT_INHIBIT, 0, 1000000) != 0) {
+			emmc_log("%s: CMD%u: the card stays busy\n", e->name, index);
+			return -1;
+		}
+		hc_wr(e, SDHCI_INT_STATUS, INT_TRANSFER_DONE);
+	}
+	return 0;
+}
+
+/*
+ * Data: `count` blocks of 512 bytes. Reads fill `buffer`, writes take from it. The words go through
+ * the data port as they come; a 32-bit buffer is not required (bytes are assembled).
+ */
+static int
+emmc_data(struct emmc *e, uint32_t index, uint32_t argument, uint32_t count, uint8_t *buffer, int write)
+{
+	uint32_t mode = (write ? 0 : MODE_READ) | MODE_BLOCK_COUNT, status;
+
+	if (count > 1) {
+		mode |= MODE_MULTI | MODE_AUTO_CMD12;
+	}
+	hc_wr(e, SDHCI_BLOCK, count << 16 | 512);
+	if (emmc_command(e, index, argument, R1 | CMD_DATA, mode, NULL) != 0) {
+		e->errors++;
+		return -1;
+	}
+	for (uint32_t block = 0; block < count; block++) {
+		uint32_t ready = write ? INT_WRITE_READY : INT_READ_READY;
+
+		for (uint32_t waited = 0;; waited++) {
+			status = hc_rd(e, SDHCI_INT_STATUS);
+			if (status & (ready | INT_ERROR)) {
+				break;
+			}
+			if (waited >= 2000000) {
+				emmc_log("%s: CMD%u: block %u of %u never came\n", e->name, index, block, count);
+				goto failed;
+			}
+			emmc_udelay(1);
+		}
+		if (status & INT_ERROR) {
+			e->last_error = status & INT_ERRORS;
+			emmc_log("%s: CMD%u: error %x at block %u of %u\n", e->name, index, e->last_error >> 16, block, count);
+			goto failed;
+		}
+		hc_wr(e, SDHCI_INT_STATUS, ready);
+		for (uint32_t i = 0; i < 512; i += 4) {
+			uint8_t *p = buffer + 512 * block + i;
+
+			if (write) {
+				hc_wr(e, SDHCI_DATA, (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24);
+			} else {
+				uint32_t word = hc_rd(e, SDHCI_DATA);
+
+				p[0] = (uint8_t)word;
+				p[1] = (uint8_t)(word >> 8);
+				p[2] = (uint8_t)(word >> 16);
+				p[3] = (uint8_t)(word >> 24);
+			}
+		}
+	}
+	if (emmc_wait(e, SDHCI_INT_STATUS, INT_TRANSFER_DONE, INT_TRANSFER_DONE, 2000000) != 0) {
+		emmc_log("%s: CMD%u: the transfer does not end\n", e->name, index);
+		goto failed;
+	}
+	hc_wr(e, SDHCI_INT_STATUS, INT_TRANSFER_DONE);
+	return 0;
+failed:
+	e->errors++;
+	hc_wr(e, SDHCI_INT_STATUS, 0xffffffffu);
+	emmc_reset(e, RESET_CMD | RESET_DATA);
+	if (count > 1) {
+		emmc_command(e, 12, 0, R1B, 0, NULL);  /* stop the card's transfer, if it is still in one */
+	}
+	return -1;
+}
+
+/* The SDCC1 clocks on, and the core clock at SDCC_CLOCK_HZ. */
+static void
+msm_clocks(struct emmc *e)
+{
+	if (e->gcc == 0) {
+		return;
+	}
+	emmc_wr32(e->gcc + GCC_SDCC1_AHB_CBCR, emmc_rd32(e->gcc + GCC_SDCC1_AHB_CBCR) | CBCR_ENABLE);
+	/* GPLL0 / 16: the divider field is 2 * 16 - 1, no M/N */
+	emmc_wr32(e->gcc + GCC_SDCC1_CFG_RCGR, (2 * 16 - 1) | GPLL0_SOURCE << 8);
+	emmc_wr32(e->gcc + GCC_SDCC1_CMD_RCGR, emmc_rd32(e->gcc + GCC_SDCC1_CMD_RCGR) | RCGR_UPDATE);
+	for (int i = 0; i < 1000 && (emmc_rd32(e->gcc + GCC_SDCC1_CMD_RCGR) & RCGR_UPDATE); i++) {
+		emmc_udelay(1);
+	}
+	emmc_wr32(e->gcc + GCC_SDCC1_APPS_CBCR, emmc_rd32(e->gcc + GCC_SDCC1_APPS_CBCR) | CBCR_ENABLE);
+	for (int i = 0; i < 1000 && (emmc_rd32(e->gcc + GCC_SDCC1_APPS_CBCR) & CBCR_OFF); i++) {
+		emmc_udelay(1);
+	}
+	emmc_log("%s: clocks: ahb %x, apps %x, rcg %x\n", e->name, emmc_rd32(e->gcc + GCC_SDCC1_AHB_CBCR),
+	    emmc_rd32(e->gcc + GCC_SDCC1_APPS_CBCR), emmc_rd32(e->gcc + GCC_SDCC1_CFG_RCGR));
+}
+
+static int
+emmc_sd_identify(struct emmc *e, uint32_t *r)
+{
+	uint32_t ocr = 0;
+
+	e->sd = 1;
+	if (emmc_command(e, 8, 0x1aa, R1, 0, r) != 0 || (r[0] & 0xfff) != 0x1aa) {
+		emmc_log("%s: neither an eMMC nor a version 2 SD card answers\n", e->name);
+		return -1;
+	}
+	for (int tries = 0; tries < 1000; tries++) {
+		if (emmc_command(e, 55, 0, R1, 0, r) != 0 || emmc_command(e, 41, 0x40ff8000, R3, 0, r) != 0) {
+			return -1;
+		}
+		ocr = r[0];
+		if (ocr & 0x80000000u) {
+			break;
+		}
+		emmc_udelay(1000);
+	}
+	if (!(ocr & 0x80000000u)) {
+		emmc_log("%s: the SD card stays busy (OCR %x)\n", e->name, ocr);
+		return -1;
+	}
+	e->sectors_addressed = (ocr >> 30) & 1;
+	return 0;
+}
+
+/*
+ * Bring the controller and the card up, to the transfer state with the user area selected.
+ * Returns 0 or -1; what happened is in the log.
+ */
+static int
+emmc_init(struct emmc *e)
+{
+	uint32_t r[4], ocr = 0, caps;
+	static uint8_t ext_csd[512];
+
+	e->sd = 0;
+	e->errors = 0;
+	if (e->core != 0) {
+		msm_clocks(e);
+		hc_wr(e, MSM_VENDOR_SPEC, 0xa1c);                       /* as LK writes it first */
+		emmc_wr32(e->core + MSM_HC_MODE, emmc_rd32(e->core + MSM_HC_MODE) | 1u | 1u << 13);
+		emmc_log("%s: Qualcomm SDCC %x, SDHCI mode on\n", e->name, emmc_rd32(e->core + MSM_VERSION));
+	}
+	if (emmc_reset(e, RESET_ALL) != 0) {
+		return -1;
+	}
+	if (e->core != 0) {
+		/* a reset raises a request if the bus was on: acknowledged, then all four asked for */
+		msm_power_ack(e, 1000);
+		emmc_wr32(e->core + MSM_PWRCTL_MASK, 0xf);
+		/* the voltages are not in the SDHCI capabilities of this core: as LK says them (1.8 V) */
+		hc_wr(e, MSM_VENDOR_CAPS0, hc_rd(e, SDHCI_CAPS) | 1u << 26);
+	}
+	caps = hc_rd(e, SDHCI_CAPS);
+	e->base_hz = ((caps >> 8) & 0xff) * 1000000u;
+	if (e->core != 0 || e->base_hz == 0) {
+		e->base_hz = e->core != 0 ? SDCC_CLOCK_HZ : 50000000u;
+	}
+	emmc_log("%s: SDHCI version %u, capabilities %x, base clock %u Hz, present %x\n", e->name,
+	    ((hc_rd(e, SDHCI_VERSION) >> 16) & 0xff) + 1, caps, e->base_hz, hc_rd(e, SDHCI_PRESENT));
+
+	hc_wr(e, SDHCI_INT_ENABLE, 0xffffffffu & ~(1u << 8));         /* every status but the card interrupt; none signalled */
+	hc_wr(e, SDHCI_SIGNAL_ENABLE, 0);
+	/* bus power: 1.8 V for the Mi A1's eMMC (it signals at 1.8 V), 3.3 V for an SD card */
+	hc_wr(e, SDHCI_HOST_CONTROL, (hc_rd(e, SDHCI_HOST_CONTROL) & ~0xff00u) | (e->core ? POWER_180 : POWER_330));
+	hc_wr(e, SDHCI_HOST_CONTROL, hc_rd(e, SDHCI_HOST_CONTROL) | POWER_ON);
+	msm_power_ack(e, 10000);
+	emmc_udelay(10000);
+	if (emmc_set_clock(e, 400000) != 0) {
+		return -1;
+	}
+
+	emmc_command(e, 0, 0, RESP_NONE, 0, NULL);                      /* from sleep (or anything) to idle */
+	emmc_udelay(2000);
+	/* eMMC: CMD1 until it is ready; sector addressing, 1.7-1.95 V and 2.7-3.6 V */
+	for (int tries = 0; tries < 1000; tries++) {
+		if (emmc_command(e, 1, 0x40ff8080, R3, 0, r) != 0) {
+			break;
+		}
+		ocr = r[0];
+		if (ocr & 0x80000000u) {
+			break;
+		}
+		emmc_udelay(1000);
+	}
+	if (ocr & 0x80000000u) {
+		e->sectors_addressed = (ocr >> 30) & 1;
+	} else {
+		emmc_command(e, 0, 0, RESP_NONE, 0, NULL);
+		emmc_udelay(2000);
+		if (emmc_sd_identify(e, r) != 0) {
+			return -1;
+		}
+	}
+	if (emmc_command(e, 2, 0, R2, 0, e->cid) != 0) {
+		emmc_log("%s: CMD2 (CID) failed\n", e->name);
+		return -1;
+	}
+	if (e->sd) {
+		if (emmc_command(e, 3, 0, R1, 0, r) != 0) {
+			return -1;
+		}
+		e->rca = r[0] >> 16;
+	} else {
+		e->rca = 1;
+		if (emmc_command(e, 3, e->rca << 16, R1, 0, r) != 0) {
+			return -1;
+		}
+	}
+	if (emmc_command(e, 9, e->rca << 16, R2, 0, r) != 0) {
+		emmc_log("%s: CMD9 (CSD) failed\n", e->name);
+		return -1;
+	}
+	if (e->sd) {
+		/* CSD version 2: C_SIZE is bits 69:48 of the CSD, 61:40 of what SDHCI keeps (no CRC) */
+		uint64_t c_size = ((uint64_t)r[1] >> 8 | (uint64_t)r[2] << 24) & 0x3fffff;
+
+		e->sectors = (c_size + 1) * 1024;
+	}
+	if (emmc_command(e, 7, e->rca << 16, R1B, 0, r) != 0) {
+		emmc_log("%s: CMD7 (select) failed\n", e->name);
+		return -1;
+	}
+	if (emmc_set_clock(e, 25000000) != 0) {
+		return -1;
+	}
+	e->width = 1;
+	if (e->sd) {
+		if (emmc_command(e, 55, e->rca << 16, R1, 0, r) == 0 && emmc_command(e, 6, 2, R1, 0, r) == 0) {
+			hc_wr(e, SDHCI_HOST_CONTROL, hc_rd(e, SDHCI_HOST_CONTROL) | HOST_4BIT);
+			e->width = 4;
+		}
+	} else {
+		if (emmc_data(e, 8, 0, 1, ext_csd, 0) != 0) {
+			emmc_log("%s: CMD8 (EXT_CSD) failed\n", e->name);
+			return -1;
+		}
+		e->sectors = (uint32_t)ext_csd[EXT_CSD_SECTORS] | (uint32_t)ext_csd[EXT_CSD_SECTORS + 1] << 8 |
+		    (uint32_t)ext_csd[EXT_CSD_SECTORS + 2] << 16 | (uint32_t)ext_csd[EXT_CSD_SECTORS + 3] << 24;
+		emmc_log("%s: EXT_CSD revision %u, partition config %x, bus width %u, timing %u\n", e->name,
+		    ext_csd[EXT_CSD_REV], ext_csd[EXT_CSD_PARTITION_CONFIG], ext_csd[EXT_CSD_BUS_WIDTH], ext_csd[EXT_CSD_HS_TIMING]);
+		/* the user area, whatever the bootloader left selected (it reads the boot areas too) */
+		if (ext_csd[EXT_CSD_PARTITION_CONFIG] & 7) {
+			emmc_command(e, 6, 3u << 24 | EXT_CSD_PARTITION_CONFIG << 16 |
+			    (uint32_t)(ext_csd[EXT_CSD_PARTITION_CONFIG] & ~7u) << 8, R1B, 0, r);
+		}
+		/* 8 lines, then high speed timing at 50 MHz */
+		if (emmc_command(e, 6, 3u << 24 | EXT_CSD_BUS_WIDTH << 16 | 2u << 8, R1B, 0, r) == 0) {
+			hc_wr(e, SDHCI_HOST_CONTROL, (hc_rd(e, SDHCI_HOST_CONTROL) & ~HOST_4BIT) | HOST_8BIT);
+			e->width = 8;
+		}
+		if (emmc_command(e, 6, 3u << 24 | EXT_CSD_HS_TIMING << 16 | 1u << 8, R1B, 0, r) == 0) {
+			hc_wr(e, SDHCI_HOST_CONTROL, hc_rd(e, SDHCI_HOST_CONTROL) | HOST_HIGH_SPEED);
+			emmc_set_clock(e, 50000000);
+		}
+	}
+	if (!e->sectors_addressed && e->sd == 0 && e->sectors == 0) {
+		emmc_log("%s: a card of the old byte-addressed kind: not supported\n", e->name);
+		return -1;
+	}
+	emmc_command(e, 16, 512, R1, 0, r);                            /* ignored by high capacity cards */
+	if (emmc_command(e, 13, e->rca << 16, R1, 0, r) != 0) {
+		emmc_log("%s: CMD13 (status) failed\n", e->name);
+		return -1;
+	}
+	emmc_log("%s: %s ready: %llu MB, %u data lines at %u Hz, CID %x %x %x %x, status %x\n", e->name,
+	    e->sd ? "SD card" : "eMMC", (unsigned long long)(e->sectors / 2048), e->width, e->hz, e->cid[3], e->cid[2],
+	    e->cid[1], e->cid[0], r[0]);
+	return 0;
+}
+
+/* Read or write `count` sectors from `sector` on. */
+static int
+emmc_io(struct emmc *e, uint64_t sector, uint32_t count, uint8_t *buffer, int write)
+{
+	while (count > 0) {
+		uint32_t now = count > 2048 ? 2048 : count;
+		uint32_t argument = (uint32_t)(e->sectors_addressed ? sector : sector * 512);
+		int done = -1;
+
+		for (int attempt = 0; attempt < 3 && done != 0; attempt++) {
+			done = emmc_data(e, write ? (now > 1 ? 25 : 24) : (now > 1 ? 18 : 17), argument, now, buffer, write);
+		}
+		if (done != 0) {
+			return -1;
+		}
+		if (write) {
+			e->writes++;
+			e->written_sectors += now;
+		} else {
+			e->reads++;
+			e->read_sectors += now;
+		}
+		sector += now;
+		count -= now;
+		buffer += 512 * (uint64_t)now;
+	}
+	return 0;
+}
+
+/* ---- GPT --------------------------------------------------------------------------------------- */
+
+struct emmc_part {
+	char            name[37];
+	uint64_t        first, sectors;
+};
+
+/*
+ * Every partition of the GPT, to `each` (which returns nonzero to stop there). `sector` is a buffer
+ * of 512 bytes. Returns what `each` returned last, 0 at the end of the table, or -1.
+ */
+static int
+emmc_gpt_walk(struct emmc *e, uint8_t *sector, int (*each)(void *context, const struct emmc_part *part), void *context)
+{
+	uint64_t entries_lba = 0;
+	uint32_t entries, entry_size;
+	struct emmc_part part;
+
+	if (emmc_io(e, 1, 1, sector, 0) != 0) {
+		return -1;
+	}
+	if (sector[0] != 'E' || sector[1] != 'F' || sector[2] != 'I' || sector[3] != ' ' || sector[4] != 'P') {
+		emmc_log("%s: no GPT\n", e->name);
+		return -1;
+	}
+	for (int i = 7; i >= 0; i--) {
+		entries_lba = entries_lba << 8 | sector[72 + i];
+	}
+	entries = (uint32_t)sector[80] | (uint32_t)sector[81] << 8 | (uint32_t)sector[82] << 16 | (uint32_t)sector[83] << 24;
+	entry_size = (uint32_t)sector[84] | (uint32_t)sector[85] << 8;
+	if (entry_size < 128 || entry_size > 512 || 512 % entry_size != 0 || entries > 1024) {
+		emmc_log("%s: a GPT this code does not read (%u entries of %u bytes)\n", e->name, entries, entry_size);
+		return -1;
+	}
+	for (uint32_t n = 0; n < entries; n++) {
+		uint32_t at = (n * entry_size) % 512;
+		uint64_t first = 0, last = 0;
+		const uint8_t *p;
+		int i, stop;
+
+		if (at == 0 && emmc_io(e, entries_lba + n * entry_size / 512, 1, sector, 0) != 0) {
+			return -1;
+		}
+		p = sector + at;
+		for (i = 7; i >= 0; i--) {
+			first = first << 8 | p[32 + i];
+			last = last << 8 | p[40 + i];
+		}
+		if (first == 0 || last < first) {
+			continue;               /* an unused entry */
+		}
+		for (i = 0; i < 36; i++) {
+			part.name[i] = p[57 + 2 * i] != 0 ? '?' : (char)p[56 + 2 * i];
+		}
+		part.name[36] = 0;
+		part.first = first;
+		part.sectors = last - first + 1;
+		stop = each(context, &part);
+		if (stop != 0) {
+			return stop;
+		}
+	}
+	return 0;
+}
+
+struct emmc_find {
+	const char *            name;
+	struct emmc_part *      part;
+};
+
+static int
+emmc_find_each(void *context, const struct emmc_part *part)
+{
+	struct emmc_find *find = context;
+	int i;
+
+	for (i = 0; find->name[i] != 0 && find->name[i] == part->name[i]; i++) {
+	}
+	if (find->name[i] != 0 || part->name[i] != 0) {
+		return 0;
+	}
+	*find->part = *part;
+	return 1;
+}
+
+/* A partition by name (ASCII, against the GPT's UTF-16 name). Returns 0 and fills `part`, or -1. */
+static int
+emmc_find_partition(struct emmc *e, const char *name, struct emmc_part *part, uint8_t *sector)
+{
+	struct emmc_find find = { .name = name, .part = part };
+	int found = emmc_gpt_walk(e, sector, emmc_find_each, &find);
+
+	if (found == 0) {
+		emmc_log("%s: no partition named %s\n", e->name, name);
+	}
+	return found == 1 ? 0 : -1;
+}
+
+#endif
diff --git a/xnu/files/bsd/dev/redwood_tissot_touch.c b/xnu/files/bsd/dev/redwood_tissot_touch.c
new file mode 100644
index 0000000..ec68b89
--- /dev/null
+++ b/xnu/files/bsd/dev/redwood_tissot_touch.c
@@ -0,0 +1,495 @@
+/*
+ * The touch screen of the Xiaomi Mi A1 (tissot, MSM8953): a FocalTech FT5x06-family controller
+ * at address 0x38 of the I2C bus of BLSP1 QUP3, as a source of touches for /dev/redwood-touch
+ * (sys/redwood_input.h). Only with boot-arg tissot=1 (or tissot_touch=1): every address below
+ * belongs to that phone. The POCO's touchscreen=1 must NOT be given on it.
+ *
+ * There is no clock, pin, regulator or I2C framework in this kernel, so the driver does what
+ * it needs itself:
+ *   power    the controller's supply is LDO10 of the PM8953, which the RPM processor owns: it
+ *            cannot be switched from here without the RPM's request protocol (SMD), so the
+ *            driver reads the regulator's state through the PMIC arbiter and says whether it is
+ *            on (the bootloader leaves it on when it has shown its splash with the panel)
+ *   pins     SDA on GPIO10, SCL on GPIO11 (the QUP's "blsp_i2c3" function, not used here),
+ *            reset on GPIO64 (low = in reset), interrupt on GPIO65 (low = a report waits)
+ *   I2C      the two pins driven by hand, open drain: a pin is let go (an input; the pull-ups
+ *            make it high) or driven low, never driven high. About 100 kHz. The QUP's own I2C
+ *            engine would need its clocks voted in the global clock controller first.
+ *   chip     the FocalTech register map: 0x02 the number of fingers, then 6 bytes per finger
+ *            from 0x03 (event and X[11:8], X[7:0], id and Y[11:8], Y[7:0], weight, area);
+ *            0xA3 chip id, 0xA6 firmware version, 0xA8 vendor; 0xA4 = 0 makes the interrupt
+ *            line stay low while a finger is down instead of pulsing
+ * No interrupt is used: a thread looks at the interrupt line 125 times a second, reads the
+ * report when it is low or a finger was down, and reads one anyway every 80 ms in case the line
+ * says nothing.
+ *
+ * The bring-up is made in steps, each said in the log before it is made. Boot-arg
+ * tissot_touch_steps=N stops after the first N:
+ *   1  read the state of LDO10 (through the PMIC arbiter)
+ *   2  set up the pins, reset the controller
+ *   3  find it on the bus and read what it is
+ *   4  watch it                                         (the default)
+ * Boot-arg tissot_touch_flip=1/2/3: mirror X, Y or both.
+ *
+ * Register layouts: Linux drivers/input/touchscreen/edt-ft5x06.c, drivers/pinctrl/qcom/
+ * pinctrl-msm8953.c, drivers/regulator/qcom_spmi-regulator.c, and the phone's device tree
+ * (msm8953-xiaomi-tissot.dts: touchscreen@38, 1080 x 1920).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- pins (TLMM) ------------------------------------------------------------------------------- */
+
+#define TLMM_PHYS               0x01000000UL
+#define TLMM_SIZE               0x300000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define PULL_NONE               0
+#define PULL_UP                 3
+
+#define PIN_SDA                 10
+#define PIN_SCL                 11
+#define PIN_RESET               64
+#define PIN_INT                 65
+
+static vm_offset_t tlmm;
+
+static void
+gpio_configure(unsigned pin, unsigned pull, unsigned ma, bool output)
+{
+	wr(GPIO_CFG(pin), pull | 0 << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0));
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static bool
+gpio_get(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+/* ---- I2C by hand ------------------------------------------------------------------------------- */
+
+#define I2C_HALF_US             5               /* about 100 kHz */
+#define I2C_STRETCH_US          2000            /* how long a slave may hold the clock low */
+#define FT_ADDRESS              0x38
+
+/* open drain: low is the output enable with the level 0 (set once), high is letting go */
+static void
+line(unsigned pin, bool high)
+{
+	gpio_configure(pin, PULL_UP, 2, !high);
+}
+
+static void
+i2c_init(void)
+{
+	gpio_set(PIN_SDA, false);
+	gpio_set(PIN_SCL, false);
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	sleep_us(I2C_HALF_US);
+}
+
+static bool
+scl_high(void)
+{
+	line(PIN_SCL, true);
+	for (uint32_t waited = 0; !gpio_get(PIN_SCL); waited++) {
+		if (waited >= I2C_STRETCH_US) {
+			return false;
+		}
+		sleep_us(1);
+	}
+	sleep_us(I2C_HALF_US);
+	return true;
+}
+
+static void
+scl_low(void)
+{
+	line(PIN_SCL, false);
+	sleep_us(I2C_HALF_US);
+}
+
+static bool
+i2c_start(void)
+{
+	line(PIN_SDA, true);
+	if (!scl_high()) {
+		return false;
+	}
+	line(PIN_SDA, false);
+	sleep_us(I2C_HALF_US);
+	scl_low();
+	return true;
+}
+
+static void
+i2c_stop(void)
+{
+	line(PIN_SDA, false);
+	scl_high();
+	line(PIN_SDA, true);
+	sleep_us(I2C_HALF_US);
+}
+
+/* Returns true if the byte was acknowledged. */
+static bool
+i2c_put(uint8_t byte)
+{
+	bool ack;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		line(PIN_SDA, byte >> bit & 1);
+		sleep_us(1);
+		if (!scl_high()) {
+			return false;
+		}
+		scl_low();
+	}
+	line(PIN_SDA, true);
+	if (!scl_high()) {
+		return false;
+	}
+	ack = !gpio_get(PIN_SDA);
+	scl_low();
+	return ack;
+}
+
+static uint8_t
+i2c_get(bool last)
+{
+	uint8_t byte = 0;
+
+	line(PIN_SDA, true);
+	for (int bit = 7; bit >= 0; bit--) {
+		scl_high();
+		byte = (uint8_t)(byte << 1 | gpio_get(PIN_SDA));
+		scl_low();
+	}
+	line(PIN_SDA, last);            /* acknowledged, but the last one */
+	sleep_us(1);
+	scl_high();
+	scl_low();
+	line(PIN_SDA, true);
+	return byte;
+}
+
+/* Nine clocks with SDA let go, then a stop: frees a slave that was left in the middle of a byte. */
+static void
+i2c_recover(void)
+{
+	line(PIN_SDA, true);
+	for (int i = 0; i < 9; i++) {
+		scl_high();
+		scl_low();
+	}
+	i2c_stop();
+}
+
+static struct {
+	uint32_t reads, failed;
+} bus;
+
+static bool
+ft_read(uint8_t reg, uint8_t *data, uint32_t length)
+{
+	bool ok = i2c_start() && i2c_put(FT_ADDRESS << 1) && i2c_put(reg) && i2c_start() && i2c_put(FT_ADDRESS << 1 | 1);
+
+	if (ok) {
+		for (uint32_t i = 0; i < length; i++) {
+			data[i] = i2c_get(i + 1 == length);
+		}
+	}
+	i2c_stop();
+	bus.reads++;
+	if (!ok) {
+		bus.failed++;
+		i2c_recover();
+	}
+	return ok;
+}
+
+static bool
+ft_write(uint8_t reg, uint8_t value)
+{
+	bool ok = i2c_start() && i2c_put(FT_ADDRESS << 1) && i2c_put(reg) && i2c_put(value);
+
+	i2c_stop();
+	if (!ok) {
+		i2c_recover();
+	}
+	return ok;
+}
+
+/* ---- the supply -------------------------------------------------------------------------------- */
+
+#define L10_ID                  0x149           /* slave 1, peripheral 0x49: LDO10 of the PM8953 */
+#define VREG_STATUS             0x08            /* [7] ready */
+#define VREG_VOLTAGE            0x40            /* range, then the step */
+#define VREG_ENABLE             0x46            /* [7] */
+
+static void
+supply_state(void)
+{
+	const char *problem;
+	uint8_t status, enable, voltage[2];
+
+	problem = redwood_tissot_spmi_read(L10_ID, VREG_STATUS, &status, 1);
+	if (problem == NULL) {
+		problem = redwood_tissot_spmi_read(L10_ID, VREG_ENABLE, &enable, 1);
+	}
+	if (problem == NULL) {
+		problem = redwood_tissot_spmi_read(L10_ID, VREG_VOLTAGE, voltage, 2);
+	}
+	if (problem != NULL) {
+		printf("tissot-touch: the state of LDO10 cannot be read: %s\n", problem);
+		return;
+	}
+	printf("tissot-touch: LDO10 (the controller's supply): %s, %s; voltage registers %02x %02x\n",
+	    (enable & 0x80) ? "enabled" : "NOT ENABLED by this system", (status & 0x80) ? "ready" : "NOT READY", voltage[0], voltage[1]);
+	if (!(status & 0x80)) {
+		printf("tissot-touch: the controller may have no power; switching it on is the RPM's to do, which this kernel "
+		    "cannot ask yet\n");
+	}
+}
+
+/* ---- the controller --------------------------------------------------------------------------- */
+
+#define FT_REG_TD_STATUS        0x02
+#define FT_REG_POINTS           0x03
+#define FT_REG_INT_MODE         0xa4            /* 0: the line stays low while touched; 1: a pulse per report */
+#define FT_REG_CHIP_ID          0xa3
+#define FT_REG_FIRMWARE         0xa6
+#define FT_REG_VENDOR           0xa8
+#define FT_MAX_TOUCHES          10
+#define FT_EVENT_UP             1
+#define FT_EVENT_NONE           3
+
+#define MAX_X                   1079
+#define MAX_Y                   1919
+#define POLL_US                 8000
+#define IDLE_LOOKS              (80000 / POLL_US)
+
+static uint32_t flip, max_touches = 5;
+
+static struct {
+	bool down, seen;
+	uint32_t x, y;
+} contact[FT_MAX_TOUCHES];
+
+static struct {
+	uint32_t reports, touches, last_x, last_y;
+} seen;
+
+static bool
+any_down(void)
+{
+	for (int i = 0; i < FT_MAX_TOUCHES; i++) {
+		if (contact[i].down) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+ft_report(const uint8_t *points, uint32_t count)
+{
+	static unsigned shown;
+
+	for (int i = 0; i < FT_MAX_TOUCHES; i++) {
+		contact[i].seen = false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *t = points + 6 * i;
+		uint32_t event = t[0] >> 6, id = t[2] >> 4;
+		uint32_t x = (t[0] & 0xf) << 8 | t[1], y = (t[2] & 0xf) << 8 | t[3];
+
+		if (id >= FT_MAX_TOUCHES || event == FT_EVENT_UP || event == FT_EVENT_NONE) {
+			continue;
+		}
+		if (shown < 40) {
+			shown++;
+			printf("tissot-touch: finger %u at %u, %u\n", id, x, y);
+		}
+		seen.touches++;
+		seen.last_x = x;
+		seen.last_y = y;
+		x = x >= MAX_X ? 65535 : x * 65535 / MAX_X;
+		y = y >= MAX_Y ? 65535 : y * 65535 / MAX_Y;
+		if (flip & 1) {
+			x = 65535 - x;
+		}
+		if (flip & 2) {
+			y = 65535 - y;
+		}
+		contact[id].seen = true;
+		if (!contact[id].down) {
+			redwood_touch_post(REDWOOD_TOUCH_DOWN, id, x, y);
+		} else if (contact[id].x != x || contact[id].y != y) {
+			redwood_touch_post(REDWOOD_TOUCH_MOVE, id, x, y);
+		}
+		contact[id].down = true;
+		contact[id].x = x;
+		contact[id].y = y;
+	}
+	for (uint32_t id = 0; id < FT_MAX_TOUCHES; id++) {
+		if (contact[id].down && !contact[id].seen) {
+			contact[id].down = false;
+			redwood_touch_post(REDWOOD_TOUCH_UP, id, contact[id].x, contact[id].y);
+		}
+	}
+}
+
+/* Read the number of fingers, then as many points as there are (one read for both when a finger is down). */
+static void
+ft_poll(void)
+{
+	uint8_t report[1 + 6 * FT_MAX_TOUCHES];
+	uint32_t count;
+
+	if (!ft_read(FT_REG_TD_STATUS, report, 1 + 6 * (any_down() ? max_touches : 0))) {
+		return;
+	}
+	count = report[0] & 0xf;
+	if (count > max_touches) {
+		count = 0;              /* 0xf: no report yet; anything else above: not a report */
+	}
+	if (count > 0 && !any_down() && !ft_read(FT_REG_POINTS, report + 1, 6 * count)) {
+		return;
+	}
+	seen.reports++;
+	ft_report(report + 1, count);
+}
+
+static void
+touch_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t steps = (uint32_t)(uintptr_t)parameter;
+	uint8_t id[1], firmware[1], vendor[1];
+	unsigned idle = 0;
+	bool found = false;
+
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+
+	printf("tissot-touch: step 1: the controller's supply\n");
+	supply_state();
+	if (steps < 2) {
+		goto out;
+	}
+
+	printf("tissot-touch: step 2: the pins (sda gpio%u, scl gpio%u, reset gpio%u, interrupt gpio%u), and a reset\n", PIN_SDA,
+	    PIN_SCL, PIN_RESET, PIN_INT);
+	gpio_configure(PIN_INT, PULL_UP, 2, false);
+	i2c_init();
+	gpio_set(PIN_RESET, false);
+	gpio_configure(PIN_RESET, PULL_NONE, 2, true);
+	sleep_ms(5);
+	gpio_set(PIN_RESET, true);
+	sleep_ms(300);                  /* as edt-ft5x06.c waits for the firmware to start */
+	printf("tissot-touch: out of reset; sda %s, scl %s, interrupt %s\n", gpio_get(PIN_SDA) ? "high" : "LOW",
+	    gpio_get(PIN_SCL) ? "high" : "LOW", gpio_get(PIN_INT) ? "high" : "low");
+	if (steps < 3) {
+		goto out;
+	}
+
+	printf("tissot-touch: step 3: read the chip id at %#x of address %#x\n", FT_REG_CHIP_ID, FT_ADDRESS);
+	for (int attempt = 0; attempt < 3 && !found; attempt++) {
+		if (attempt > 0) {
+			i2c_recover();
+			sleep_ms(20 * attempt);
+		}
+		found = ft_read(FT_REG_CHIP_ID, id, 1);
+	}
+	if (!found) {
+		printf("tissot-touch: nothing answers at address %#x: no touch screen\n", FT_ADDRESS);
+		goto out;
+	}
+	ft_read(FT_REG_FIRMWARE, firmware, 1);
+	ft_read(FT_REG_VENDOR, vendor, 1);
+	printf("tissot-touch: FocalTech chip id %#x, firmware %#x, vendor %#x\n", id[0], firmware[0], vendor[0]);
+	if (id[0] == 0x54 || id[0] == 0x64) {
+		max_touches = FT_MAX_TOUCHES;   /* the FT5x46 and FT8716 kinds report ten */
+	}
+	printf("tissot-touch: interrupt line held low while touched (0xa4 = 0): %s\n",
+	    ft_write(FT_REG_INT_MODE, 0) ? "done" : "NOT ACKNOWLEDGED");
+	if (steps < 4) {
+		goto out;
+	}
+
+	printf("tissot-touch: step 4: watching, up to %u fingers; the interrupt line looked at every %u us\n", max_touches, POLL_US);
+	for (unsigned tick = 1;; tick++) {
+		if (!gpio_get(PIN_INT) || any_down() || ++idle >= IDLE_LOOKS) {
+			idle = 0;
+			ft_poll();
+		}
+		if (tick % (60 * (1000000 / POLL_US)) == 0) {
+			printf("tissot-touch: so far %u reports, %u finger positions, the last at %u, %u; %u reads of the bus, "
+			    "%u failed\n", seen.reports, seen.touches, seen.last_x, seen.last_y, bus.reads, bus.failed);
+		}
+		sleep_us(POLL_US);
+	}
+out:
+	printf("tissot-touch: stopping here (tissot_touch_steps=%u)\n", steps);
+	thread_terminate(current_thread());
+}
+
+void
+redwood_tissot_touch_init(void)
+{
+	uint32_t enabled = 0, steps = 4;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("tissot_touch", &enabled, sizeof(enabled))) {
+		PE_parse_boot_argn("tissot", &enabled, sizeof(enabled));
+	}
+	if (!enabled) {
+		return;
+	}
+	PE_parse_boot_argn("tissot_touch_steps", &steps, sizeof(steps));
+	PE_parse_boot_argn("tissot_touch_flip", &flip, sizeof(flip));
+	if (steps == 0) {
+		return;
+	}
+	if (kernel_thread_start(touch_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
