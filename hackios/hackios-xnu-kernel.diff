+/*
+ * A CPU without PAN (ARMv8.0) takes an undefined-instruction exception on the kernel's PAN
+ * accesses. There is nothing to switch on such a core: writes become NOPs, and reads say
+ * "PAN set" (bit 22), which is what the kernel checks for between user copies.
+ */
+static void
+patch_out_pan(uint32_t *text, uint64_t words)
+{
+	uint64_t writes = 0, reads = 0;
+	for (uint64_t i = 0; i < words; i++) {
+		uint32_t w = text[i];
+		if ((w & 0xFFFFF0FFu) == 0xD500409Fu ||         /* msr PAN, #imm */
+		    (w & 0xFFFFFFE0u) == 0xD5184260u) {         /* msr PAN, Xt */
+			text[i] = 0xD503201Fu;                  /* nop */
+			writes++;
+		} else if ((w & 0xFFFFFFE0u) == 0xD5384260u) {  /* mrs Xt, PAN */
+			text[i] = 0xD2A00800u | (w & 0x1Fu);    /* mov Xt, #0x400000 */
+			reads++;
+		}
+	}
+	print("no PAN on this CPU: %d PAN writes and %d reads patched out of the kernel\n", writes, reads);
+}
