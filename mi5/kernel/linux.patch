diff --git a/libkern/sweet_linux_stubs.c b/libkern/sweet_linux_stubs.c
new file mode 100644
index 0000000..b942613
--- /dev/null
+++ b/libkern/sweet_linux_stubs.c
@@ -0,0 +1,32 @@
+/*
+ * Built on Linux with stock clang (the Mi 5 port of ios-sailfish): what Apple's toolchain
+ * provides and the kernel only names. Static destructors never run in the kernel, and there is
+ * no profiling runtime, so these do nothing.
+ */
+#include <stdint.h>
+#include <stddef.h>
+
+int
+__cxa_atexit(void (*fn)(void *), void *arg, void *dso)
+{
+	(void)fn;
+	(void)arg;
+	(void)dso;
+	return 0;
+}
+
+uint64_t
+__llvm_profile_get_size_for_buffer_internal(const char *a, const char *b, const char *c, const char *d, const char *e,
+    const char *f)
+{
+	(void)a; (void)b; (void)c; (void)d; (void)e; (void)f;
+	return 0;
+}
+
+int
+__llvm_profile_write_buffer_internal(char *buffer, const char *a, const char *b, const char *c, const char *d,
+    const char *e, const char *f)
+{
+	(void)buffer; (void)a; (void)b; (void)c; (void)d; (void)e; (void)f;
+	return -1;
+}
