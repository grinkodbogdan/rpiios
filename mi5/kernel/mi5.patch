+/*
+ * ---- Atmel maXTouch (Mi 5 with the Sharp panel) ----
+ * Registers are 16-bit, little-endian addresses. The information block at 0:
+ * 7 bytes (family, variant, version, build, matrix X, matrix Y, objects), then
+ * 6 bytes per object (type, start address LE16, size - 1, instances - 1,
+ * report IDs per instance). Report IDs are numbered from 1 in object order.
+ * T5 (message processor) holds the next message: report ID (0xff: none), then
+ * the object's data. T100 (multiple touch): its first ID is the screen status,
+ * the second reserved, the rest one per finger; data byte 0 bit 7 = detected,
+ * bits 6:4 the type (1 finger, 2 stylus, 4 glove), then X and Y as LE16.
+ * The attention line (CHG) is low while messages wait.
+ */
+static int
+mxt_read(uint16_t reg, uint8_t *buf, unsigned n)
+{
+	while (n > 0) {
+		unsigned chunk = MIN(n, st.rx_max);
+		uint8_t a[2] = {(uint8_t)reg, (uint8_t)(reg >> 8)};
+		int err = qup_msg(false, a, 2);
+		if (err || (err = qup_msg(true, buf, chunk))) {
+			return err;
+		}
+		reg += chunk;
+		buf += chunk;
+		n -= chunk;
+	}
+	return 0;
+}
+
+static bool
+mxt_init(void)
+{
+	uint8_t info[7], obj[6], cfg[26];
+	int err = mxt_read(0, info, 7);
+	if (err) {
+		printf("SWEET TOUCH: mXT info block err=%d status=%#x flags=%#x\n", err, st.last_status, st.last_err);
+		return false;
+	}
+	printf("SWEET TOUCH: Atmel maXTouch family %#x variant %#x version %u.%u build %#x, matrix %ux%u, %u objects\n",
+	    info[0], info[1], info[2] >> 4, info[2] & 15u, info[3], info[4], info[5], info[6]);
+	unsigned report = 1;
+	for (unsigned i = 0; i < info[6]; i++) {
+		if ((err = mxt_read((uint16_t)(7u + 6u * i), obj, 6))) {
+			printf("SWEET TOUCH: mXT object table err=%d\n", err);
+			return false;
+		}
+		uint16_t start = (uint16_t)(obj[1] | obj[2] << 8);
+		unsigned ids = obj[5] * (obj[4] + 1u);
+		if (obj[0] == 5) {
+			st.t5_addr = start;
+			st.t5_size = (uint8_t)MIN(obj[3] + 1u, 16u);
+		} else if (obj[0] == 100) {
+			st.t100_addr = start;
+			st.t100_min = (uint8_t)report;
+			st.t100_max = (uint8_t)(report + ids - 1);
+		}
+		report += ids;
+	}
+	if (st.t5_addr == 0 || st.t100_addr == 0 || st.t100_max < st.t100_min + 2) {
+		printf("SWEET TOUCH: mXT without T5/T100 (T5 %#x T100 %#x)\n", st.t5_addr, st.t100_addr);
+		return false;
+	}
+	/* T100 config: byte 1 CFG1 (bit 5 SWITCHXY), XRANGE at 13, YRANGE at 24 */
+	if (mxt_read(st.t100_addr, cfg, sizeof(cfg)) == 0) {
+		st.swap_xy = (cfg[1] & 0x20u) != 0;
+		st.xrange = cfg[13] | cfg[14] << 8;
+		st.yrange = cfg[24] | cfg[25] << 8;
+	}
+	if (st.xrange == 0 || st.yrange == 0) {
+		st.xrange = 1079;
+		st.yrange = 1919;
+	}
+	st.objects = MIN((unsigned)(st.t100_max - st.t100_min - 1), TOUCH_MAX);
+	printf("SWEET TOUCH: mXT T5 at %#x (%u bytes), T100 at %#x reports %u..%u, range %ux%u%s, %u fingers\n",
+	    st.t5_addr, st.t5_size, st.t100_addr, st.t100_min, st.t100_max, st.xrange, st.yrange,
+	    st.swap_xy ? " (x/y switched)" : "", st.objects);
+	return true;
+}
+
+static int
+mxt_poll(void)
+{
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	for (unsigned i = 0; i < TOUCH_MAX; i++) {
+		x[i] = st.x[i];
+		y[i] = st.y[i];
+	}
+	bool any = false;
+	for (unsigned m = 0; m < 16; m++) {
+		uint8_t msg[16];
+		int err = mxt_read(st.t5_addr, msg, st.t5_size);
+		if (err) {
+			return err;
+		}
+		if (msg[0] == 0xff || msg[0] == 0) {
+			break;
+		}
+		if (msg[0] < st.t100_min + 2 || msg[0] > st.t100_max) {
+			continue;       /* screen status, other objects */
+		}
+		unsigned id = msg[0] - st.t100_min - 2u;
+		if (id >= TOUCH_MAX) {
+			continue;
+		}
+		unsigned type = (msg[1] >> 4) & 7u;
+		any = true;
+		if ((msg[1] & 0x80u) && (type == 1 || type == 2 || type == 4)) {
+			uint32_t rx = msg[2] | msg[3] << 8, ry = msg[4] | msg[5] << 8;
+			if (st.swap_xy) {
+				uint32_t t = rx;
+				rx = ry;
+				ry = t;
+			}
+			x[id] = (int)(rx * 1079u / MAX(st.swap_xy ? st.yrange : st.xrange, 1u));
+			y[id] = (int)(ry * 1919u / MAX(st.swap_xy ? st.xrange : st.yrange, 1u));
+			mask |= 1u << id;
+		} else {
+			mask &= ~(1u << id);
+		}
+	}
+	if (any) {
+		touch_report(mask, x, y);
+	}
+	return 0;
+}
