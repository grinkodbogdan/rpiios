diff --git a/shim/build-mi5.sh b/shim/build-mi5.sh
new file mode 100755
index 0000000..e187de9
--- /dev/null
+++ b/shim/build-mi5.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+# Build the Xiaomi Mi 5 (gemini) shim and its boot image (rpiios mi5/): start.S + mi5.c
+# + pstore.c + console.c + fdt.c + loader.c, with clang and lld; the payload
+# (tools/mkpayload.py) appended at _end; the Image gzipped with the Mi 5's DTBs
+# appended (LK picks the one for the board), in a v0 boot image for `fastboot boot`.
+# Usage: shim/build-mi5.sh DTB_DIR [PAYLOAD]   -> shim/out/mi5-boot.img
+#   DTB_DIR: the Mi 5's compiled device trees (rpiios mi5/dtb.sh)
+set -euo pipefail
+dtbs=$(realpath "$1")
+payload=${2:+$(realpath "$2")}
+cd "$(dirname "$0")"
+CC="clang --target=aarch64-none-elf"
+CFLAGS="-O2 -ffreestanding -nostdlib -fno-pic -mgeneral-regs-only -mstrict-align -fno-stack-protector -Wall -Wextra -DMI5"
+mkdir -p out/mi5
+for f in start.S mi5.c pstore.c console.c fdt.c loader.c; do
+	$CC $CFLAGS -c $f -o out/mi5/${f%.*}.o
+done
+# No relocation pass at runtime: only start.o's image_size may be absolute.
+abs=$(llvm-readelf -r out/mi5/mi5.o out/mi5/pstore.o out/mi5/console.o out/mi5/fdt.o out/mi5/loader.o | grep -c ABS64 || true)
+[ "$abs" = 0 ] || { echo "error: $abs absolute relocations in C objects" >&2; exit 1; }
+ld.lld -static -T shim.ld --build-id=none -N \
+	out/mi5/start.o out/mi5/mi5.o out/mi5/pstore.o out/mi5/console.o out/mi5/fdt.o out/mi5/loader.o -o out/mi5/shim.elf
+llvm-objcopy -O binary out/mi5/shim.elf out/mi5/Image
+size=$(llvm-nm out/mi5/shim.elf | awk '$3=="_end"{print $1}')
+truncate -s $((16#$size)) out/mi5/Image
+[ -z "$payload" ] || cat "$payload" >> out/mi5/Image
+# LK: kernel at 0x80080000, the DTB at 0x82000000 (platform/msm8996 ABOOT_FORCE_*):
+# the Image may not reach it
+img=$(stat -c %s out/mi5/Image)
+[ "$img" -lt $((0x82000000 - 0x80080000)) ] || { echo "error: Image of $img bytes runs into LK's DTB at 0x82000000" >&2; exit 1; }
+gzip -9 -n -c out/mi5/Image > out/mi5/Image.gz
+cat out/mi5/Image.gz "$dtbs"/*.dtb > out/mi5/Image.gz-dtb
+head -c 4096 /dev/zero | gzip -9 -n > out/mi5/ramdisk.gz	# LK wants one; nothing reads it
+python3 - out/mi5/Image.gz-dtb out/mi5/ramdisk.gz out/mi5-boot.img <<'EOF'
+# Android boot image, header v0 (AOSP mkbootimg's layout): base 0x80000000, 4K pages
+import hashlib, struct, sys
+kernel, ramdisk = (open(f, 'rb').read() for f in sys.argv[1:3])
+page, base = 4096, 0x80000000
+sha = hashlib.sha1()
+for part in (kernel, ramdisk, b''):
+	sha.update(part); sha.update(struct.pack('<I', len(part)))
+h = struct.pack('<8s10I16s512s32s1024s', b'ANDROID!', len(kernel), base + 0x8000, len(ramdisk), base + 0x1000000,
+	0, base + 0xf00000, base + 0x100, page, 0, 0, b'', b'rpiios-mi5', sha.digest().ljust(32, b'\0'), b'')
+pad = lambda d: d + b'\0' * (-len(d) % page)
+open(sys.argv[3], 'wb').write(pad(h) + pad(kernel) + pad(ramdisk))
+print(f'{sys.argv[3]}: {len(pad(h) + pad(kernel) + pad(ramdisk))} bytes, kernel {len(kernel)}')
+EOF
