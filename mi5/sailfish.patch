diff --git a/shim/mi5.c b/shim/mi5.c
new file mode 100644
index 0000000..ddb83b3
--- /dev/null
+++ b/shim/mi5.c
@@ -0,0 +1,209 @@
+/*
+ * Xiaomi Mi 5 (gemini, MSM8996) shim: the Pixel 1's (pixel.c) on another board of
+ * the same SoC. Before anything is drawn it reads, off the MDP, what LK left
+ * running (rpiios mi5/README.md):
+ *   pipe     the one staged on layer mixer 0 by CTL0 (LAYER0 0x902000: VIG0 [2:0],
+ *            RGB0 [11:9], DMA0 [20:18]); its SRC0_ADDR, YSTRIDE and SRC_FORMAT
+ *            (bytes a pixel - 1 in [10:9]) are the splash framebuffer
+ *   mode     CTL0 OP (0x902014) bit 17: a command-mode panel (refreshed by CTL0
+ *            START, as the Pixel's) or a video-mode one (refreshes by itself)
+ *   memory   the upper DDR bank from LK's /memory (1 GB on the 3 GB model, 2 GB
+ *            on the 4 GB one): XNU's, as on the Pixel
+ * and hands them to the kernel as boot-args (sweetfb_*: pexpert/arm/pe_serial.c)
+ * and in boot_args/ADT (loader.c). The payload is appended at _end as on the
+ * Pixel; LK puts the DTB at 0x82000000, which bounds it.
+ * Progress also goes to the ramoops console zone (pstore.c, 0x92920000).
+ */
+#include <stdint.h>
+#include "console.h"
+#include "fdt.h"
+#include "loader.h"
+#include "pstore.h"
+
+#define PSCI_SYSTEM_RESET	0x84000009UL
+#define APSS_WDT		0x9830000UL	/* qcom,wdt@9830000 (msm8996.dtsi) */
+#define WDT_EN			0x08
+
+#define MDP			0x901000UL	/* MDSS + 0x1000 */
+#define CTL0_LAYER0		0x902000UL
+#define CTL0_OP			0x902014UL
+#define CTL_OP_CMD_MODE		(1u << 17)
+#define SSPP_SRC0_ADDR		0x14
+#define SSPP_SRC_YSTRIDE	0x24
+#define SSPP_SRC_FORMAT		0x30
+
+#define UPPER_BANK		0x100000000UL
+
+#define rsr(r) ({ uint64_t _v; __asm__ volatile("mrs %0, " r : "=r"(_v)); _v; })
+
+static inline uint32_t rd32(uintptr_t a) { return *(volatile uint32_t *)a; }
+static inline void wr32(uintptr_t a, uint32_t v) { *(volatile uint32_t *)a = v; }
+
+uintptr_t mi5_fb_base = 0x83401000UL;	/* msm8996.dtsi cont_splash_mem, until read */
+uint32_t mi5_fb_stride = 1080 * 3, mi5_fb_bpp = 3, mi5_fb_video;
+uint64_t mi5_mem_size;
+char mi5_bootargs[160];
+
+extern char _end[];
+
+static void __attribute__((noreturn)) psci_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	__asm__ volatile("dsb sy; smc #0" : "+r"(x0) : : "memory");
+	for (;;)
+		__asm__ volatile("wfe");
+}
+
+static void delay_ms(unsigned ms)
+{
+	uint64_t end = rsr("cntpct_el0") + rsr("cntfrq_el0") / 1000 * ms;
+	while (rsr("cntpct_el0") < end)
+		;
+}
+
+/* tiny formatting for the boot-args: decimal and 0x-hex */
+static char *put_s(char *o, char *end, const char *s)
+{
+	while (*s && o < end)
+		*o++ = *s++;
+	return o;
+}
+
+static char *put_u(char *o, char *end, uint64_t v, int hex)
+{
+	char t[20];
+	int n = 0;
+	if (hex)
+		o = put_s(o, end, "0x");
+	do {
+		t[n++] = "0123456789abcdef"[v % (hex ? 16 : 10)];
+		v /= hex ? 16 : 10;
+	} while (v && n < 20);
+	while (n && o < end)
+		*o++ = t[--n];
+	return o;
+}
+
+static const char *pipe_name(uintptr_t pipe)
+{
+	switch (pipe - MDP) {
+	case 0x4000: return "VIG0";
+	case 0x6000: return "VIG1";
+	case 0x14000: return "RGB0";
+	case 0x16000: return "RGB1";
+	case 0x24000: return "DMA0";
+	default: return "?";
+	}
+}
+
+/* The pipe on mixer 0 and its buffer; 0 if LK left none we know. */
+static uintptr_t display_probe(void)
+{
+	static const struct { uint32_t shift; uintptr_t pipe; } stages[] = {
+		{0, MDP + 0x4000}, {3, MDP + 0x6000}, {9, MDP + 0x14000}, {12, MDP + 0x16000}, {18, MDP + 0x24000},
+	};
+	uint32_t layer = rd32(CTL0_LAYER0);
+	uintptr_t pipe = 0;
+
+	for (unsigned i = 0; i < sizeof(stages) / sizeof(stages[0]); i++) {
+		if (((layer >> stages[i].shift) & 7u) != 0 && rd32(stages[i].pipe + SSPP_SRC0_ADDR) != 0) {
+			pipe = stages[i].pipe;
+			break;
+		}
+	}
+	if (pipe == 0)
+		return 0;
+	uint32_t addr = rd32(pipe + SSPP_SRC0_ADDR);
+	uint32_t stride = rd32(pipe + SSPP_SRC_YSTRIDE) & 0xffffu;
+	uint32_t bpp = ((rd32(pipe + SSPP_SRC_FORMAT) >> 9) & 3u) + 1u;
+	if ((bpp != 3 && bpp != 4) || stride < 1080 * bpp)
+		return 0;
+	mi5_fb_base = addr;
+	mi5_fb_stride = stride;
+	mi5_fb_bpp = bpp;
+	mi5_fb_video = !(rd32(CTL0_OP) & CTL_OP_CMD_MODE);
+	return pipe;
+}
+
+void shim_main(uint64_t dtb)
+{
+	/* LK leaves the APSS watchdog running. */
+	uint32_t wdt_en = rd32(APSS_WDT + WDT_EN);
+	wr32(APSS_WDT + WDT_EN, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	plog_init();
+	plog_str("MI5 SHIM: loader\n");
+	plog_hex("WDT_EN was", wdt_en);
+	plog_hex("DTB", dtb);
+	plog_hex("PAYLOAD", (uintptr_t)_end);
+
+	uintptr_t pipe = display_probe();
+	plog_hex("PIPE", pipe);
+	plog_hex("FB", mi5_fb_base);
+	plog_hex("STRIDE", mi5_fb_stride);
+	plog_hex("VIDEO", mi5_fb_video);
+
+	con_clear(0);
+	con_str("SHIM", "xiaomi mi 5 (gemini) loader");
+	con_skip();
+	con_str("DISPLAY", pipe ? pipe_name(pipe) : "pipe not found, LK's default assumed");
+	con_hex2("FB", "pa=", (uint32_t)mi5_fb_base, "stride=", mi5_fb_stride);
+	con_str("PANEL", mi5_fb_video ? "video mode" : "command mode");
+
+	uint64_t base = 0, size = 0;
+	if (fdt_memory_bank(dtb, UPPER_BANK, &base, &size) && base == UPPER_BANK) {
+		mi5_mem_size = size & ~0x3fffUL;
+		con_hex2("RAM", "4G+ MB=", (uint32_t)(size >> 20), (const char *)0, 0);
+	} else {
+		con_str("RAM", "no upper bank in LK's /memory: the payload's size");
+	}
+	plog_hex("MEM", mi5_mem_size);
+
+	char *o = mi5_bootargs, *end = mi5_bootargs + sizeof(mi5_bootargs) - 1;
+	o = put_s(o, end, "sweetfb_pa=");
+	o = put_u(o, end, mi5_fb_base, 1);
+	o = put_s(o, end, " sweetfb_stride=");
+	o = put_u(o, end, mi5_fb_stride, 0);
+	o = put_s(o, end, " sweetfb_bpp=");
+	o = put_u(o, end, mi5_fb_bpp * 8, 0);
+	o = put_s(o, end, " sweetfb_video=");
+	o = put_u(o, end, mi5_fb_video, 0);
+	if (pipe) {
+		o = put_s(o, end, " sweetfb_pipe=");
+		o = put_u(o, end, pipe, 1);
+	}
+	*o = 0;
+	plog_str(mi5_bootargs);
+	plog_str("\n");
+
+	/* the payload ends below the DTB LK placed: anything else means it was cut short */
+	const char *why;
+	if (dtb <= (uintptr_t)_end)
+		why = "the DTB lies inside the payload: image too large for LK";
+	else
+		why = loader_boot_rd((uintptr_t)_end, dtb);
+	plog_str("LOADER: ");
+	plog_str(why);
+	plog_str("\n");
+	con_str("LOADER", why);
+	con_str("RESET", "in 15s");
+	con_flush();
+	delay_ms(15000);
+	psci_reset();
+}
+
+void secondary_main(uint64_t idx)
+{
+	(void)idx;
+}
+
+void exc_handler(uint64_t slot, uint64_t *regs)
+{
+	(void)regs;
+	plog_hex("EXC slot", slot);
+	plog_hex("ESR", rsr("esr_el1"));
+	plog_hex("FAR", rsr("far_el1"));
+	plog_hex("ELR", rsr("elr_el1"));
+	psci_reset();
+}
diff --git a/shim/pstore.c b/shim/pstore.c
index 0027951..4017913 100644
--- a/shim/pstore.c
+++ b/shim/pstore.c
@@ -7,7 +7,12 @@
  */
 #include "pstore.h"
 
+#ifdef MI5
+/* Mi 5: ramoops_mem@92900000 (1 MB): 4 x 32K dump records, then the 512K console zone */
+#define PRZ_BASE	0x92920000UL
+#else
 #define PRZ_BASE	0x83540000UL
+#endif
 #define PRZ_DATA_MAX	(0x80000UL - 12)
 #define PRZ_SIG		0x43474244U	/* "DBGC" */
 
diff --git a/tools/mkadt.py b/tools/mkadt.py
index dd13ad8..a5fd864 100644
--- a/tools/mkadt.py
+++ b/tools/mkadt.py
