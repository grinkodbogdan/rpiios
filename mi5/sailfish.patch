diff --git a/shim/fdt.c b/shim/fdt.c
index f553f82..2fc1d51 100644
--- a/shim/fdt.c
+++ b/shim/fdt.c
@@ -82,3 +82,59 @@ int fdt_chosen_u64(uintptr_t fdt, const char *prop, uint64_t *out)
 		}
 	}
 }
+
+static int starts(const char *a, const char *b)
+{
+	while (*b && *a == *b)
+		a++, b++;
+	return *b == 0 && (*a == 0 || *a == '@');
+}
+
+int fdt_memory_bank(uintptr_t fdt, uint64_t min_base, uint64_t *base, uint64_t *size)
+{
+	if (!fdt || be32(fdt) != FDT_MAGIC)
+		return 0;
+	uintptr_t p = fdt + be32(fdt + 8);
+	uintptr_t strings = fdt + be32(fdt + 12);
+	int depth = 0, in_mem = 0, found = 0;
+
+	*size = 0;
+	for (;;) {
+		uint32_t tok = be32(p);
+		p += 4;
+		switch (tok) {
+		case FDT_BEGIN_NODE: {
+			const char *name = (const char *)p;
+			depth++;
+			in_mem = depth == 2 && starts(name, "memory");
+			p = align4(skip_str(p));
+			break;
+		}
+		case FDT_END_NODE:
+			in_mem = 0;
+			depth--;
+			break;
+		case FDT_PROP: {
+			uint32_t len = be32(p), nameoff = be32(p + 4);
+			uintptr_t val = p + 8;
+			if (in_mem && streq((const char *)(strings + nameoff), "reg")) {
+				for (uint32_t o = 0; o + 16 <= len; o += 16) {
+					uint64_t b = (uint64_t)be32(val + o) << 32 | be32(val + o + 4);
+					uint64_t s = (uint64_t)be32(val + o + 8) << 32 | be32(val + o + 12);
+					if (b >= min_base && s > *size) {
+						*base = b;
+						*size = s;
+						found = 1;
+					}
+				}
+			}
+			p = align4(val + len);
+			break;
+		}
+		case FDT_NOP:
+			break;
+		default:
+			return found;
+		}
+	}
+}
