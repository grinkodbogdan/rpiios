From 8bd0822789e22732c4695c4a7674e3092ef2e354 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 17:41:46 +0000
Subject: [PATCH] rpi3: accept sandbox_init profile call; deeper watchdog
 backtraces

tccd aborts and mDNSResponder exits (EX_OSERR) when sandbox_init()
fails; with no Sandbox policy, Sandbox call 0 now succeeds on iOS 10.
Watchdog user backtraces go 32 frames deep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0123xbco8JF8tibbBMLmXceV
---
 xnu/osfmk/arm/trap.c    | 2 +-
 xnu/security/mac_base.c | 7 +++++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/xnu/osfmk/arm/trap.c b/xnu/osfmk/arm/trap.c
index 73ccb5d..8fe6e91 100644
--- a/xnu/osfmk/arm/trap.c
+++ b/xnu/osfmk/arm/trap.c
@@ -449,7 +449,7 @@ static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
 
                     kprintf("rpi3 wd bt: %s[%d].%u", proc_name_address(task->bsd_info),
                             proc_pid(task->bsd_info), k);
-                    for (f = 0; f < 14 && fp && fp < 0x40000000U && !(fp & 3); f++) {
+                    for (f = 0; f < 32 && fp && fp < 0x40000000U && !(fp & 3); f++) {
                         if (copyinmap(task->map, fp, frame, sizeof(frame)) != KERN_SUCCESS)
                             break;
                         kprintf(" %08x", frame[1]);
diff --git a/xnu/security/mac_base.c b/xnu/security/mac_base.c
index 49722b4..9f60465 100644
--- a/xnu/security/mac_base.c
+++ b/xnu/security/mac_base.c
@@ -2138,6 +2138,13 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 
 		if (rpi3_ios10_layout && uap->call == 2 && strcmp(target, "Sandbox") == 0)
 			return (0);
+		/*
+		 * Call 0: sandbox_init() applying a named profile. Daemons
+		 * that sandbox themselves (tccd, mDNSResponder) abort or exit
+		 * when it fails; with no Sandbox to enforce it, succeed.
+		 */
+		if (rpi3_ios10_layout && uap->call == 0 && strcmp(target, "Sandbox") == 0)
+			return (0);
 		/*
 		 * Call 15: containermanagerd telling the Sandbox where a
 		 * container lives. Nothing to record without a Sandbox, and
-- 
