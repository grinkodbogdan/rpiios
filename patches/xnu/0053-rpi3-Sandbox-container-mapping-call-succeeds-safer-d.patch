From 2d74d2c3b769b6c5255436ef49ca800a1eab336c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 12:18:37 +0000
Subject: [PATCH] rpi3: Sandbox container mapping call succeeds; safer debug
 stack walks

- __mac_syscall(Sandbox, 15), containermanagerd recording a
  container's path, reports success (there is no Sandbox to update);
  failures made it refuse container requests.
- Watchdog user-stack walks only follow aligned user addresses (a stray
  kernel address in a frame pointer panicked the kernel).
- rpi3_dtlog message tracing: incoming messages, XPC request/reply
  text, larger budget.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0123xbco8JF8tibbBMLmXceV
---
 .rpiios-patches                 |  2 +-
 xnu/bsd/dev/arm/unix_syscalls.c |  2 +-
 xnu/osfmk/arm/trap.c            |  8 ++---
 xnu/osfmk/ipc/mach_msg.c        | 54 +++++++++++++++++++++++++++++++--
 xnu/security/mac_base.c         |  7 +++++
 5 files changed, 64 insertions(+), 9 deletions(-)

diff --git a/.rpiios-patches b/.rpiios-patches
index d383302..bcb0b3b 100644
--- a/.rpiios-patches
+++ b/.rpiios-patches
@@ -1 +1 @@
-c5994808953697f3
+393880c932dc5d0d
diff --git a/xnu/bsd/dev/arm/unix_syscalls.c b/xnu/bsd/dev/arm/unix_syscalls.c
index 0f6a220..b7bac56 100644
--- a/xnu/bsd/dev/arm/unix_syscalls.c
+++ b/xnu/bsd/dev/arm/unix_syscalls.c
@@ -455,7 +455,7 @@ void unix_syscall(arm_saved_state_t * state)
             trace_pid = PE_parse_boot_argn("rpi3_systrace", &v, sizeof(v)) ? v : -1;
         }
         boolean_t always = (code == 360 || code == 366 || code == 367 || code == 368 ||
-                            code == 374 || code == 478);
+                            code == 374 || code == 478 || code == 170);
         if ((error || always) && error != ERESTART && error != EJUSTRETURN && p->p_pid == trace_pid && traced < 400) {
             uint32_t *a = (uint32_t *)uthread->uu_arg;
             traced++;
diff --git a/xnu/osfmk/arm/trap.c b/xnu/osfmk/arm/trap.c
index e527e15..73ccb5d 100644
--- a/xnu/osfmk/arm/trap.c
+++ b/xnu/osfmk/arm/trap.c
@@ -321,14 +321,14 @@ static void rpi3_dump_thread(task_t task, thread_t th)
            s->r[8], s->r[9], s->r[10], s->r[11], s->r[12], s->sp, s->cpsr);
     printf(" cache va %08x/%08x %08x/%08x\n", rpi3_shared_cache_va[0], rpi3_shared_cache_off[0],
            rpi3_shared_cache_va[1], rpi3_shared_cache_off[1]);
-    if (copyinmap(task->map, base, code, sizeof(code)) == KERN_SUCCESS)
+    if (base < 0x40000000U && copyinmap(task->map, base, code, sizeof(code)) == KERN_SUCCESS)
         printf(" code@%08x %08x %08x %08x %08x %08x %08x %08x %08x\n", base,
                code[0], code[1], code[2], code[3], code[4], code[5], code[6], code[7]);
     {
         /* User frame chain (Thumb/ARM APCS: [r7] = caller r7, [r7+4] = lr). */
         uint32_t fp = s->r[7], frame[2], k;
         printf(" bt");
-        for (k = 0; k < 8 && fp; k++) {
+        for (k = 0; k < 8 && fp && fp < 0x40000000U && !(fp & 3); k++) {
             if (copyinmap(task->map, fp, frame, sizeof(frame)) != KERN_SUCCESS) break;
             printf(" %08x", frame[1]);
             if (frame[0] <= fp) break;
@@ -359,7 +359,7 @@ void rpi3_dump_current_thread(void)
         kprintf("rpi3: %s[%d] crashed thread pc %08x lr %08x sp %08x bt",
                 proc_name_address(th->task->bsd_info), proc_pid(th->task->bsd_info),
                 st->pc, st->lr, st->sp);
-        for (k = 0; k < 16 && fp; k++) {
+        for (k = 0; k < 16 && fp && fp < 0x40000000U && !(fp & 3); k++) {
             if (copyinmap(th->task->map, fp, frame, sizeof(frame)) != KERN_SUCCESS)
                 break;
             kprintf(" %08x", frame[1]);
@@ -449,7 +449,7 @@ static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
 
                     kprintf("rpi3 wd bt: %s[%d].%u", proc_name_address(task->bsd_info),
                             proc_pid(task->bsd_info), k);
-                    for (f = 0; f < 14 && fp; f++) {
+                    for (f = 0; f < 14 && fp && fp < 0x40000000U && !(fp & 3); f++) {
                         if (copyinmap(task->map, fp, frame, sizeof(frame)) != KERN_SUCCESS)
                             break;
                         kprintf(" %08x", frame[1]);
diff --git a/xnu/osfmk/ipc/mach_msg.c b/xnu/osfmk/ipc/mach_msg.c
index c110c58..be69e00 100644
--- a/xnu/osfmk/ipc/mach_msg.c
+++ b/xnu/osfmk/ipc/mach_msg.c
@@ -622,20 +622,68 @@ rpi3_msg_dump(ipc_kmsg_t kmsg)
 	unsigned i, n = 0, size = kmsg->ikm_header->msgh_size;
 	const unsigned char *b = (const unsigned char *)kmsg->ikm_header;
 
-	if (!name[0] || !sp || logs > 300 || !IP_VALID(dest))
+	if (!name[0] || !sp || logs > 4000 || !IP_VALID(dest))
 		return;
 	ip_lock(dest);
 	if (ip_active(dest) && dest->ip_receiver_name && dest->ip_receiver)
 		rt = dest->ip_receiver->is_task;
 	ip_unlock(dest);
 	if (rt == TASK_NULL || (rp = rt->bsd_info) == NULL) {
-		if (!strncmp(proc_name_address(sp), name, strlen(name)) && logs++ < 300)
+		if (!strncmp(proc_name_address(sp), name, strlen(name)) &&
+		    kmsg->ikm_header->msgh_id == 0x10000000 && logs++ < 4000) {
 			kprintf("rpi3 send: %s -> kernel id=%d size=%u\n", proc_name_address(sp),
 			    kmsg->ikm_header->msgh_id, size);
+			if (kmsg->ikm_header->msgh_id == 0x10000000 && size <= 1024) {
+				for (i = sizeof(mach_msg_header_t), n = 0; i < size && n < sizeof(line) - 1; i++) {
+					unsigned char c = b[i];
+
+					if (c >= 0x20 && c < 0x7f)
+						line[n++] = c;
+					else if (n && line[n - 1] != '|')
+						line[n++] = '|';
+				}
+				line[n] = 0;
+				kprintf("rpi3 send text: %s\n", line);
+				if (size <= 128) {
+					char hex[400];
+
+					for (i = 0, n = 0; i < size && n < sizeof(hex) - 10; i += 4)
+						n += snprintf(hex + n, sizeof(hex) - n, "%08x ", *(const uint32_t *)(b + i));
+					kprintf("rpi3 send hex: %s\n", hex);
+				}
+			}
+		}
+		return;
+	}
+	if (proc_pid(sp) != 1 && !strncmp(proc_name_address(rp), name, strlen(name)) &&
+	    strncmp(proc_name_address(sp), name, strlen(name))) {
+		if (logs++ < 4000)
+			kprintf("rpi3 recv: %s[%d] -> %s id=%d size=%u bits=%x\n", proc_name_address(sp),
+			    proc_pid(sp), proc_name_address(rp), kmsg->ikm_header->msgh_id, size,
+			    kmsg->ikm_header->msgh_bits);
+		if (size <= 512 && logs < 4000) {
+			for (i = sizeof(mach_msg_header_t), n = 0; i < size && n < sizeof(line) - 1; i++) {
+				unsigned char c = b[i];
+
+				if (c >= 0x20 && c < 0x7f)
+					line[n++] = c;
+				else if (n && line[n - 1] != '|')
+					line[n++] = '|';
+			}
+			line[n] = 0;
+			kprintf("rpi3 recv text: %s\n", line);
+			if (size <= 128) {
+				char hex[400];
+
+				for (i = 0, n = 0; i < size && n < sizeof(hex) - 10; i += 4)
+					n += snprintf(hex + n, sizeof(hex) - n, "%08x ", *(const uint32_t *)(b + i));
+				kprintf("rpi3 recv hex: %s\n", hex);
+			}
+		}
 		return;
 	}
 	if (proc_pid(rp) != 1 && !strncmp(proc_name_address(sp), name, strlen(name))) {
-		if (logs++ < 300)
+		if (logs++ < 4000)
 			kprintf("rpi3 send: %s -> %s[%d] id=%d size=%u bits=%x\n", proc_name_address(sp),
 			    proc_name_address(rp), proc_pid(rp), kmsg->ikm_header->msgh_id, size,
 			    kmsg->ikm_header->msgh_bits);
diff --git a/xnu/security/mac_base.c b/xnu/security/mac_base.c
index 0ee39cd..b0ff5af 100644
--- a/xnu/security/mac_base.c
+++ b/xnu/security/mac_base.c
@@ -2138,6 +2138,13 @@ __mac_syscall(proc_t p, struct __mac_syscall_args *uap, int *retv __unused)
 
 		if (rpi3_ios10_layout && uap->call == 2 && strcmp(target, "Sandbox") == 0)
 			return (0);
+		/*
+		 * Call 15: containermanagerd telling the Sandbox where a
+		 * container lives. Nothing to record without a Sandbox, and
+		 * a failure makes it refuse container requests (installd).
+		 */
+		if (rpi3_ios10_layout && uap->call == 15 && strcmp(target, "Sandbox") == 0)
+			return (0);
 	}
 #endif
 
