+/* ---- HID report descriptor ------------------------------------------- */
+
+/* Find buttons, X and Y in input report 'want_id' (-1: whichever report
+ * declares X first). */
+static void parse_pass(const uint8_t *d, uint32_t len, int want_id, struct rpi3_hid_layout *out)
+{
+    uint32_t at = 0, page = 0, size = 0, count = 0, id = 0, usages[16], nusages = 0;
+    uint32_t umin = 0, umax = 0, have_range = 0, bit[256];
+    int32_t lmin = 0, lmax = 0;
+    struct rpi3_hid_layout l = {0};
+    unsigned i;
+    for (i = 0; i < 256; i++) bit[i] = 0;
+    while (at < len) {
+        uint8_t prefix = d[at++];
+        uint32_t n = prefix & 3, v = 0, tag = prefix & 0xfc;
+        int32_t sv;
+        if (prefix == 0xfe) {                       /* long item: skip */
+            if (at + 1 >= len) break;
+            at += 2 + d[at];
+            continue;
+        }
+        if (n == 3) n = 4;
+        if (at + n > len) break;
+        for (i = 0; i < n; i++) v |= (uint32_t)d[at + i] << (8 * i);
+        at += n;
+        sv = (n == 1) ? (int8_t)v : (n == 2) ? (int16_t)v : (int32_t)v;
+        switch (tag) {
+        case 0x04: page = v; break;                 /* usage page */
+        case 0x14: lmin = sv; break;                /* logical minimum */
+        case 0x24: lmax = (n && lmin >= 0) ? (int32_t)v : sv; break;
+        case 0x74: size = v; break;                 /* report size */
+        case 0x84: id = v & 0xff; break;            /* report id */
+        case 0x94: count = v; break;                /* report count */
+        case 0x08: if (nusages < 16) usages[nusages++] = (n == 4) ? v : (page << 16) | v; break;
+        case 0x18: umin = (n == 4) ? v : (page << 16) | v; have_range |= 1; break;
+        case 0x28: umax = (n == 4) ? v : (page << 16) | v; have_range |= 2; break;
+        case 0x80: {                                /* input */
+            uint32_t k;
+            for (k = 0; k < count; k++) {
+                uint32_t usage = 0, pos = bit[id] + k * size;
+                if (!(v & 1) && (want_id < 0 || (uint32_t)want_id == id)) {   /* data, not constant */
+                    if (k < nusages) usage = usages[k];
+                    else if (nusages) usage = usages[nusages - 1];
+                    else if (have_range == 3) usage = umin + k <= umax ? umin + k : umax;
+                    if ((usage >> 16) == 9 && !l.btn_count && want_id >= 0) {
+                        l.btn_bit = (uint16_t)pos; l.btn_count = (uint8_t)(count - k > 8 ? 8 : count - k);
+                    } else if (usage == 0x10030 && !l.x_size && size <= 32) {
+                        l.x_bit = (uint16_t)pos; l.x_size = (uint8_t)size;
+                        l.x_min = lmin; l.x_max = lmax; l.absolute = !(v & 4);
+                        l.report_id = (uint8_t)id; l.valid = 1;
+                    } else if (usage == 0x10031 && !l.y_size && size <= 32 && want_id >= 0) {
+                        l.y_bit = (uint16_t)pos; l.y_size = (uint8_t)size;
+                        l.y_min = lmin; l.y_max = lmax;
+                    }
+                }
+            }
+            bit[id] += size * count;
+        }   /* fall through: main items clear the local state */
+        case 0x90: case 0xb0: case 0xa0: case 0xc0:
+            nusages = 0; have_range = 0;
+            break;
+        default: break;
+        }
+    }
+    l.valid = l.valid && l.x_size && l.y_size;
+    *out = l;
+}
+
+static void parse_report_descriptor(const uint8_t *d, uint32_t len, struct rpi3_hid_layout *out)
+{
+    struct rpi3_hid_layout first;
+    parse_pass(d, len, -1, &first);                 /* which report carries X */
+    if (!first.x_size) { out->valid = 0; return; }
+    parse_pass(d, len, first.report_id, out);       /* buttons, X, Y of that report */
+}
+
+/* Signed or unsigned field of 'size' bits at bit offset 'pos'. */
+static int32_t report_field(const volatile uint8_t *r, uint32_t len, uint32_t pos, uint32_t size, int is_signed)
+{
+    uint32_t v = 0, i;
+    for (i = 0; i < size; i++) {
+        uint32_t b = pos + i;
+        if (b / 8 >= len) break;
+        v |= (uint32_t)((r[b / 8] >> (b % 8)) & 1) << i;
+    }
+    if (is_signed && size < 32 && (v >> (size - 1)) & 1) v |= ~0U << size;
+    return (int32_t)v;
+}
