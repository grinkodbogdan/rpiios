 .../ARM/AppleARMPlatform/rpi3_touch.cpp       |  28 +++-
 .../ARM/AppleARMPlatform/rpi3_usb.c           | 131 +++++++++++++++++-
 .../ARM/AppleARMPlatform/rpi3_usb.h           |  17 ++-
 xnu/osfmk/arm/trap.c                          |   7 +-
 5 files changed, 260 insertions(+), 19 deletions(-)

diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
index 2d38030..1b411ef 100644
--- a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
@@ -33,7 +33,9 @@
 
 /* CMDTM: transfer mode (low half) and command (high half). */
 #define TM_BLKCNT_EN    (1U << 1)
+#define TM_AUTO_CMD12   (1U << 2)
 #define TM_DAT_READ     (1U << 4)
+#define TM_MULTI_BLOCK  (1U << 5)
 #define CMD_RSP_NONE    (0U << 16)
 #define CMD_RSP_136     (1U << 16)
 #define CMD_RSP_48      (2U << 16)
@@ -322,19 +324,106 @@ static uint32_t card_address(struct rpi3_sd_card *c, uint64_t sector)
 }
 
 /* Read statistics for the boot watchdog. */
-uint32_t rpi3_sd_stat_reads, rpi3_sd_stat_errors;
+uint32_t rpi3_sd_stat_reads, rpi3_sd_stat_errors, rpi3_sd_stat_commands, rpi3_sd_stat_multi_failures;
 uint64_t rpi3_sd_stat_us;
+/* First CMD18 failure: result, block reached, INTERRUPT, STATUS. */
+int32_t rpi3_sd_stat_fail_result;
+uint32_t rpi3_sd_stat_fail_block, rpi3_sd_stat_fail_irq, rpi3_sd_stat_fail_status;
+
+/*
+ * Read-ahead. Everything above this driver (IOStorage, the HFS image file,
+ * the copy-on-write layer) asks for one 512-byte sector at a time, and one
+ * SD command per sector costs the card's access latency every time: about
+ * 0.85 MB/s on a real Pi 3B+. On a miss, read a run of sectors with one
+ * CMD18 (multi-block, auto CMD12) and serve the following requests from
+ * it. The run (4 sectors at first) doubles while reads stay sequential (the ~300 MB shared cache
+ * is read front to back) and drops back on a random read. Writes (only the
+ * boot log) invalidate it.
+ */
+#define RA_MIN      4U
+#define RA_MAX      256U
+static uint8_t ra_buffer[RA_MAX * 512];
+static uint64_t ra_start;
+static uint32_t ra_count, ra_window = RA_MIN;
+static int ra_disabled;
 
 static int read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512]);
+static int read_run(struct rpi3_sd_card *c, uint64_t sector, uint32_t count);
+
 int rpi3_sd_read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512])
 {
-    uint64_t start = now_us(c);
-    int r = read_sector(c, sector, data);
+    uint64_t start;
+    unsigned i;
+    int r;
+    if (ra_count && sector >= ra_start && sector - ra_start < ra_count) {
+        const uint8_t *src = ra_buffer + (uint32_t)(sector - ra_start) * 512U;
+        for (i = 0; i < 512; i++) data[i] = src[i];
+        rpi3_sd_stat_reads++;
+        return LEO_SD_OK;
+    }
+    start = now_us(c);
+    r = LEO_SD_ARGUMENT;
+    if (!ra_disabled && !c->faulted && sector < c->sectors) {
+        uint32_t count;
+        ra_window = (ra_count && sector == ra_start + ra_count) ?
+                    (ra_window * 2 > RA_MAX ? RA_MAX : ra_window * 2) : RA_MIN;
+        count = ra_window;
+        if (c->sectors - sector < count) count = (uint32_t)(c->sectors - sector);
+        ra_count = 0;
+        r = read_run(c, sector, count);
+        if (r != LEO_SD_OK && !rpi3_sd_stat_multi_failures) {
+            rpi3_sd_stat_fail_result = r; rpi3_sd_stat_fail_irq = c->interrupt;
+            rpi3_sd_stat_fail_status = rd(c, STATUS);
+        }
+        if (r == LEO_SD_OK) {
+            ra_start = sector; ra_count = count;
+            for (i = 0; i < 512; i++) data[i] = ra_buffer[i];
+        } else if (++rpi3_sd_stat_multi_failures >= 3) {
+            ra_disabled = 1;   /* card or controller dislikes CMD18: single blocks only */
+        }
+    }
+    if (r != LEO_SD_OK) r = read_sector(c, sector, data);
     rpi3_sd_stat_us += now_us(c) - start;
     if (r) rpi3_sd_stat_errors++; else rpi3_sd_stat_reads++;
     return r;
 }
 
+/* CMD18 for 'count' sectors into ra_buffer, PIO, auto CMD12 at the end. */
+static int read_run(struct rpi3_sd_card *c, uint64_t sector, uint32_t count)
+{
+    uint32_t block, i;
+    int r;
+    rpi3_sd_stat_commands++;
+    wr(c, BLKSIZECNT, (count << 16) | 512U);
+    r = command(c, 18, card_address(c, sector),
+                CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK | CMD_ISDATA | TM_DAT_READ |
+                TM_BLKCNT_EN | TM_MULTI_BLOCK | TM_AUTO_CMD12);
+    if (r) return r;
+    for (block = 0; block < count; block++) {
+        uint8_t *out = ra_buffer + block * 512U;
+        rpi3_sd_stat_fail_block = block;
+        uint64_t start = now_us(c);
+        for (;;) {
+            uint32_t irq = rd(c, INTERRUPT);
+            if (irq & INT_ERROR_MASK) { c->interrupt = irq; wr(c, INTERRUPT, irq);
+                                        reset_lines(c, C1_SRST_CMD | C1_SRST_DATA); return LEO_SD_DATA; }
+            if (irq & INT_READ_RDY) { wr(c, INTERRUPT, INT_READ_RDY); break; }
+            if (now_us(c) - start > c->io.timeout_us) {
+                c->interrupt = irq; reset_lines(c, C1_SRST_CMD | C1_SRST_DATA); return LEO_SD_TIMEOUT;
+            }
+        }
+        for (i = 0; i < 512; i += 4) {
+            uint32_t w = rd(c, DATA);
+            out[i] = (uint8_t)w; out[i + 1] = (uint8_t)(w >> 8);
+            out[i + 2] = (uint8_t)(w >> 16); out[i + 3] = (uint8_t)(w >> 24);
+        }
+    }
+    rpi3_sd_stat_fail_block = count;
+    r = wait_data_done(c);
+    if (r) reset_lines(c, C1_SRST_CMD | C1_SRST_DATA);
+    return r;
+}
+
 static int read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512])
 {
     int r;
@@ -365,6 +454,7 @@ static int read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512
 
 int rpi3_sd_write_sector(struct rpi3_sd_card *c, uint64_t sector, const uint8_t data[512])
 {
+    ra_count = 0;   /* never serve stale read-ahead data */
     int r;
     unsigned i;
     c->write_attempts++;
