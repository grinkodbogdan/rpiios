-    int8_t dx = 0, dy = 0;
+    int32_t dx = 0, dy = 0;
     int r;
     if (!s || !report) return LEO_TOUCH_ARGUMENT;
     if (!s->ready) return LEO_TOUCH_NOT_READY;
@@ -143,8 +149,20 @@ extern "C" int leo_touch_transport_poll(LeoTouchState *s, LeoTouchReport *report
               dbgLast[0], dbgLast[1], dbgLast[2], dbgLast[3], dbgLast[4], dbgLast[5], dbgLast[6], dbgLast[7]);
     }
 
-    cursorX += dx * SPEED_FIXED;
-    cursorY += dy * SPEED_FIXED;
+    if (usb.layout.absolute) {
+        /* Tablet-style pointer: scale its range onto the screen. */
+        int32_t xr = usb.layout.x_max - usb.layout.x_min, yr = usb.layout.y_max - usb.layout.y_min;
+        int32_t nx = xr > 0 ? (int32_t)(((int64_t)(dx - usb.layout.x_min) * (SCREEN_W - 1) * 256) / xr) : cursorX;
+        int32_t ny = yr > 0 ? (int32_t)(((int64_t)(dy - usb.layout.y_min) * (SCREEN_H - 1) * 256) / yr) : cursorY;
+        dx = (nx != cursorX); dy = (ny != cursorY);   /* "moved" flags for below */
+        cursorX = nx; cursorY = ny;
+    } else {
+        int32_t speed = usb.layout.x_size > 8 ? SPEED_FIXED_WIDE : SPEED_FIXED_8BIT;
+        if (dx > 4096) dx = 4096; if (dx < -4096) dx = -4096;
+        if (dy > 4096) dy = 4096; if (dy < -4096) dy = -4096;
+        cursorX += dx * speed;
+        cursorY += dy * speed;
+    }
     if (cursorX < 0) cursorX = 0;
     if (cursorY < 0) cursorY = 0;
     if (cursorX > (SCREEN_W - 1) * 256) cursorX = (SCREEN_W - 1) * 256;
