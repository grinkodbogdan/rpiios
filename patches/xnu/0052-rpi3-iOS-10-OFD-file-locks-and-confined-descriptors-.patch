From b38f1bfb567c711de2dea4be920455fe368995c2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 10:20:09 +0000
Subject: [PATCH] rpi3: iOS 10 OFD file locks and confined descriptors; endless
 watchdog

SQLite in iOS 10 takes its locks with F_OFD_SETLK/F_OFD_GETLK (90-94)
and marks descriptors with F_SETCONFINED (95); this kernel answered
ENOTTY, so database-backed daemons (containermanagerd, then installd,
lsd and SpringBoard behind them) never got going. Map OFD locks onto
POSIX locks and accept confinement. The debug watchdog now keeps
running past ten minutes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0123xbco8JF8tibbBMLmXceV
---
 .rpiios-patches             |  2 +-
 xnu/bsd/kern/kern_descrip.c | 28 ++++++++++++++++++++++++++++
 xnu/osfmk/arm/trap.c        |  2 +-
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/.rpiios-patches b/.rpiios-patches
index bb70449..d383302 100644
--- a/.rpiios-patches
+++ b/.rpiios-patches
@@ -1 +1 @@
-8e24053a12ea1852
+c5994808953697f3
diff --git a/xnu/bsd/kern/kern_descrip.c b/xnu/bsd/kern/kern_descrip.c
index 791a25d..f89e051 100644
--- a/xnu/bsd/kern/kern_descrip.c
+++ b/xnu/bsd/kern/kern_descrip.c
@@ -726,6 +726,34 @@ fcntl_nocancel(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
 		goto out;
 #endif
 
+#if BOARD_CONFIG_RASPBERRYPI3
+	/*
+	 * iOS 10: open-file-description locks (SQLite takes its database
+	 * locks with them) map onto the classic POSIX locks, which use the
+	 * same struct flock; "confined" descriptors are just accepted.
+	 */
+	switch (uap->cmd) {
+	case 90:	/* F_OFD_SETLK */
+		uap->cmd = F_SETLK;
+		break;
+	case 91:	/* F_OFD_SETLKW */
+	case 93:	/* F_OFD_SETLKWTIMEOUT */
+		uap->cmd = F_SETLKW;
+		break;
+	case 92:	/* F_OFD_GETLK */
+	case 94:	/* F_OFD_GETLKPID */
+		uap->cmd = F_GETLK;
+		break;
+	case 95:	/* F_SETCONFINED */
+		error = 0;
+		goto out;
+	case 96:	/* F_GETCONFINED */
+		*retval = 0;
+		error = 0;
+		goto out;
+	}
+#endif
+
 	switch (uap->cmd) {
 
 	case F_DUPFD:
diff --git a/xnu/osfmk/arm/trap.c b/xnu/osfmk/arm/trap.c
index 6ab72cb..e527e15 100644
--- a/xnu/osfmk/arm/trap.c
+++ b/xnu/osfmk/arm/trap.c
@@ -403,7 +403,7 @@ static int rpi3_wdbt_match(const char *name)
 static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
 {
     unsigned round;
-    for (round = 0; round < 120; round++) {
+    for (round = 0; ; round++) {
         task_t task;
         assert_wait_timeout((event_t) &rpi3_watchdog_event, THREAD_UNINT, 5, NSEC_PER_SEC);
         thread_block(THREAD_CONTINUE_NULL);
-- 
