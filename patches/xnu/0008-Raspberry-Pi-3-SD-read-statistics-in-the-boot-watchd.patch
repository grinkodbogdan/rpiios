From 58141e65a6e84f59cb2616243d8a70b72785121e Mon Sep 17 00:00:00 2001
From: rpiios <grinkod.bogdan@gmail.com>
Date: Thu, 15 Oct 2026 12:33:41 +0000
Subject: [PATCH] Raspberry Pi 3: SD read statistics in the boot watchdog

In QEMU launchd spends ~35 s inside dyld before its first spawn, with the
shared cache (about 300 MB) being validated. The SD driver reads one
512-byte block per command, so on real hardware this phase may take
minutes. Count sectors read, errors and time spent in the driver, and
print them in each watchdog line, to tell slow progress from a hang.
---
 .../KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c   | 14 ++++++++++++++
 xnu/osfmk/arm/trap.c                               |  5 ++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
index 2592224..2d38030 100644
--- a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
@@ -321,7 +321,21 @@ static uint32_t card_address(struct rpi3_sd_card *c, uint64_t sector)
     return c->high_capacity ? (uint32_t)sector : (uint32_t)(sector * 512U);
 }
 
+/* Read statistics for the boot watchdog. */
+uint32_t rpi3_sd_stat_reads, rpi3_sd_stat_errors;
+uint64_t rpi3_sd_stat_us;
+
+static int read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512]);
 int rpi3_sd_read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512])
+{
+    uint64_t start = now_us(c);
+    int r = read_sector(c, sector, data);
+    rpi3_sd_stat_us += now_us(c) - start;
+    if (r) rpi3_sd_stat_errors++; else rpi3_sd_stat_reads++;
+    return r;
+}
+
+static int read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512])
 {
     int r;
     unsigned i;
diff --git a/xnu/osfmk/arm/trap.c b/xnu/osfmk/arm/trap.c
index ed4d069..7021396 100644
--- a/xnu/osfmk/arm/trap.c
+++ b/xnu/osfmk/arm/trap.c
@@ -307,6 +307,8 @@ static boolean_t rpi3_unfixable_user_abort(thread_t thread, uint32_t fsr, uint32
  * number on swi). Plus the USB mouse's raw reports. Stops after 10 minutes.
  */
 extern void rpi3_mouse_debug_print(void);
+extern uint32_t rpi3_sd_stat_reads, rpi3_sd_stat_errors;
+extern uint64_t rpi3_sd_stat_us;
 static int rpi3_watchdog_event;
 static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
 {
@@ -315,7 +317,8 @@ static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
         task_t task;
         assert_wait_timeout((event_t) &rpi3_watchdog_event, THREAD_UNINT, 5, NSEC_PER_SEC);
         thread_block(THREAD_CONTINUE_NULL);
-        printf("WD %u:\n", round);
+        printf("WD %u: sd reads=%u (%u KB) errors=%u busy=%u ms\n", round, rpi3_sd_stat_reads,
+               rpi3_sd_stat_reads / 2, rpi3_sd_stat_errors, (uint32_t) (rpi3_sd_stat_us / 1000));
         lck_mtx_lock(&tasks_threads_lock);
         queue_iterate(&tasks, task, task_t, tasks) {
             thread_t th;
-- 
