@@ -1686,3 +1686,15 @@ sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t n
 	return(error);
 }
 
+
+/* For the sysctlbyname system call (iOS 10): name to OID under the geometry lock. */
+int
+rpi3_sysctl_name2oid(char *name, int *oid, int *len)
+{
+	int error;
+
+	lck_rw_lock_shared(sysctl_geometry_lock);
+	error = name2oid(name, oid, len);
+	lck_rw_done(sysctl_geometry_lock);
+	return (error);
+}
diff --git a/xnu/bsd/kern/kern_sysctl.c b/xnu/bsd/kern/kern_sysctl.c
index 1d0fcb3..e8b7f9d 100644
--- a/xnu/bsd/kern/kern_sysctl.c
+++ b/xnu/bsd/kern/kern_sysctl.c
@@ -372,9 +372,50 @@ sysctl_mem_lock(__unused user_addr_t old_addr, __unused user_size_t old_len, __u
  * Locking and stats
  */
 
+static int __sysctl_body(proc_t p, struct __sysctl_args *uap, int *kname);
+
 /* sysctl() syscall */
 int
 __sysctl(proc_t p, struct __sysctl_args *uap, __unused int32_t *retval)
+{
+	return (__sysctl_body(p, uap, NULL));
+}
+
+/*
+ * sysctlbyname() system call (274 on iOS 10; this kernel's 274 was
+ * sem_getvalue, which only ever returned ENOSYS).
+ */
+int
+sysctlbyname_np(proc_t p, struct sysctlbyname_np_args *uap, __unused int32_t *retval)
+{
+	extern int rpi3_sysctl_name2oid(char *name, int *oid, int *len);
+	struct __sysctl_args a;
+	int oid[CTL_MAXNAME], oidlen = 0, error;
+	char *name;
+
+	if (uap->namelen == 0 || uap->namelen > MAXPATHLEN)
+		return (EINVAL);
+	MALLOC(name, char *, uap->namelen + 1, M_TEMP, M_WAITOK);
+	if (name == NULL)
+		return (ENOMEM);
+	error = copyin(uap->name, name, uap->namelen);
+	name[uap->namelen] = '\0';
+	if (!error)
+		error = rpi3_sysctl_name2oid(name, oid, &oidlen);
+	FREE(name, M_TEMP);
+	if (error)
+		return (error);
+	bzero(&a, sizeof (a));
+	a.namelen = oidlen;
+	a.old = uap->old;
+	a.oldlenp = uap->oldlenp;
+	a.new = uap->new;
+	a.newlen = uap->newlen;
+	return (__sysctl_body(p, &a, oid));
+}
+
+static int
+__sysctl_body(proc_t p, struct __sysctl_args *uap, int *kname)
 {
 	boolean_t funnel_state = FALSE;		/* not held if unknown */
 	int error;
@@ -392,7 +433,11 @@ __sysctl(proc_t p, struct __sysctl_args *uap, __unused int32_t *retval)
 	 */
 	if (uap->namelen > CTL_MAXNAME || uap->namelen < 2)
 		return (EINVAL);
-	error = copyin(uap->name, &name[0], uap->namelen * sizeof(int));
+	if (kname) {
+		bcopy(kname, &name[0], uap->namelen * sizeof(int));
+		error = 0;
+	} else
+		error = copyin(uap->name, &name[0], uap->namelen * sizeof(int));
 	if (error)
 		return (error);
 		
