 xnu/osfmk/arm/status.c            |   6 ++
 xnu/osfmk/ipc/mach_kernelrpc.c    |   8 ++
 xnu/osfmk/vm/vm_shared_region.c   | 121 ++++++++++++++++++++++++++++++
 12 files changed, 438 insertions(+), 3 deletions(-)

diff --git a/xnu/bsd/dev/arm/unix_syscalls.c b/xnu/bsd/dev/arm/unix_syscalls.c
index 72d840a..0f6a220 100644
--- a/xnu/bsd/dev/arm/unix_syscalls.c
+++ b/xnu/bsd/dev/arm/unix_syscalls.c
@@ -442,6 +442,29 @@ void unix_syscall(arm_saved_state_t * state)
 #endif
     error = (*(callp->sy_call)) (p, (void *) uthread->uu_arg, &(uthread->uu_rval[0]));
     AUDIT_SYSCALL_EXIT(code, p, uthread, error);
+#if BOARD_CONFIG_RASPBERRYPI3
+    {
+        /*
+         * Bring-up aid: boot-arg rpi3_systrace=PID logs that process's
+         * failing BSD syscalls to the serial port (first 400).
+         */
+        static int trace_pid = -2;
+        static unsigned traced;
+        if (trace_pid == -2) {
+            int v = -1;
+            trace_pid = PE_parse_boot_argn("rpi3_systrace", &v, sizeof(v)) ? v : -1;
+        }
+        boolean_t always = (code == 360 || code == 366 || code == 367 || code == 368 ||
+                            code == 374 || code == 478);
+        if ((error || always) && error != ERESTART && error != EJUSTRETURN && p->p_pid == trace_pid && traced < 400) {
+            uint32_t *a = (uint32_t *)uthread->uu_arg;
+            traced++;
+            kprintf("rpi3 systrace: %s[%d] syscall %u error %d ret %x args %x %x %x %x %x %x\n",
+                    p->p_comm, p->p_pid, code, error, (unsigned)uthread->uu_rval[0],
+                    a[0], a[1], a[2], a[3], a[4], a[5]);
+        }
+    }
+#endif
 #if BOARD_CONFIG_ARMPBA8
     if (lab_syslog_io_index)
         printf("IOS7LAB SYSLOGIO EXIT call=%u pid=%d code=%u error=%d result0=%08x result1=%08x\n",
diff --git a/xnu/bsd/kern/bsd_init.c b/xnu/bsd/kern/bsd_init.c
index 64ccc6b..6bbb133 100644
--- a/xnu/bsd/kern/bsd_init.c
+++ b/xnu/bsd/kern/bsd_init.c
@@ -918,6 +918,23 @@ bsd_init(void)
 	(void)vnode_ref(rootvnode);
 	(void)vnode_put(rootvnode);
 	filedesc0.fd_cdir = rootvnode;
+#if BOARD_CONFIG_RASPBERRYPI3
+	{
+		/*
+		 * iOS 10's 32-bit userland (armv7s shared cache) needs iOS 10's
+		 * address layout: shared region at 0x1A000000..0x40000000, stack
+		 * below it. iOS 7's (armv7 cache) keeps the HD2 layout.
+		 */
+		extern int rpi3_ios10_layout;
+		vnode_t cvp = NULLVP;
+		if (vnode_lookup("/System/Library/Caches/com.apple.dyld/dyld_shared_cache_armv7s",
+		    0, &cvp, &context) == 0) {
+			vnode_put(cvp);
+			rpi3_ios10_layout = 1;
+			printf("rpi3: armv7s shared cache found: iOS 10 address layout\n");
+		}
+	}
+#endif
 
 #if NFSCLIENT
 	if (netboot) {
diff --git a/xnu/bsd/kern/kern_descrip.c b/xnu/bsd/kern/kern_descrip.c
index f4ec2a9..99dfd54 100644
--- a/xnu/bsd/kern/kern_descrip.c
+++ b/xnu/bsd/kern/kern_descrip.c
@@ -74,6 +74,7 @@
  */
 
 #include <sys/param.h>
+#include <sys/random.h>
 #include <arm/ios7_compat.h>
 #include <sys/systm.h>
 #include <sys/filedesc.h>
@@ -1496,6 +1497,35 @@ fcntl_nocancel(proc_t p, struct fcntl_nocancel_args *uap, int32_t *retval)
 
 	}
 
+#if BOARD_CONFIG_RASPBERRYPI3
+	case 97:	/* F_ADDFILESIGS_RETURN (iOS 9+ dyld) */
+	{
+		/*
+		 * dyld registers a file's code signature and checks that the
+		 * returned signed length covers what it maps. Signatures are not
+		 * enforced on this port: report the whole file as covered.
+		 */
+		off_t end;
+
+		if (fp->f_type != DTYPE_VNODE) {
+			error = EBADF;
+			goto out;
+		}
+		vp = (struct vnode *)fp->f_data;
+		proc_fdunlock(p);
+		error = vnode_getwithref(vp);
+		if (error)
+			goto outdrop;
+		error = vnode_size(vp, &end, &context);
+		vnode_put(vp);
+		if (!error)
+			error = copyout(&end, argp, sizeof (end));
+		goto outdrop;
+	}
+	case 98:	/* F_CHECK_LV: library validation, not enforced here */
+		error = 0;
+		goto out;
+#endif
 	case F_ADDSIGS:
 	case F_ADDFILESIGS:
 	{
@@ -5421,3 +5451,68 @@ change_fdguard_np(proc_t p, struct change_fdguard_np_args *uap, __unused int32_t
 		error = copyout(&flags, uap->fdflagsp, sizeof (flags));
 	return (error);
 }
+
+/* iOS 10: getentropy(2), up to 256 bytes from the kernel's generator. */
+int
+getentropy(__unused proc_t p, struct getentropy_args *uap, __unused int32_t *retval)
+{
+	uint8_t buf[256];
+	int error;
+
+	if (uap->size > sizeof (buf))
+		return (EINVAL);
+	read_random(buf, (u_int)uap->size);
+	error = copyout(buf, uap->buffer, uap->size);
+	bzero(buf, sizeof (buf));
+	return (error);
+}
+
+/*
+ * iOS 10: abort_with_payload / terminate_with_payload. Print the reason
+ * (any argument that points to a readable string) and kill the process.
+ */
+static void
+rpi3_payload_reason(proc_t p, const char *what, int *a)
+{
+	int i;
+
+	printf("rpi3: %s[%d] %s args %x %x %x %x %x %x %x %x\n", p->p_comm, p->p_pid, what,
+	    a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
+	for (i = 0; i < 8; i++) {
+		char text[200];
+		size_t done = 0;
+
+		if ((uint32_t)a[i] < 0x1000)
+			continue;
+		if (copyinstr((user_addr_t)(uint32_t)a[i], text, sizeof (text), &done) == 0 &&
+		    done > 4) {
+			printf("rpi3:   arg%d: \"%s\"\n", i, text);
+			kprintf("rpi3: %s[%d] %s arg%d: \"%s\"\n", p->p_comm, p->p_pid, what, i, text);
+		}
+	}
+}
+
+int
+abort_with_payload(proc_t p, struct abort_with_payload_args *uap, __unused int32_t *retval)
+{
+	int a[8] = { uap->a0, uap->a1, uap->a2, uap->a3, uap->a4, uap->a5, uap->a6, uap->a7 };
+
+	rpi3_payload_reason(p, "abort_with_payload", a);
+	psignal(p, SIGABRT);
+	return (0);
+}
+
+int
+terminate_with_payload(proc_t p, struct terminate_with_payload_args *uap, __unused int32_t *retval)
+{
+	int a[8] = { uap->a0, uap->a1, uap->a2, uap->a3, uap->a4, uap->a5, uap->a6, uap->a7 };
+	proc_t target;
+
+	rpi3_payload_reason(p, "terminate_with_payload", a);
+	target = proc_find(uap->a0);
+	if (target == PROC_NULL)
+		return (ESRCH);
+	psignal(target, SIGKILL);
+	proc_rele(target);
+	return (0);
+}
