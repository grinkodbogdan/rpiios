+struct vm_shared_region_slide_info_entry_v2 {
+	uint32_t	version;
+	uint32_t	page_size;
+	uint32_t	page_starts_offset;
+	uint32_t	page_starts_count;
+	uint32_t	page_extras_offset;
+	uint32_t	page_extras_count;
+	uint64_t	delta_mask;
+	uint64_t	value_add;
+};
+#define SR_V2_PAGE_ATTR_EXTRA		0x8000
+#define SR_V2_PAGE_ATTR_NO_REBASE	0x4000
+#define SR_V2_PAGE_ATTR_END		0x8000
+#define SR_V2_PAGE_VALUE		0x3FFF
+#define SR_V2_PAGE_OFFSET_SHIFT		2
+
+static kern_return_t
+vm_shared_region_v2_sanity(struct vm_shared_region_slide_info_entry_v2 *s, mach_vm_size_t size)
+{
+	if (s->page_size != PAGE_SIZE ||
+	    s->page_starts_offset > size ||
+	    s->page_starts_count > (size - s->page_starts_offset) / sizeof (uint16_t) ||
+	    s->page_extras_offset > size ||
+	    s->page_extras_count > (size - s->page_extras_offset) / sizeof (uint16_t) ||
+	    (uint32_t)s->delta_mask == 0)
+		return KERN_FAILURE;
+	return KERN_SUCCESS;
+}
+
+static kern_return_t
+vm_shared_region_v2_chain(uint8_t *page, uint32_t offset, uint32_t slide,
+    struct vm_shared_region_slide_info_entry_v2 *s)
+{
+	const uint32_t last = PAGE_SIZE - sizeof (uint32_t);
+	const uint32_t delta_mask = (uint32_t)s->delta_mask;
+	const uint32_t value_mask = ~delta_mask;
+	const uint32_t value_add = (uint32_t)s->value_add;
+	const uint32_t delta_shift = __builtin_ctzll(s->delta_mask) - 2;
+	uint32_t delta = 1;
+
+	while (delta != 0 && offset <= last) {
+		uint32_t value;
+
+		memcpy(&value, page + offset, sizeof (value));
+		delta = (value & delta_mask) >> delta_shift;
+		value &= value_mask;
+		if (value != 0)
+			value += value_add + slide;
+		memcpy(page + offset, &value, sizeof (value));
+		offset += delta;
+	}
+	return (offset > last && delta != 0) ? KERN_FAILURE : KERN_SUCCESS;
