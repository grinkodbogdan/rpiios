From 97671c2e2594b47ff4e65f8f510f52da68ec45dc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 21:53:21 +0000
Subject: [PATCH 27/27] Raspberry Pi 3: IOSurfaceCreate from any BGRA/RGBA XML
 request

The HD2 code accepted only one full-screen request byte for byte, so
SpringBoard's app snapshot surface (pressing Home) was refused with
kIOReturnUnsupported. Parse the XML properties and create kernel-allocated
surfaces through the existing geometry checks.
---
 .../ARM/AppleARMPlatform/IOS7LeoDisplay.cpp   |  52 ++++++++++++++++++
 ...linux_2_17_x86_64.manylinux2014_x86_64.whl | Bin 0 -> 1485316 bytes
 2 files changed, 52 insertions(+)
 create mode 100644 xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/capstone-5.0.9-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl

diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7LeoDisplay.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7LeoDisplay.cpp
index 88c6802..a471f7e 100644
--- a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7LeoDisplay.cpp
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7LeoDisplay.cpp
@@ -7,6 +7,7 @@
 #include <IOKit/IOBufferMemoryDescriptor.h>
 #include <IOKit/IOWorkLoop.h>
 #include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSUnserialize.h>
 #include <libkern/OSAtomic.h>
 #include "IOS7LabSurfaceGeometry.h"
 #include "IOS7LeoDisplayBackend.h"
@@ -604,8 +605,59 @@ IOReturn IOS7LabSurfaceClient::describeOffscreen(uint32_t id,
     return kIOReturnSuccess;
 }
 
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+/*
+ * IOSurfaceCreate's XML properties, beyond the one full-screen request the
+ * HD2 code accepts byte for byte: SpringBoard's app snapshots (pressing
+ * Home) and other offscreen buffers. Kernel-allocated BGRA/RGBA surfaces
+ * only; the geometry is checked by ios7lab_surface_geometry.
+ */
+static uint32_t rpi3_surface_number(OSDictionary *d, const char *key)
+{
+    OSNumber *n = OSDynamicCast(OSNumber, d->getObject(key));
+    return n ? n->unsigned32BitValue() : 0;
+}
+static bool rpi3_surface_request(const void *xml, uint32_t bytes, IOS7LabSimpleSurfaceRequest *out)
+{
+    if (!bytes || bytes > 4096 || ((const char *)xml)[bytes - 1]) return false;
+    OSObject *o = OSUnserializeXML((const char *)xml);
+    OSDictionary *d = OSDynamicCast(OSDictionary, o);
+    bool ok = false;
+    if (d && !d->getObject("IOSurfaceAddress")) {
+        IOS7LabSimpleSurfaceRequest in;
+        bzero(&in, sizeof(in));
+        in.width = rpi3_surface_number(d, "IOSurfaceWidth");
+        in.height = rpi3_surface_number(d, "IOSurfaceHeight");
+        in.pixelFormat = rpi3_surface_number(d, "IOSurfacePixelFormat");
+        in.bytesPerElement = rpi3_surface_number(d, "IOSurfaceBytesPerElement");
+        in.bytesPerRow = rpi3_surface_number(d, "IOSurfaceBytesPerRow");
+        in.allocationSize = rpi3_surface_number(d, "IOSurfaceAllocSize");
+        if (!in.bytesPerElement) in.bytesPerElement = 4;
+        ok = ios7lab_surface_geometry(&in, out);
+    }
+    if (o) o->release();
+    return ok;
+}
+#endif
 IOReturn IOS7LabSurfaceClient::createOffscreen(IOExternalMethodArguments *args)
 {
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+    if (!args->scalarInputCount && args->structureInput && args->structureOutput &&
+        args->structureOutputSize >= 0x548 && !args->scalarOutputCount &&
+        (args->structureInputSize != sizeof(ios7lab_fullscreen_surface_request) ||
+         memcmp(args->structureInput, ios7lab_fullscreen_surface_request,
+                sizeof(ios7lab_fullscreen_surface_request)) != 0)) {
+        IOS7LabSimpleSurfaceRequest geometry;
+        if (rpi3_surface_request(args->structureInput, args->structureInputSize, &geometry))
+            return createSurface(&geometry, args);
+        static unsigned rejects;
+        if (rejects++ < 4)
+            IOLog("Rpi3 IOSurface request not supported: %.*s\n",
+                  (int)(args->structureInputSize > 600 ? 600 : args->structureInputSize),
+                  (const char *)args->structureInput);
+        return kIOReturnUnsupported;
+    }
+#endif
     if (args->scalarInputCount || !args->structureInput ||
         args->structureInputSize != sizeof(ios7lab_fullscreen_surface_request) ||
         memcmp(args->structureInput, ios7lab_fullscreen_surface_request,
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/capstone-5.0.9-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/capstone-5.0.9-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl
