From 04ea21ab541a92a5d724f253dc092a5a63636b00 Mon Sep 17 00:00:00 2001
From: rpiios <grinkod.bogdan@gmail.com>
Date: Thu, 15 Oct 2026 17:32:17 +0000
Subject: [PATCH 18/19] Raspberry Pi 3: real mach timebase; AppleKeyStore
 stand-in

- clock_timebase_info returned 1/1 (ticks are nanoseconds) while
  mach_absolute_time counts the 1 MHz system timer: every userland timer
  and animation ran 1000 times too slowly. Report NSEC_PER_SEC/hz.
- Neither this XNU nor the HD2 one has AppleKeyStore; SpringBoard got
  kIOReturnError for every keybag call ('Unexpected AppleKeyStore
  error: -536870212') and aborted slide to unlock after asking for the
  lock state. A stand-in service answers every method with success and
  zeroed outputs: no passcode, unlocked. SpringBoard uses selectors 0,
  8, 9, 17 (lock state) and 32.
---
 .../ARM/AppleARMPlatform/AppleARMPE.cpp       |  6 ++
 .../ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp | 94 +++++++++++++++++++
 xnu/iokit/conf/files.arm                      |  1 +
 xnu/osfmk/arm/rtclock.c                       | 15 +++
 4 files changed, 116 insertions(+)
 create mode 100644 xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp

diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/AppleARMPE.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/AppleARMPE.cpp
index 0c14785..edb5f76 100644
--- a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/AppleARMPE.cpp
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/AppleARMPE.cpp
@@ -29,6 +29,9 @@ extern void ios7leo_register_sd(IOService *platform);
 extern void ios7leo_register_display(IOService *platform);
 extern void ios7leo_prepare_root_file();
 extern void ios7leo_register_hid_touch(IOService *platform);
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+extern "C" void rpi3_register_keystore(IOService *platform);
+#endif
 extern "C" void ios7leo_prepare_log_reader(void);
 #endif
 #if BOARD_CONFIG_ARMPBA8
@@ -89,6 +92,9 @@ bool AppleARMPE::start(IOService * provider)
     ios7leo_prepare_log_reader(); /* optional owned logger before rawmedia publication */
     ios7leo_register_sd(this);
     ios7leo_register_hid_touch(this);
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+    rpi3_register_keystore(this);
+#endif
 #endif
     return true;
 }
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp
new file mode 100644
index 0000000..35fb620
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp
@@ -0,0 +1,94 @@
+/*
+ * Raspberry Pi 3: a stand-in for AppleKeyStore, the kernel keybag service.
+ *
+ * Neither this XNU nor the HD2 one has the real AppleKeyStore (it lives in
+ * a kext and talks to the iPhone's crypto hardware). Without it every
+ * MobileKeyBag call fails with kIOReturnError ("Unexpected AppleKeyStore
+ * error: -536870212" from SpringBoard), and SpringBoard aborts slide to
+ * unlock after asking it for the lock state. This answers every method
+ * with success and zeroed outputs: the device has no passcode and is
+ * unlocked (lock state 0), which is what a phone without a passcode
+ * reports. There is no data protection behind it.
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+extern "C" int proc_selfpid(void);
+
+class AppleKeyStore : public IOService {
+    OSDeclareDefaultStructors(AppleKeyStore)
+public:
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+                                   OSDictionary *properties, IOUserClient **handler);
+};
+
+class AppleKeyStoreUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleKeyStoreUserClient)
+public:
+    virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+                                    IOExternalMethodDispatch *dispatch, OSObject *target,
+                                    void *reference);
+    virtual IOReturn clientClose(void);
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService)
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient)
+
+IOReturn AppleKeyStore::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+                                      OSDictionary *properties, IOUserClient **handler)
+{
+    if (!handler) return kIOReturnBadArgument;
+    *handler = 0;
+    AppleKeyStoreUserClient *client = new AppleKeyStoreUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(owningTask, securityID, type, properties)) {
+        client->release(); return kIOReturnNoMemory;
+    }
+    if (!client->attach(this)) { client->release(); return kIOReturnError; }
+    if (!client->start(this)) { client->detach(this); client->release(); return kIOReturnError; }
+    *handler = client;
+    return kIOReturnSuccess;
+}
+
+IOReturn AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+                                                 IOExternalMethodDispatch *, OSObject *, void *)
+{
+    static unsigned logs;
+    uint32_t i;
+    if (!args) return kIOReturnBadArgument;
+    if (logs < 24) {
+        ++logs;
+        IOLog("Rpi3 AppleKeyStore pid=%d selector=%u in=%u/%u out=%u/%u\n", proc_selfpid(), selector,
+              args->scalarInputCount, args->structureInputSize,
+              args->scalarOutputCount, args->structureOutputSize);
+    }
+    for (i = 0; i < args->scalarOutputCount; i++) args->scalarOutput[i] = 0;
+    if (args->structureOutput && args->structureOutputSize)
+        bzero(args->structureOutput, args->structureOutputSize);
+    if (args->structureOutputDescriptor) args->structureOutputDescriptorSize = 0;
+    return kIOReturnSuccess;
+}
+
+IOReturn AppleKeyStoreUserClient::clientClose(void)
+{
+    terminate();
+    return kIOReturnSuccess;
+}
+
+extern "C" void rpi3_register_keystore(IOService *platform)
+{
+    AppleKeyStore *service = new AppleKeyStore;
+    if (!service) return;
+    if (service->init() && service->attach(platform)) {
+        if (service->start(platform)) {
+            service->registerService();
+            IOLog("Rpi3 AppleKeyStore stand-in published (no passcode, unlocked)\n");
+        } else {
+            service->detach(platform);
+        }
+    }
+    service->release();
+}
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
diff --git a/xnu/iokit/conf/files.arm b/xnu/iokit/conf/files.arm
index 2a937bb..ed5d87d 100644
--- a/xnu/iokit/conf/files.arm
+++ b/xnu/iokit/conf/files.arm
@@ -59,5 +59,6 @@ iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/leo_diag_stubs.c standard
 # Raspberry Pi 3 board drivers
 iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3SD.cpp optional iokitcpp
 iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_touch.cpp optional iokitcpp
+iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp optional iokitcpp
 iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_usb.c standard
 iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c standard
diff --git a/xnu/osfmk/arm/rtclock.c b/xnu/osfmk/arm/rtclock.c
index ce5bd91..5e83553 100644
--- a/xnu/osfmk/arm/rtclock.c
+++ b/xnu/osfmk/arm/rtclock.c
@@ -334,6 +334,21 @@ int rtclock_init(void)
 
 void clock_timebase_info(mach_timebase_info_t info)
 {
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+    /*
+     * mach_absolute_time counts the timer configured with rtc_configure()
+     * (the BCM2837 system timer, 1 MHz), not nanoseconds. Userland converts
+     * with this ratio: reporting 1/1 made every userland timer and
+     * animation run 1000 times too slowly (a 60 s timer fired after ~17
+     * hours), so SpringBoard never updated its clock or finished gestures.
+     */
+    if (rtclock_sec_divisor && rtclock_sec_divisor <= NSEC_PER_SEC &&
+        !(NSEC_PER_SEC % rtclock_sec_divisor)) {
+        info->numer = (uint32_t)(NSEC_PER_SEC / rtclock_sec_divisor);
+        info->denom = 1;
+        return;
+    }
+#endif
     info->numer = info->denom = 1;
 }
 
