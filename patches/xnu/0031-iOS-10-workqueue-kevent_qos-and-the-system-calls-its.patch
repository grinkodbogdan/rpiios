+/*
+ * iOS 10 event manager.
+ *
+ * libdispatch registers its kevents on the process' workq kqueue
+ * (kevent_qos with KEVENT_FLAG_WORKQ) and expects the kernel to bring
+ * them to a workqueue thread.  One manager thread per process waits on
+ * that kqueue in the kernel and enters _pthread_wqthread with
+ * WQ_FLAG_THREAD_KEVENT | WQ_FLAG_THREAD_EVENT_MANAGER and the events on
+ * its stack.  It comes back with WQOPS_THREAD_KEVENT_RETURN, carrying
+ * the changes libdispatch deferred, and waits again.
+ *
+ * Its stack is laid out like any workqueue thread's, with the event list
+ * just below the pthread structure and the Mach message area below that:
+ *
+ *   pthread_addr - 16 * 72        event list
+ *   event list   - 32 KiB         received messages (filled upward)
+ *   below that                    the thread's stack
+ */
+static user_addr_t
+rpi3_mgr_pthread_addr(struct workqueue *wq)
+{
+	return (user_addr_t)(wq->wq_rpi3_mgr_stack + PTH_DEFAULT_STACKSIZE + PTH_DEFAULT_GUARDSIZE);
+}
+
+static user_addr_t
+rpi3_mgr_evlist(struct workqueue *wq)
+{
+	return rpi3_mgr_pthread_addr(wq) - RPI3_MGR_NEVENTS * RPI3_KEVENT_QOS_SIZE;
+}
+
+static int rpi3_wq_trace = -1;	/* rpi3_wqtrace=1 boot-arg */
+
+static void
+rpi3_mgr_continue(__unused struct kqueue *kq, __unused void *data, int error)
+{
+	/* data is the scan state (shared with the callback), not the workqueue */
+	proc_t p = current_proc();
+	struct workqueue *wq = (struct workqueue *)p->p_wqptr;
+	thread_t th = current_thread();
+	arm_thread_state_t state;
+	user_addr_t pthread_addr, evlist;
+	uint32_t flags;
+	int n;
+
+	rpi3_kevent_data_set(USER_ADDR_NULL, 0);
+	if (wq == NULL) {
+		/* the process is exiting */
+		thread_exception_return();
+	}
+	n = wq->wq_rpi3_scan.out;
+
+	if (n == 0) {
+		if (error != 0 && error != EWOULDBLOCK &&
+		    (thread_should_abort(th) || (wq->wq_flags & WQ_EXITING))) {
+			/* the process is going away: let the AST take us */
+			thread_exception_return();
+		}
+		rpi3_mgr_wait(p, wq);
+		/* NOTREACHED */
+	}
+
+	if (rpi3_wq_trace < 0 && !PE_parse_boot_argn("rpi3_wqtrace", &rpi3_wq_trace, sizeof(rpi3_wq_trace)))
+		rpi3_wq_trace = 0;
+	if (rpi3_wq_trace > 0) {
+		kprintf("rpi3: %s[%d] event manager: %d events\n", p->p_comm, p->p_pid, n);
+	}
+	pthread_addr = rpi3_mgr_pthread_addr(wq);
+	evlist = rpi3_mgr_evlist(wq);
+	flags = WQ_FLAG_THREAD_NEWSPI | WQ_FLAG_THREAD_KEVENT |
+	    WQ_FLAG_THREAD_EVENT_MANAGER | RPI3_MGR_QOS;
+	if (wq->wq_rpi3_mgr_reuse)
+		flags |= WQ_FLAG_THREAD_REUSE;
+	wq->wq_rpi3_mgr_reuse = 1;
+
+	bzero(&state, sizeof(state));
+	state.r[0] = (uint32_t)pthread_addr;
+	state.r[1] = (uint32_t)wq->wq_rpi3_mgr_port;
+	state.r[2] = (uint32_t)(wq->wq_rpi3_mgr_stack + PTH_DEFAULT_GUARDSIZE);
+	state.r[3] = (uint32_t)evlist;
+	state.r[4] = flags;
+	state.r[5] = (uint32_t)n;
+	state.sp = (uint32_t)((evlist - RPI3_MGR_DATA - C_32_STK_ALIGN) & ~(C_32_STK_ALIGN - 1));
+	state.pc = (uint32_t)p->p_wqthread & ~1U;
+	state.cpsr = 0x10U | (((uint32_t)p->p_wqthread & 1U) ? 0x20U : 0);
+	thread_set_wq_state32(th, (thread_state_t)&state);
+
+	thread_exception_return();
+	/* NOTREACHED */
+}
+
+static void
+rpi3_mgr_wait(proc_t p, struct workqueue *wq)
+{
+	int error;
+
+	wq->wq_rpi3_scan.list = rpi3_mgr_evlist(wq);
+	wq->wq_rpi3_scan.max = RPI3_MGR_NEVENTS;
+	wq->wq_rpi3_scan.out = 0;
+	rpi3_kevent_data_set(rpi3_mgr_evlist(wq) - RPI3_MGR_DATA, RPI3_MGR_DATA);
+
+	error = rpi3_kqwq_scan(wq->wq_rpi3_kq, &wq->wq_rpi3_scan, rpi3_mgr_continue, p);
+	rpi3_mgr_continue(wq->wq_rpi3_kq, wq, error);
+	/* NOTREACHED */
+}
+
+static void
+rpi3_mgr_start(void)
+{
+	proc_t p = current_proc();
+	struct workqueue *wq = (struct workqueue *)p->p_wqptr;
+
+	if (wq == NULL || wq->wq_rpi3_kq == NULL || (wq->wq_flags & WQ_EXITING)) {
+		thread_terminate(current_thread());
+		thread_exception_return();
+	}
+	rpi3_mgr_wait(p, wq);
+	/* NOTREACHED */
+}
+
+static int
+rpi3_mgr_create(proc_t p, struct workqueue *wq)
+{
+	mach_vm_offset_t stackaddr = 0x10000000;
+	mach_vm_size_t allocsize;
+	kern_return_t kret;
+	struct uthread *uth;
+	void *sright;
+	thread_t th;
+
+	kret = thread_create_workq(wq->wq_task, (thread_continue_t)rpi3_mgr_start, &th);
+	if (kret != KERN_SUCCESS)
+		return (ENOMEM);
+
+	allocsize = PTH_DEFAULT_STACKSIZE + PTH_DEFAULT_GUARDSIZE + p->p_pthsize;
+	kret = mach_vm_map(wq->wq_map, &stackaddr, allocsize, page_size - 1,
+	    VM_MAKE_TAG(VM_MEMORY_STACK) | VM_FLAGS_ANYWHERE, NULL, 0, FALSE,
+	    VM_PROT_DEFAULT, VM_PROT_ALL, VM_INHERIT_DEFAULT);
+	if (kret == KERN_SUCCESS) {
+		kret = mach_vm_protect(wq->wq_map, stackaddr, PTH_DEFAULT_GUARDSIZE, FALSE, VM_PROT_NONE);
+		if (kret != KERN_SUCCESS)
+			(void)mach_vm_deallocate(wq->wq_map, stackaddr, allocsize);
+	}
+	if (kret != KERN_SUCCESS) {
+		(void)thread_terminate(th);
+		thread_deallocate(th);
+		return (ENOMEM);
+	}
+	thread_reference(th);
+	sright = (void *)convert_thread_to_port(th);	/* consumes a reference */
+
+	wq->wq_rpi3_mgr_stack = stackaddr;
+	wq->wq_rpi3_mgr_allocsize = allocsize;
+	wq->wq_rpi3_mgr_port = ipc_port_copyout_send(sright, get_task_ipcspace(wq->wq_task));
+	wq->wq_rpi3_mgr_reuse = 0;
+
+	thread_static_param(th, TRUE);
+	uth = get_bsdthread_info(th);
+	uth->uu_sigmask = ~workq_threadmask;
+
+	wq->wq_rpi3_mgr = th;
+	kprintf("rpi3: %s[%d] workqueue event manager, stack 0x%llx\n", p->p_comm, p->p_pid,
+	    (unsigned long long)stackaddr);
+	thread_resume(th);
+	return (0);
+}
+
+/*
+ * The process' workq kqueue, created (with its event manager) on first
+ * use.
+ */
+struct kqueue *
+rpi3_workq_kqueue(struct proc *p)
+{
+	struct workqueue *wq;
+	struct kqueue *kq;
+
+	if ((p->p_lflag & P_LREGISTER) == 0)
+		return (NULL);
+	if (p->p_wqptr == NULL)
+		(void)workq_open(p, NULL, NULL);
+	if ((wq = (struct workqueue *)p->p_wqptr) == NULL)
+		return (NULL);
+	if (wq->wq_rpi3_kq != NULL)
+		return (wq->wq_rpi3_kq);
+
+	kq = kqueue_alloc(p);
+	if (kq == NULL)
+		return (NULL);
+	if (!OSCompareAndSwapPtr(NULL, kq, &wq->wq_rpi3_kq)) {
+		kqueue_dealloc(kq);
+		return (wq->wq_rpi3_kq);
+	}
+	if (rpi3_mgr_create(p, wq) != 0)
+		printf("rpi3: %s[%d]: no workqueue event manager\n", p->p_comm, p->p_pid);
+	return (kq);
+}
