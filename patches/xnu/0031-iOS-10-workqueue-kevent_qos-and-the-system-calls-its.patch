+/*
+ * iOS 10: the *at() family.  A relative path is looked up from the
+ * directory fd by making it the calling thread's working directory for
+ * the duration of the call (namei honours uu_cdir).
+ */
+#define RPI3_AT_FDCWD		-2
+#define RPI3_AT_EACCESS		0x0010
+#define RPI3_AT_SYMLINK_NOFOLLOW 0x0020
+#define RPI3_AT_REMOVEDIR	0x0080
+
+struct rpi3_at {
+	int		fd;
+	vnode_t		saved_cdir;
+	int		active;
+};
+
+static int
+rpi3_at_begin(proc_t p, int fd, user_addr_t path, struct rpi3_at *at)
+{
+	struct uthread *ut = get_bsdthread_info(current_thread());
+	char c = 0;
+	vnode_t vp;
+	int error;
+
+	at->active = 0;
+	if (fd == RPI3_AT_FDCWD)
+		return (0);
+	if (path != USER_ADDR_NULL && copyin(path, &c, 1) == 0 && c == '/')
+		return (0);
+	if ((error = file_vnode(fd, &vp)) != 0)
+		return (error);
+	if (vnode_vtype(vp) != VDIR) {
+		file_drop(fd);
+		return (ENOTDIR);
+	}
+	(void)p;
+	at->fd = fd;
+	at->saved_cdir = ut->uu_cdir;
+	ut->uu_cdir = vp;
+	at->active = 1;
+	return (0);
+}
+
+static int
+rpi3_at_end(struct rpi3_at *at, int error)
+{
+	if (at->active) {
+		struct uthread *ut = get_bsdthread_info(current_thread());
+
+		ut->uu_cdir = at->saved_cdir;
+		file_drop(at->fd);
+	}
+	return (error);
+}
+
+int
+openat_nocancel(proc_t p, struct openat_nocancel_args *uap, int32_t *retval)
+{
+	struct open_nocancel_args a;
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.flags = uap->flags;
+	a.mode = uap->mode;
+	return rpi3_at_end(&at, open_nocancel(p, &a, retval));
+}
+
+int
+openat(proc_t p, struct openat_args *uap, int32_t *retval)
+{
+	__pthread_testcancel(1);
+	return openat_nocancel(p, (struct openat_nocancel_args *)uap, retval);
+}
+
+int
+renameat(proc_t p, struct renameat_args *uap, int32_t *retval)
+{
+	struct rename_args a;
+	struct rpi3_at at;
+	char c = 0;
+	int error;
+
+	/* both names must resolve from the same place */
+	if (uap->tofd != uap->fromfd && uap->tofd != RPI3_AT_FDCWD &&
+	    !(copyin(uap->to, &c, 1) == 0 && c == '/'))
+		return (ENOTSUP);
+	if ((error = rpi3_at_begin(p, uap->fromfd, uap->from, &at)) != 0)
+		return (error);
+	a.from = uap->from;
+	a.to = uap->to;
+	return rpi3_at_end(&at, rename(p, &a, retval));
+}
+
+int
+faccessat(proc_t p, struct faccessat_args *uap, int32_t *retval)
+{
+	struct access_args a;
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.flags = uap->amode;
+	return rpi3_at_end(&at, access(p, &a, retval));
+}
+
+int
+fchmodat(proc_t p, struct fchmodat_args *uap, int32_t *retval)
+{
+	struct chmod_args a;
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.mode = uap->mode;
+	return rpi3_at_end(&at, chmod(p, &a, retval));
+}
+
+int
+fchownat(proc_t p, struct fchownat_args *uap, int32_t *retval)
+{
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	if (uap->flag & RPI3_AT_SYMLINK_NOFOLLOW) {
+		struct lchown_args a;
+
+		a.path = uap->path;
+		a.owner = uap->uid;
+		a.group = uap->gid;
+		error = lchown(p, &a, retval);
+	} else {
+		struct chown_args a;
+
+		a.path = uap->path;
+		a.uid = uap->uid;
+		a.gid = uap->gid;
+		error = chown(p, &a, retval);
+	}
+	return rpi3_at_end(&at, error);
+}
+
+int
+fstatat64(proc_t p, struct fstatat64_args *uap, int32_t *retval)
+{
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	if (uap->flag & RPI3_AT_SYMLINK_NOFOLLOW) {
+		struct lstat64_args a;
+
+		a.path = uap->path;
+		a.ub = uap->ub;
+		error = lstat64(p, &a, retval);
+	} else {
+		struct stat64_args a;
+
+		a.path = uap->path;
+		a.ub = uap->ub;
+		error = stat64(p, &a, retval);
+	}
+	return rpi3_at_end(&at, error);
+}
+
+int
+fstatat(proc_t p, struct fstatat_args *uap, int32_t *retval)
+{
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	if (uap->flag & RPI3_AT_SYMLINK_NOFOLLOW) {
+		struct lstat_args a;
+
+		a.path = uap->path;
+		a.ub = uap->ub;
+		error = lstat(p, &a, retval);
+	} else {
+		struct stat_args a;
+
+		a.path = uap->path;
+		a.ub = uap->ub;
+		error = stat(p, &a, retval);
+	}
+	return rpi3_at_end(&at, error);
+}
+
+int
+linkat(proc_t p, struct linkat_args *uap, int32_t *retval)
+{
+	struct link_args a;
+	struct rpi3_at at;
+	char c = 0;
+	int error;
+
+	if (uap->fd2 != uap->fd1 && uap->fd2 != RPI3_AT_FDCWD &&
+	    !(copyin(uap->link, &c, 1) == 0 && c == '/'))
+		return (ENOTSUP);
+	if ((error = rpi3_at_begin(p, uap->fd1, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.link = uap->link;
+	return rpi3_at_end(&at, link(p, &a, retval));
+}
+
+int
+unlinkat(proc_t p, struct unlinkat_args *uap, int32_t *retval)
+{
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	if (uap->flag & RPI3_AT_REMOVEDIR) {
+		struct rmdir_args a;
+
+		a.path = uap->path;
+		error = rmdir(p, &a, retval);
+	} else {
+		struct unlink_args a;
+
+		a.path = uap->path;
+		error = unlink(p, &a, retval);
+	}
+	return rpi3_at_end(&at, error);
+}
+
+int
+readlinkat(proc_t p, struct readlinkat_args *uap, int32_t *retval)
+{
+	struct readlink_args a;
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.buf = uap->buf;
+	a.count = (int)uap->bufsize;
+	return rpi3_at_end(&at, readlink(p, &a, retval));
+}
+
+int
+symlinkat(proc_t p, struct symlinkat_args *uap, int32_t *retval)
+{
+	struct symlink_args a;
+	struct rpi3_at at;
+	int error;
+
+	/* path1 is the link's contents; path2 is created relative to fd */
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path2, &at)) != 0)
+		return (error);
+	a.path = uap->path1;
+	a.link = uap->path2;
+	return rpi3_at_end(&at, symlink(p, &a, retval));
+}
+
+int
+mkdirat(proc_t p, struct mkdirat_args *uap, int32_t *retval)
+{
+	struct mkdir_args a;
+	struct rpi3_at at;
+	int error;
+
+	if ((error = rpi3_at_begin(p, uap->fd, uap->path, &at)) != 0)
+		return (error);
+	a.path = uap->path;
+	a.mode = uap->mode;
+	return rpi3_at_end(&at, mkdir(p, &a, retval));
+}
+
+/*
+ * iOS 10: coalitions.  launchd puts each job in one; nothing here acts
+ * on them, so create hands out fresh ids and the rest succeeds.
+ */
+int
+coalition(__unused proc_t p, struct coalition_args *uap, __unused int32_t *retval)
+{
+	static uint64_t next_cid = 1000;
+	uint64_t cid;
+
+	switch (uap->operation) {
+	case 1:		/* COALITION_OP_CREATE */
+		cid = ++next_cid;	/* uniprocessor kernel; system call context */
+		return (copyout(&cid, uap->cid, sizeof (cid)));
+	case 2:		/* COALITION_OP_TERMINATE */
+	case 3:		/* COALITION_OP_REAP */
+		return (0);
+	default:
+		return (EINVAL);
+	}
+}
+
+int
+coalition_info(__unused proc_t p, struct coalition_info_args *uap, __unused int32_t *retval)
+{
+	uint8_t zero[256];
+	uint32_t size = 0;
+	int error;
+
+	if (uap->bufsize == USER_ADDR_NULL)
+		return (EINVAL);
+	if ((error = copyin(uap->bufsize, &size, sizeof (size))) != 0)
+		return (error);
+	if (size > sizeof (zero))
+		size = sizeof (zero);
+	bzero(zero, sizeof (zero));
+	if (uap->buffer != USER_ADDR_NULL && (error = copyout(zero, uap->buffer, size)) != 0)
+		return (error);
+	return (copyout(&size, uap->bufsize, sizeof (size)));
+}
