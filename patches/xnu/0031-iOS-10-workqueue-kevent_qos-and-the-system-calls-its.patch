+		if (rpi3_kq_trace > 0 && iskev64 == KEVENT_LAYOUT_QOS)
+			kprintf("rpi3: %s[%d] kq register filter %d ident 0x%llx flags 0x%x fflags 0x%x udata 0x%llx -> %d\n",
+			    p->p_comm, p->p_pid, kev.filter, kev.ident, kev.flags, kev.fflags, kev.udata, error);
