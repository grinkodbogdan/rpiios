+/*
+ * iOS 10 flavors: PROC_PIDUNIQIDENTIFIERINFO (17),
+ * PROC_PIDT_BSDINFOWITHUNIQID (18) and PROC_PIDARCHINFO (19).
+ */
+struct rpi3_proc_uniqidentifierinfo {
+	uint8_t		p_uuid[16];
+	uint64_t	p_uniqueid;
+	uint64_t	p_puniqueid;
+	uint64_t	p_reserve2;
+	uint64_t	p_reserve3;
+	uint64_t	p_reserve4;
+};
+
+struct rpi3_proc_bsdinfowithuniqid {
+	struct proc_bsdinfo		pbsd;
+	struct rpi3_proc_uniqidentifierinfo p_uniqidentifier;
+};
+
+struct rpi3_proc_archinfo {
+	cpu_type_t	p_cputype;
+	cpu_subtype_t	p_cpusubtype;
+};
+
+static void
+rpi3_proc_uniqinfo(proc_t p, struct rpi3_proc_uniqidentifierinfo *u)
+{
+	proc_t pp;
+
+	bzero(u, sizeof(*u));
+	bcopy(p->p_uuid, u->p_uuid, sizeof(u->p_uuid));
+	u->p_uniqueid = p->p_uniqueid;
+	pp = proc_find(p->p_ppid);
+	if (pp != PROC_NULL) {
+		u->p_puniqueid = pp->p_uniqueid;
+		proc_rele(pp);
+	}
+}
