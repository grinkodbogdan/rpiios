+/*
+ * cs_identity_get
+ *
+ * The signing identifier of a process' main executable (from its
+ * CodeDirectory), or NULL.  Points into the vnode's signature blob.
+ */
+const char *
+cs_identity_get(proc_t p)
+{
+	struct cs_blob *blob_list_entry;
+	CS_SuperBlob *super_blob;
+	CS_CodeDirectory *code_dir;
+	CS_GenericBlob *blob;
+	unsigned int i, count;
+	uint32_t ident;
+
+	if (NULL == p->p_textvp)
+		return NULL;
+	if (NULL == (blob_list_entry = ubc_cs_blob_get(p->p_textvp, -1,
+	    p->p_textoff)))
+		return NULL;
+	super_blob = (void *)blob_list_entry->csb_mem_kaddr;
+	if (CSMAGIC_EMBEDDED_SIGNATURE != ntohl(super_blob->magic))
+		return NULL;
+	count = ntohl(super_blob->count);
+	for (i = 0; i < count; ++i) {
+		if (ntohl(super_blob->index[i].type) != CSSLOT_CODEDIRECTORY)
+			continue;
+		blob = (void *)((char *)super_blob + ntohl(super_blob->index[i].offset));
+		if (CSMAGIC_CODEDIRECTORY != ntohl(blob->magic))
+			return NULL;
+		code_dir = (void *)blob;
+		ident = ntohl(code_dir->identOffset);
+		if (ident == 0 || ident >= ntohl(code_dir->length))
+			return NULL;
+		return (const char *)code_dir + ident;
+	}
+	return NULL;
+}
