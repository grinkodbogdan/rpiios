+void
+rpi3_kevent_data_set(user_addr_t data_out, user_size_t size)
+{
+	uthread_t ut = (uthread_t)get_bsdthread_info(current_thread());
+
+	ut->uu_rpi3_data_out = data_out;
+	ut->uu_rpi3_data_left = size;
+	ut->uu_rpi3_data_availp = 0;
+}
+
+void
+rpi3_kevent_data_finish(void)
+{
+	uthread_t ut = (uthread_t)get_bsdthread_info(current_thread());
+
+	if (ut->uu_rpi3_data_availp != USER_ADDR_NULL) {
+		uint32_t avail = (uint32_t)ut->uu_rpi3_data_left;
+
+		(void)copyout(&avail, ut->uu_rpi3_data_availp, sizeof(avail));
+	}
+	ut->uu_rpi3_data_out = 0;
+	ut->uu_rpi3_data_left = 0;
+	ut->uu_rpi3_data_availp = 0;
+}
+
+int
+rpi3_kevent_data_get(mach_vm_address_t *addr, mach_msg_size_t *size)
+{
+	uthread_t ut = (uthread_t)get_bsdthread_info(current_thread());
+
+	if (ut->uu_rpi3_data_out == USER_ADDR_NULL || ut->uu_rpi3_data_left < 64)
+		return ENOSPC;
+	*addr = ut->uu_rpi3_data_out;
+	*size = (mach_msg_size_t)ut->uu_rpi3_data_left;
+	return 0;
+}
