+void
+rpi3_kevent_data_used(mach_msg_size_t used)
+{
+	uthread_t ut = (uthread_t)get_bsdthread_info(current_thread());
+
+	if (used > ut->uu_rpi3_data_left)
+		used = (mach_msg_size_t)ut->uu_rpi3_data_left;
+	ut->uu_rpi3_data_out += used;
+	ut->uu_rpi3_data_left -= used;
