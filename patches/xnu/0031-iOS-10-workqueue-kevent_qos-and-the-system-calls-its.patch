+{
+	uthread_t ut = (uthread_t)get_bsdthread_info(current_thread());
+	uint32_t avail = 0;
+	int error;
+
+	ut->uu_rpi3_data_out = 0;
+	ut->uu_rpi3_data_left = 0;
+	ut->uu_rpi3_data_availp = 0;
+	if (data_out == USER_ADDR_NULL || data_availp == USER_ADDR_NULL)
+		return 0;
+	error = copyin(data_availp, &avail, sizeof(avail));
+	if (error)
+		return error;
+	ut->uu_rpi3_data_out = data_out;
+	ut->uu_rpi3_data_left = avail;
+	ut->uu_rpi3_data_availp = data_availp;
+	return 0;
+}
