+
+/*
+ * ulock_wait / ulock_wake (os_unfair_lock, os_once and friends).
+ * Waiters on the same (process, address) share a slot; ulock_wait
+ * returns how many others are still waiting there.
+ */
+#define UL_OPCODE_MASK		0x000000ff
+#define ULF_WAKE_ALL		0x00000100
+#define ULF_NO_ERRNO		0x01000000
+#define RPI3_ULOCK_SLOTS	64
+
+struct rpi3_ulock {
+	proc_t		ul_proc;
+	user_addr_t	ul_addr;
+	int		ul_waiters;
+};
+static struct rpi3_ulock rpi3_ulocks[RPI3_ULOCK_SLOTS];
+static lck_mtx_t *rpi3_ulock_mtx;
+
+static struct rpi3_ulock *
+rpi3_ulock_find(proc_t p, user_addr_t addr, int create)
+{
+	struct rpi3_ulock *ul, *free_ul = NULL;
+	int i;
+
+	for (i = 0; i < RPI3_ULOCK_SLOTS; i++) {
+		ul = &rpi3_ulocks[i];
+		if (ul->ul_waiters > 0 && ul->ul_proc == p && ul->ul_addr == addr)
+			return (ul);
+		if (ul->ul_waiters == 0 && free_ul == NULL)
+			free_ul = ul;
+	}
+	if (create && free_ul != NULL) {
+		free_ul->ul_proc = p;
+		free_ul->ul_addr = addr;
+	}
+	return (create ? free_ul : NULL);
+}
+
+static int
+rpi3_ulock_ret(uint32_t op, int error, int32_t *retval)
+{
+	if (error != 0 && (op & ULF_NO_ERRNO)) {
+		*retval = -error;
+		return (0);
+	}
+	return (error);
+}
+
+int
+ulock_wait(struct proc *p, struct ulock_wait_args *uap, int32_t *retval)
+{
+	struct rpi3_ulock *ul;
+	uint32_t value;
+	uint64_t deadline = 0;
+	wait_result_t wr;
+	int error = 0;
+
+	*retval = 0;
+	if (uap->addr == USER_ADDR_NULL)
+		return rpi3_ulock_ret(uap->operation, EINVAL, retval);
+
+	lck_mtx_lock(rpi3_ulock_mtx);
+	if (copyin(uap->addr, &value, sizeof(value)) != 0) {
+		lck_mtx_unlock(rpi3_ulock_mtx);
+		return rpi3_ulock_ret(uap->operation, EFAULT, retval);
+	}
+	if (value != uap->value_lo) {
+		/* already changed: nothing to wait for */
+		lck_mtx_unlock(rpi3_ulock_mtx);
+		return (0);
+	}
+	ul = rpi3_ulock_find(p, uap->addr, 1);
+	if (ul == NULL) {
+		/* out of slots: let the caller spin */
+		lck_mtx_unlock(rpi3_ulock_mtx);
+		return (0);
+	}
+	ul->ul_waiters++;
+	if (uap->timeout != 0)
+		clock_interval_to_deadline(uap->timeout, NSEC_PER_USEC, &deadline);
+	wr = lck_mtx_sleep_deadline(rpi3_ulock_mtx, LCK_SLEEP_DEFAULT, (event_t)ul,
+	    THREAD_ABORTSAFE, deadline);
+	ul->ul_waiters--;
+	*retval = ul->ul_waiters;
+	lck_mtx_unlock(rpi3_ulock_mtx);
+
+	if (wr == THREAD_INTERRUPTED)
+		error = EINTR;
+	else if (wr == THREAD_TIMED_OUT)
+		error = ETIMEDOUT;
+	if (error)
+		*retval = 0;
+	return rpi3_ulock_ret(uap->operation, error, retval);
+}
+
+int
+ulock_wake(struct proc *p, struct ulock_wake_args *uap, int32_t *retval)
+{
+	struct rpi3_ulock *ul;
+	int error = 0;
+
+	*retval = 0;
+	lck_mtx_lock(rpi3_ulock_mtx);
+	ul = rpi3_ulock_find(p, uap->addr, 0);
+	if (ul == NULL)
+		error = ENOENT;
+	else if (uap->operation & ULF_WAKE_ALL)
+		thread_wakeup((event_t)ul);
+	else
+		thread_wakeup_one((event_t)ul);
+	lck_mtx_unlock(rpi3_ulock_mtx);
+	return rpi3_ulock_ret(uap->operation, error, retval);
+}
