--- a/xnu/bsd/kern/kern_descrip.c
+++ b/xnu/bsd/kern/kern_descrip.c
@@ -5862,3 +5862,19 @@ coalition_info(__unused proc_t p, struct coalition_info_args *uap, __unused int3
 		return (error);
 	return (copyout(&size, uap->bufsize, sizeof (size)));
 }
+
+/*
+ * iOS 10: personas.  No process here has one, which is what a kernel
+ * with personas reports for an ordinary process.
+ */
+int
+persona(__unused proc_t p, struct persona_args *uap, __unused int32_t *retval)
+{
+	switch (uap->operation) {
+	case 1:		/* PERSONA_OP_ALLOC */
+	case 2:		/* PERSONA_OP_DEALLOC */
+		return (EPERM);
+	default:	/* GET, INFO, PIDINFO, FIND */
+		return (ESRCH);
+	}
+}
diff --git a/xnu/bsd/kern/kern_event.c b/xnu/bsd/kern/kern_event.c
index b948087..23d729f 100644
--- a/xnu/bsd/kern/kern_event.c
+++ b/xnu/bsd/kern/kern_event.c
@@ -1685,9 +1685,9 @@ rpi3_kqwq_callback(__unused struct kqueue *kq, struct kevent64_s *kevp, void *da
 	int error;
 
 	if (rpi3_kq_trace > 0)
-		kprintf("rpi3: %s[%d] kq deliver filter %d ident 0x%llx flags 0x%x fflags 0x%x data 0x%llx ext 0x%llx 0x%llx\n",
+		kprintf("rpi3: %s[%d] kq deliver filter %d ident 0x%llx flags 0x%x fflags 0x%x data 0x%llx udata 0x%llx ext 0x%llx 0x%llx\n",
 		    current_proc()->p_comm, current_proc()->p_pid, kevp->filter, kevp->ident, kevp->flags,
-		    kevp->fflags, kevp->data, kevp->ext[0], kevp->ext[1]);
+		    kevp->fflags, kevp->data, kevp->udata, kevp->ext[0], kevp->ext[1]);
 	error = kevent_copyout(kevp, &scan->list, current_proc(), KEVENT_LAYOUT_QOS);
 	if (error == 0 && ++scan->out == scan->max)
 		error = EWOULDBLOCK;
@@ -1973,7 +1973,21 @@ kevent_register(struct kqueue *kq, struct kevent64_s *kev, __unused struct proc
 			knote_activate(kn, 1);
 		kqunlock(kq);
 	} else {
+		/*
+		 * A stay-queued knote (a Mach port) added or re-enabled while
+		 * its port already holds a message: no later post will wake a
+		 * thread that is already waiting on this kqueue (iOS 10's event
+		 * manager usually is), so wake it now.
+		 */
+		int wake = ((kn->kn_status & (KN_STAYQUEUED | KN_DISABLED)) == KN_STAYQUEUED &&
+		    kn->kn_fop->f_peek != NULL && kn->kn_fop->f_peek(kn));
+
 		knote_put(kn);
+		if (wake) {
+			kqlock(kq);
+			kqueue_wakeup(kq, 0);
+			kqunlock(kq);
+		}
 	}
 
 done:
