+/*
+ * getattrlistbulk (iOS 10): the requested attributes of every entry of a
+ * directory, packed one after another the way getattrlist(2) packs one
+ * (each entry starts with its length).  Built on getattrlist_internal and
+ * an extended readdir, whose per-entry seek offsets let a full buffer stop
+ * between entries.  Returns the number of entries; 0 at the end.
+ */
+int
+getattrlistbulk(proc_t p, struct getattrlistbulk_args *uap, int32_t *retval)
+{
+	vfs_context_t ctx = vfs_context_current();
+	struct fileproc *fp;
+	vnode_t dvp;
+	char *dirbuf = NULL;
+	const size_t dirbufsize = 8192;
+	user_addr_t out = uap->attributeBuffer;
+	uint32_t left = uap->bufferSize;
+	off_t offset;
+	int count = 0, eof = 0, error;
+
+	*retval = 0;
+	if ((error = fp_getfvp(p, uap->dirfd, &fp, &dvp)) != 0)
+		return (error);
+	if ((fp->f_fglob->fg_flag & FREAD) == 0) {
+		error = EBADF;
+		goto out_fp;
+	}
+	if ((error = vnode_getwithref(dvp)) != 0)
+		goto out_fp;
+	if (dvp->v_type != VDIR) {
+		error = ENOTDIR;
+		goto out_vp;
+	}
+	MALLOC(dirbuf, char *, dirbufsize, M_TEMP, M_WAITOK);
+	if (dirbuf == NULL) {
+		error = ENOMEM;
+		goto out_vp;
+	}
+	offset = fp->f_fglob->fg_offset;
+
+	while (!eof && left >= sizeof(uint32_t)) {
+		uio_t auio;
+		char uio_buf[UIO_SIZEOF(1)];
+		int numdirent = 0;
+		char *pos, *end;
+		int full = 0;
+
+		auio = uio_createwithbuffer(1, offset, UIO_SYSSPACE, UIO_READ, &uio_buf[0], sizeof(uio_buf));
+		uio_addiov(auio, CAST_USER_ADDR_T(dirbuf), dirbufsize);
+		error = VNOP_READDIR(dvp, auio, VNODE_READDIR_EXTENDED, &eof, &numdirent, ctx);
+		if (error)
+			break;
+		end = dirbuf + (dirbufsize - uio_resid(auio));
+		if (end == dirbuf)
+			break;
+
+		for (pos = dirbuf; pos < end; ) {
+			struct direntry *de = (struct direntry *)pos;
+			struct nameidata nd;
+			struct getattrlist_args ga;
+			uint32_t entrylen = 0;
+			off_t next = de->d_seekoff;
+
+			if (de->d_reclen == 0)
+				break;
+			pos += de->d_reclen;
+			if ((de->d_namlen == 1 && de->d_name[0] == '.') ||
+			    (de->d_namlen == 2 && de->d_name[0] == '.' && de->d_name[1] == '.') ||
+			    de->d_ino == 0) {
+				offset = next;
+				continue;
+			}
+
+			NDINIT(&nd, LOOKUP, OP_GETATTR, USEDVP | NOFOLLOW | AUDITVNPATH1,
+			    UIO_SYSSPACE, CAST_USER_ADDR_T(de->d_name), ctx);
+			nd.ni_dvp = dvp;
+			if (namei(&nd) != 0) {
+				/* vanished since the readdir: skip it */
+				offset = next;
+				continue;
+			}
+			nameidone(&nd);
+
+			ga.path = USER_ADDR_NULL;
+			ga.alist = uap->alist;
+			ga.attributeBuffer = out;
+			ga.bufferSize = left;
+			ga.options = uap->options_lo & ~FSOPT_NOFOLLOW;
+			error = getattrlist_internal(nd.ni_vp, &ga, p, ctx);
+			vnode_put(nd.ni_vp);
+			if (error == 0)
+				error = copyin(out, &entrylen, sizeof(entrylen));
+			if (error)
+				goto done;
+			entrylen = (entrylen + 3) & ~3U;
+			if (entrylen > left || entrylen == 0) {
+				/* no room: this entry goes in the next call */
+				full = 1;
+				break;
+			}
+			out += entrylen;
+			left -= entrylen;
+			count++;
+			offset = next;
+		}
+		if (full) {
+			if (count == 0)
+				error = ERANGE;	/* not even one entry fits */
+			break;
+		}
+	}
+done:
+	if (error == 0 || count > 0) {
+		error = 0;
+		fp->f_fglob->fg_offset = offset;
+		*retval = count;
+	}
+	FREE(dirbuf, M_TEMP);
+out_vp:
+	vnode_put(dvp);
+out_fp:
+	file_drop(uap->dirfd);
+	return (error);
+}
