diff --git a/xnu/osfmk/arm/hw_lock.s b/xnu/osfmk/arm/hw_lock.s
index 1ad87db..3dc0bd0 100644
--- a/xnu/osfmk/arm/hw_lock.s
+++ b/xnu/osfmk/arm/hw_lock.s
@@ -283,11 +283,18 @@ EnterARM(lck_rw_lock_shared_to_exclusive)
     ands        r2, r1, r3
     beq         rwlsepanic
     bic         r1, r1, r3
-    LOAD_ADDR(r12, lck_rw_lock_shared_gen)
+    /*
+     * Other readers, an interlock holder or a pending upgrade: the C
+     * slow path drops our read hold and waits (or reports failure).
+     * This used to go to lck_rw_lock_shared_gen, which took a second
+     * read hold and returned "upgraded": the caller then changed a
+     * vm_map it held only shared.
+     */
+    LOAD_ADDR(r12, lck_rw_lock_shared_to_exclusive_gen)
     subs        r2, r2, #0x10000
-    bxne        r12
+    bne         rwlseslow
     ands        r3, r1, #5
-    bxne        r12
+    bne         rwlseslow
     orr         r1, r1, #4
 #ifndef BOARD_CONFIG_OMAP3530
     strex       r2, r1, [r0]
@@ -298,6 +305,9 @@ EnterARM(lck_rw_lock_shared_to_exclusive)
 #endif
     mov         r0, #1
     bx          lr
+rwlseslow:
+    clrex
+    bx          r12
 rwlsepanic:
     mov         r1, r2
     mov         r1, r0
@@ -682,4 +692,5 @@ EnterARM(hw_unlock_bit)
 
 LOAD_ADDR_GEN_DEF(thread_wakeup)
 LOAD_ADDR_GEN_DEF(lck_rw_lock_shared_gen)
+LOAD_ADDR_GEN_DEF(lck_rw_lock_shared_to_exclusive_gen)
 LOAD_ADDR_GEN_DEF(lck_rw_lock_exclusive_gen)
