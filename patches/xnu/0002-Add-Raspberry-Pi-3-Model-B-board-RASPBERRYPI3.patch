+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3Input.cpp
@@ -0,0 +1,24 @@
+/*
+ * Raspberry Pi 3 input for the iOS 7 kernel.
+ *
+ * Placeholder until the USB mouse transport lands: no touch service is
+ * published, so iOS boots without input. The observation hook reports
+ * "unknown" as the HD2 driver does before its controller is ready.
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include "IOS7LeoTouchObservation.h"
+
+extern "C" uint32_t ios7leo_touch_observe(LeoTouchObservation *out)
+{
+    (void)out;
+    return 0;
+}
+
+void ios7leo_register_hid_touch(IOService *platform)
+{
+    (void)platform;
+    IOLog("Rpi3 input: no touch transport yet; booting without input\n");
+}
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3SD.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3SD.cpp
new file mode 100644
index 0000000..9ffe8b2
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3SD.cpp
@@ -0,0 +1,342 @@
+/*
+ * Raspberry Pi 3 SD card block device for the iOS 7 kernel.
+ *
+ * Port of IOS7LeoSDCC2.cpp (HTC HD2) to the Pi's SDHCI controller (rpi3_sd.c).
+ * Same contract: ordinary raw media is read-only (the root image is a file on
+ * the FAT partition with a RAM copy-on-write overlay above it), and the only
+ * writes are the owned boot log, through the ios7leo_sd_log_* interface.
+ *
+ * The class keeps the HD2 name IOS7LeoSDCC2: the root-file and boot-log
+ * drivers find their SD device with metaCast("IOS7LeoSDCC2").
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include <IOKit/storage/IOBlockStorageDevice.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOCatalogue.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/debug.h>
+#include "rpi3_sd.h"
+#include "rpi3_board.h"
+#include "IOS7LeoSDLog.h"
+#include "IOS7LabSDProtocol.h"
+#include "IOS7LabStoragePersonalities.h"
+extern "C" {
+#include <mach/mach_time.h>
+}
+
+class IOS7LeoSDCC2;
+struct ios7leo_sd_log_capability {
+    IOS7LeoSDCC2 *owner;
+    struct ios7leo_sd_log_extent extents[IOS7LEO_SD_LOG_MAX_EXTENTS];
+    uint32_t extent_count, next_sector, first_verified;
+    uint8_t nonce[16];
+};
+static ios7leo_sd_log_capability *boundLogCapability;
+
+class IOS7LeoSDCC2 : public IOBlockStorageDevice {
+    OSDeclareDefaultStructors(IOS7LeoSDCC2)
+    IOMemoryDescriptor *mmio[2]; IOMemoryMap *maps[2];
+    IOLock *mutex; struct rpi3_sd_card card; bool initialized;
+    static uint64_t nowNS(void *);
+    static IOReturn convert(int);
+public:
+    virtual bool init(OSDictionary *properties = 0);
+    virtual bool start(IOService *provider);
+    void failurePanic(const char *reason);
+    virtual void free();
+    virtual IOReturn doAsyncReadWrite(IOMemoryDescriptor *, UInt64, UInt64, IOStorageAttributes *, IOStorageCompletion *);
+    virtual IOReturn doEjectMedia() { return kIOReturnUnsupported; }
+    virtual IOReturn doFormatMedia(UInt64) { return kIOReturnUnsupported; }
+    virtual UInt32 doGetFormatCapacities(UInt64 *, UInt32) const { return 0; }
+    virtual IOReturn doLockUnlockMedia(bool) { return kIOReturnUnsupported; }
+    virtual IOReturn doSynchronizeCache() { return kIOReturnUnsupported; }
+    virtual char *getVendorString();
+    virtual char *getProductString();
+    virtual char *getRevisionString();
+    virtual char *getAdditionalDeviceInfoString();
+    virtual IOReturn reportBlockSize(UInt64 *);
+    virtual IOReturn reportMaxValidBlock(UInt64 *);
+    virtual IOReturn reportEjectability(bool *);
+    virtual IOReturn reportLockability(bool *);
+    virtual IOReturn reportRemovability(bool *);
+    virtual IOReturn reportMediaState(bool *, bool *);
+    virtual IOReturn reportPollRequirements(bool *, bool *);
+    virtual IOReturn reportWriteProtection(bool *);
+    int describeLog(struct ios7leo_sd_log_info *);
+    int bindLog(const struct ios7leo_sd_log_extent *, uint32_t, uint32_t, const uint8_t [16], ios7leo_sd_log_capability **);
+    int writeLog(ios7leo_sd_log_capability *, uint32_t, const uint8_t [512]);
+};
+OSDefineMetaClassAndStructors(IOS7LeoSDCC2, IOBlockStorageDevice)
+
+uint64_t IOS7LeoSDCC2::nowNS(void *) { return mach_absolute_time(); }
+
+IOReturn IOS7LeoSDCC2::convert(int result)
+{
+    if (result == LEO_SD_OK) return kIOReturnSuccess;
+    if (result == LEO_SD_TIMEOUT) return kIOReturnTimeout;
+    if (result == LEO_SD_ARGUMENT) return kIOReturnBadArgument;
+    if (result == LEO_SD_FAULTED) return kIOReturnNotReady;
+    return kIOReturnIOError;
+}
+
+bool IOS7LeoSDCC2::init(OSDictionary *properties)
+{
+    for (unsigned i = 0; i < 2; ++i) { mmio[i] = 0; maps[i] = 0; }
+    mutex = 0; initialized = false;
+    return IOBlockStorageDevice::init(properties);
+}
+
+bool IOS7LeoSDCC2::start(IOService *provider)
+{
+    if (!IOBlockStorageDevice::start(provider)) return false;
+    const UInt32 physical[2] = {RPI3_EMMC_PA, RPI3_GPIO_PA};
+    volatile uint32_t *regs[2];
+    mutex = IOLockAlloc();
+    if (!mutex) return false;
+    for (unsigned i = 0; i < 2; ++i) {
+        mmio[i] = IOMemoryDescriptor::withPhysicalAddress(physical[i], 4096, kIODirectionInOut);
+        if (!mmio[i]) return false;
+        maps[i] = mmio[i]->map(kIOMapInhibitCache);
+        if (!maps[i]) return false;
+        regs[i] = (volatile uint32_t *)maps[i]->getVirtualAddress();
+        if (!regs[i]) return false;
+    }
+    struct rpi3_sd_io io = {this, regs[0], regs[1], nowNS, rpi3_emmc_clock_hz(), 1000000U};
+    if (!io.base_clock_hz) {
+        IOLog("Rpi3 SD: firmware gave no EMMC clock\n");
+        return false;
+    }
+    rpi3_sd_init(&card, &io);
+
+    IOLog("Rpi3 SD: base clock %u Hz, init begin\n", (unsigned)io.base_clock_hz);
+    IOLockLock(mutex);
+    UInt8 sector[512];
+    int result = rpi3_sd_start(&card);
+    if (result == LEO_SD_OK) result = rpi3_sd_read_sector(&card, 0, sector);
+    IOLockUnlock(mutex);
+    if (result != LEO_SD_OK) {
+        IOLog("Rpi3 SD: error=%d stage=%u cmd=%u interrupt=%08x status=%08x\n",
+              result, card.stage, card.command, card.interrupt, card.status);
+        panic("Rpi3 SD init/read0 error=%d stage=%u cmd=%u interrupt=%08x status=%08x",
+              result, card.stage, card.command, card.interrupt, card.status);
+        return false;
+    }
+    IOLog("Rpi3 SD: CID=%08x:%08x:%08x:%08x sectors=%llu SDHC=%u clock=%u Hz width=%u MBRsig=%02x%02x\n",
+          card.cid[0], card.cid[1], card.cid[2], card.cid[3], (unsigned long long)card.sectors,
+          (unsigned)card.high_capacity, (unsigned)card.clock_hz, (unsigned)card.bus_width,
+          (unsigned)sector[510], (unsigned)sector[511]);
+    initialized = true;
+    return true;
+}
+
+void IOS7LeoSDCC2::failurePanic(const char *reason)
+{
+    panic("Rpi3 SD mandatory startup %s stage=%u cmd=%u interrupt=%08x status=%08x",
+          reason, card.stage, card.command, card.interrupt, card.status);
+}
+
+void IOS7LeoSDCC2::free()
+{
+    for (unsigned i = 0; i < 2; ++i) {
+        if (maps[i]) maps[i]->release();
+        if (mmio[i]) mmio[i]->release();
+    }
+    if (mutex) IOLockFree(mutex);
+    IOBlockStorageDevice::free();
+}
+
+IOReturn IOS7LeoSDCC2::doAsyncReadWrite(IOMemoryDescriptor *buffer, UInt64 block, UInt64 count,
+                                      IOStorageAttributes *attributes, IOStorageCompletion *completion)
+{
+    UInt64 bytes = 0;
+    if (!buffer || !completion || !completion->action || !initialized ||
+        !ios7lab_sd_request_range(card.sectors, block, count, buffer->getLength(), &bytes))
+        return kIOReturnBadArgument;
+    if (buffer->getDirection() != kIODirectionIn) return kIOReturnNotWritable;
+    if (attributes && (attributes->options || attributes->reserved0032 || attributes->reserved0064))
+        return kIOReturnUnsupported;
+    IOStorageCompletion saved = *completion;
+    UInt64 completed = 0;
+    IOReturn result = kIOReturnSuccess;
+    UInt8 data[512];
+    IOLockLock(mutex);
+    if (card.faulted) { IOLockUnlock(mutex); return kIOReturnNotReady; }
+    for (UInt64 i = 0; i < count; ++i) {
+        result = convert(rpi3_sd_read_sector(&card, block + i, data));
+        if (result != kIOReturnSuccess) break;
+        if (buffer->writeBytes((IOByteCount)completed, data, 512) != 512) { result = kIOReturnUnderrun; break; }
+        completed += 512;
+    }
+    IOLockUnlock(mutex);
+    IOStorage::complete(&saved, result, completed);
+    return kIOReturnSuccess;
+}
+
+char *IOS7LeoSDCC2::getVendorString() { static char t[] = "Raspberry Pi"; return t; }
+char *IOS7LeoSDCC2::getProductString() { static char t[] = "Pi 3 SDHCI SD"; return t; }
+char *IOS7LeoSDCC2::getRevisionString() { static char t[] = "PIO RO"; return t; }
+char *IOS7LeoSDCC2::getAdditionalDeviceInfoString() { static char t[] = "BCM2837 EMMC GPIO48-53"; return t; }
+IOReturn IOS7LeoSDCC2::reportBlockSize(UInt64 *v) { if (!v) return kIOReturnBadArgument; *v = 512; return kIOReturnSuccess; }
+IOReturn IOS7LeoSDCC2::reportMaxValidBlock(UInt64 *v) { if (!v || !initialized) return kIOReturnNotReady; *v = card.sectors - 1; return kIOReturnSuccess; }
+IOReturn IOS7LeoSDCC2::reportEjectability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7LeoSDCC2::reportLockability(bool *v) { if (!v) return kIOReturnBadArgument; *v = false; return kIOReturnSuccess; }
+IOReturn IOS7LeoSDCC2::reportRemovability(bool *v) { if (!v) return kIOReturnBadArgument; *v = true; return kIOReturnSuccess; }
+IOReturn IOS7LeoSDCC2::reportMediaState(bool *present, bool *changed)
+{
+    if (!present || !changed) return kIOReturnBadArgument;
+    IOLockLock(mutex);
+    *present = initialized && !card.faulted;
+    *changed = false;
+    IOLockUnlock(mutex);
+    return kIOReturnSuccess;
+}
+IOReturn IOS7LeoSDCC2::reportPollRequirements(bool *required, bool *expensive)
+{
+    if (!required || !expensive) return kIOReturnBadArgument;
+    *required = false; *expensive = false;
+    return kIOReturnSuccess;
+}
+IOReturn IOS7LeoSDCC2::reportWriteProtection(bool *v) { if (!v) return kIOReturnBadArgument; *v = true; return kIOReturnSuccess; }
+
+int IOS7LeoSDCC2::describeLog(struct ios7leo_sd_log_info *info)
+{
+    if (!info || !mutex) return LEO_SD_ARGUMENT;
+    IOLockLock(mutex);
+    info->card_sectors = card.sectors;
+    for (unsigned i = 0; i < 4; ++i) info->cid[i] = card.cid[i];
+    info->csd_write_protected = (uint32_t)card.csd_write_protected;
+    info->initialized = initialized;
+    info->faulted = (uint32_t)card.faulted;
+    info->stage = card.stage; info->command = card.command; info->status = card.status;
+    info->write_attempts = card.write_attempts; info->write_words = card.write_words;
+    info->write_completed = card.write_completed; info->write_result = card.write_result;
+    info->first_write_verified = 0; info->next_file_sector = 0;
+    if (boundLogCapability && boundLogCapability->owner == this) {
+        info->first_write_verified = boundLogCapability->first_verified;
+        info->next_file_sector = boundLogCapability->next_sector;
+    }
+    IOLockUnlock(mutex);
+    return LEO_SD_OK;
+}
+
+int IOS7LeoSDCC2::bindLog(const struct ios7leo_sd_log_extent *extents, uint32_t count,
+                        uint32_t first, const uint8_t nonce[16], ios7leo_sd_log_capability **out)
+{
+    if (!out) return LEO_SD_ARGUMENT;
+    *out = 0;
+    if (!mutex || !extents || !nonce || !count || count > IOS7LEO_SD_LOG_MAX_EXTENTS ||
+        !first || first > IOS7LEO_SD_LOG_FILE_SECTORS) return LEO_SD_ARGUMENT;
+    unsigned nonzero = 0;
+    for (unsigned i = 0; i < 16; ++i) nonzero |= nonce[i];
+    if (!nonzero) return LEO_SD_ARGUMENT;
+    ios7leo_sd_log_capability *cap = (ios7leo_sd_log_capability *)IOMalloc(sizeof(*cap));
+    if (!cap) return LEO_SD_NO_MEMORY;
+    bzero(cap, sizeof(*cap));
+    int result = LEO_SD_OK;
+    uint64_t cursor = 0;
+    IOLockLock(mutex);
+    if (!initialized || card.faulted) result = LEO_SD_FAULTED;
+    else if (card.csd_write_protected) result = LEO_SD_WRITE_PROTECTED;
+    else if (boundLogCapability) result = LEO_SD_ARGUMENT;
+    for (unsigned i = 0; result == LEO_SD_OK && i < count; ++i) {
+        const struct ios7leo_sd_log_extent *e = extents + i;
+        if (!e->sectors || e->file_sector != cursor || cursor > IOS7LEO_SD_LOG_FILE_SECTORS ||
+            e->sectors > IOS7LEO_SD_LOG_FILE_SECTORS - cursor ||
+            !e->card_sector || e->card_sector >= card.sectors || e->sectors > card.sectors - e->card_sector) {
+            result = LEO_SD_ARGUMENT; break;
+        }
+        for (unsigned j = 0; j < i; ++j) {
+            const struct ios7leo_sd_log_extent *p = extents + j;
+            if (e->card_sector < p->card_sector + p->sectors && p->card_sector < e->card_sector + e->sectors) {
+                result = LEO_SD_ARGUMENT; break;
+            }
+        }
+        cap->extents[i] = *e;
+        cursor += e->sectors;
+    }
+    if (result == LEO_SD_OK && cursor != IOS7LEO_SD_LOG_FILE_SECTORS) result = LEO_SD_ARGUMENT;
+    if (result == LEO_SD_OK) {
+        cap->owner = this; cap->extent_count = count; cap->next_sector = first;
+        for (unsigned i = 0; i < 16; ++i) cap->nonce[i] = nonce[i];
+        retain();
+        boundLogCapability = cap;
+        *out = cap;
+    }
+    IOLockUnlock(mutex);
+    if (result != LEO_SD_OK) IOFree(cap, sizeof(*cap));
+    return result;
+}
+
+int IOS7LeoSDCC2::writeLog(ios7leo_sd_log_capability *cap, uint32_t logical, const uint8_t bytes[512])
+{
+    if (!mutex || !cap || !bytes || !logical || logical >= IOS7LEO_SD_LOG_FILE_SECTORS || cap != boundLogCapability)
+        return LEO_SD_ARGUMENT;
+    uint64_t physical = 0;
+    int result = LEO_SD_ARGUMENT;
+    uint8_t verified[512];
+    IOLockLock(mutex);
+    if (cap != boundLogCapability || cap->owner != this || logical != cap->next_sector) {
+        IOLockUnlock(mutex); return LEO_SD_ARGUMENT;
+    }
+    if (!initialized || card.faulted) { IOLockUnlock(mutex); return LEO_SD_FAULTED; }
+    for (unsigned i = 0; i < cap->extent_count; ++i) {
+        const struct ios7leo_sd_log_extent *e = cap->extents + i;
+        if (logical >= e->file_sector && (uint64_t)logical - e->file_sector < e->sectors) {
+            physical = e->card_sector + ((uint64_t)logical - e->file_sector);
+            result = LEO_SD_OK; break;
+        }
+    }
+    if (result == LEO_SD_OK) result = rpi3_sd_write_sector(&card, physical, bytes);
+    if (result == LEO_SD_OK && !cap->first_verified) {
+        result = rpi3_sd_read_sector(&card, physical, verified);
+        if (result == LEO_SD_OK)
+            for (unsigned i = 0; i < 512; ++i)
+                if (verified[i] != bytes[i]) { result = LEO_SD_PROTOCOL; card.faulted = 1; break; }
+        if (result == LEO_SD_OK) cap->first_verified = 1;
+    }
+    card.write_result = result;
+    if (result == LEO_SD_OK) ++cap->next_sector;
+    IOLockUnlock(mutex);
+    return result;
+}
+
+extern "C" int ios7leo_sd_log_describe(void *service, struct ios7leo_sd_log_info *info)
+{
+    IOS7LeoSDCC2 *device = service ? OSDynamicCast(IOS7LeoSDCC2, (OSObject *)service) : 0;
+    return device ? device->describeLog(info) : LEO_SD_ARGUMENT;
+}
+
+extern "C" int ios7leo_sd_log_bind(void *service, const struct ios7leo_sd_log_extent *extents,
+                                   uint32_t count, uint32_t first, const uint8_t nonce[16],
+                                   ios7leo_sd_log_capability **out)
+{
+    if (out) *out = 0;
+    IOS7LeoSDCC2 *device = service ? OSDynamicCast(IOS7LeoSDCC2, (OSObject *)service) : 0;
+    return device ? device->bindLog(extents, count, first, nonce, out) : LEO_SD_ARGUMENT;
+}
+
+extern "C" int ios7leo_sd_log_write(ios7leo_sd_log_capability *cap, uint32_t logical, const uint8_t bytes[512])
+{
+    if (!cap || cap != boundLogCapability) return LEO_SD_ARGUMENT;
+    return cap->owner->writeLog(cap, logical, bytes);
+}
+
+void ios7leo_register_sd(IOService *platform)
+{
+    IOS7LeoSDCC2 *device = new IOS7LeoSDCC2;
+    if (!device) { panic("Rpi3 SD object allocation failed"); return; }
+    bool attached = false, success = false;
+    if (device->init()) attached = device->attach(platform);
+    if (attached && device->start(platform)) {
+        OSObject *decoded = OSUnserializeXML(ios7labStoragePersonalities);
+        OSArray *drivers = OSDynamicCast(OSArray, decoded);
+        if (drivers && gIOCatalogue->addDrivers(drivers, false)) { device->registerService(); success = true; }
+        else IOLog("Rpi3 SD: storage catalogue registration failed\n");
+        if (decoded) decoded->release();
+    }
+    if (!success) device->failurePanic("object init/attach/map/start/catalogue failed");
+    if (attached && !success) device->detach(platform);
+    device->release();
+}
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
new file mode 100644
index 0000000..2592224
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.c
@@ -0,0 +1,382 @@
+/*
+ * SD card protocol over the Raspberry Pi's Arasan SDHCI ("EMMC") controller.
+ *
+ * Register layout and bit names follow the SD Host Controller Simplified
+ * Specification v3 and the BCM2835 ARM Peripherals manual (section 5).
+ * Pi-specific rules honoured here:
+ *   - registers are accessed as 32-bit words only (the Arasan block drops
+ *     8/16-bit writes), so 8/16-bit SDHCI fields are composed by hand;
+ *   - the base clock is not in the capability registers; the boot shim asks
+ *     the firmware for it;
+ *   - after boot the firmware leaves the SD card on its own SDHOST block, so
+ *     GPIO 48-53 are switched to ALT3 to put the card on this controller.
+ * Single-block programmed I/O, no interrupts, no DMA - like the HD2 driver.
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include "rpi3_sd.h"
+
+/* SDHCI register offsets (32-bit words). */
+#define BLKSIZECNT  0x04
+#define ARG1        0x08
+#define CMDTM       0x0c
+#define RESP0       0x10
+#define RESP1       0x14
+#define RESP2       0x18
+#define RESP3       0x1c
+#define DATA        0x20
+#define STATUS      0x24
+#define CONTROL0    0x28
+#define CONTROL1    0x2c
+#define INTERRUPT   0x30
+#define IRPT_MASK   0x34
+#define IRPT_EN     0x38
+
+/* CMDTM: transfer mode (low half) and command (high half). */
+#define TM_BLKCNT_EN    (1U << 1)
+#define TM_DAT_READ     (1U << 4)
+#define CMD_RSP_NONE    (0U << 16)
+#define CMD_RSP_136     (1U << 16)
+#define CMD_RSP_48      (2U << 16)
+#define CMD_RSP_48_BUSY (3U << 16)
+#define CMD_CRCCHK      (1U << 19)
+#define CMD_IXCHK       (1U << 20)
+#define CMD_ISDATA      (1U << 21)
+#define CMD_INDEX(n)    ((uint32_t)(n) << 24)
+
+/* STATUS (present state). */
+#define ST_CMD_INHIBIT  (1U << 0)
+#define ST_DAT_INHIBIT  (1U << 1)
+
+/* INTERRUPT. */
+#define INT_CMD_DONE    (1U << 0)
+#define INT_DATA_DONE   (1U << 1)
+#define INT_WRITE_RDY   (1U << 4)
+#define INT_READ_RDY    (1U << 5)
+#define INT_ERROR_MASK  0xffff8000U
+
+/* CONTROL0: host control (7:0) and power control (15:8). */
+#define C0_DWIDTH4      (1U << 1)
+#define C0_POWER_33V    ((7U << 9) | (1U << 8))
+
+/* CONTROL1: clock control (15:0), timeout (19:16), resets (26:24). */
+#define C1_CLK_INTLEN   (1U << 0)
+#define C1_CLK_STABLE   (1U << 1)
+#define C1_CLK_EN       (1U << 2)
+#define C1_TOUNIT_MAX   (0xeU << 16)
+#define C1_SRST_HC      (1U << 24)
+#define C1_SRST_CMD     (1U << 25)
+#define C1_SRST_DATA    (1U << 26)
+
+/* GPIO function select / pulls (BCM2835 manual section 6). */
+#define GPFSEL4     0x10
+#define GPFSEL5     0x14
+#define GPPUD       0x94
+#define GPPUDCLK1   0x9c
+#define FSEL_ALT3   7U
+
+static uint32_t rd(struct rpi3_sd_card *c, unsigned off)
+{
+    uint32_t v;
+    __asm__ volatile("dsb sy" ::: "memory");
+    v = c->io.emmc[off / 4];
+    __asm__ volatile("dsb sy" ::: "memory");
+    return v;
+}
+
+static void wr(struct rpi3_sd_card *c, unsigned off, uint32_t v)
+{
+    __asm__ volatile("dsb sy" ::: "memory");
+    c->io.emmc[off / 4] = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint64_t now_us(struct rpi3_sd_card *c) { return c->io.now_ns(c->io.opaque) / 1000U; }
+
+static void delay_us(struct rpi3_sd_card *c, uint32_t us)
+{
+    uint64_t start = now_us(c);
+    while (now_us(c) - start < us) {}
+}
+
+/* Wait until (reg & mask) == want, or time out. */
+static int wait_reg(struct rpi3_sd_card *c, unsigned off, uint32_t mask, uint32_t want,
+                    uint32_t timeout_us)
+{
+    uint64_t start = now_us(c);
+    for (;;) {
+        if ((rd(c, off) & mask) == want) return LEO_SD_OK;
+        if (now_us(c) - start > timeout_us) return LEO_SD_TIMEOUT;
+    }
+}
+
+static void route_card_to_emmc(struct rpi3_sd_card *c)
+{
+    volatile uint32_t *g = c->io.gpio;
+    uint32_t v, pin;
+    /* GPIO48 (CLK), 49 (CMD), 50-53 (DAT0-3) -> ALT3 (Arasan). */
+    v = g[GPFSEL4 / 4];
+    for (pin = 48; pin <= 49; pin++) {
+        unsigned shift = (pin - 40) * 3;
+        v = (v & ~(7U << shift)) | (FSEL_ALT3 << shift);
+    }
+    g[GPFSEL4 / 4] = v;
+    v = g[GPFSEL5 / 4];
+    for (pin = 50; pin <= 53; pin++) {
+        unsigned shift = (pin - 50) * 3;
+        v = (v & ~(7U << shift)) | (FSEL_ALT3 << shift);
+    }
+    g[GPFSEL5 / 4] = v;
+    /* Pull-ups on CMD and DAT0-3 (GPIO 49-53), per the manual's sequence. */
+    g[GPPUD / 4] = 2;
+    delay_us(c, 5);
+    g[GPPUDCLK1 / 4] = 0x1fU << (49 - 32);
+    delay_us(c, 5);
+    g[GPPUD / 4] = 0;
+    g[GPPUDCLK1 / 4] = 0;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int set_clock(struct rpi3_sd_card *c, uint32_t hz)
+{
+    uint32_t base = c->io.base_clock_hz, div, v;
+    int r;
+    /* Gate the SD clock while the divider changes. */
+    wr(c, CONTROL1, rd(c, CONTROL1) & ~C1_CLK_EN);
+    /* SDHCI v3 10-bit divided mode: f = base / (2 * div), div = 0 means base. */
+    if (hz >= base) div = 0;
+    else {
+        div = (base + 2 * hz - 1) / (2 * hz);
+        if (div > 0x3ff) div = 0x3ff;
+    }
+    v = rd(c, CONTROL1) & ~0xffe0U & ~(0xfU << 16);
+    v |= ((div & 0xff) << 8) | (((div >> 8) & 3) << 6) | C1_TOUNIT_MAX | C1_CLK_INTLEN;
+    wr(c, CONTROL1, v);
+    r = wait_reg(c, CONTROL1, C1_CLK_STABLE, C1_CLK_STABLE, 100000);
+    if (r) return LEO_SD_CLOCK;
+    wr(c, CONTROL1, rd(c, CONTROL1) | C1_CLK_EN);
+    delay_us(c, 2000);
+    c->clock_hz = div ? base / (2 * div) : base;
+    return LEO_SD_OK;
+}
+
+static void reset_lines(struct rpi3_sd_card *c, uint32_t which)
+{
+    wr(c, CONTROL1, rd(c, CONTROL1) | which);
+    (void)wait_reg(c, CONTROL1, which, 0, 100000);
+}
+
+/* Issue a command and wait for completion; data phase handled by callers. */
+static int command(struct rpi3_sd_card *c, uint32_t index, uint32_t arg, uint32_t flags)
+{
+    uint32_t irq;
+    uint64_t start;
+    c->command = index;
+    if (wait_reg(c, STATUS, ST_CMD_INHIBIT, 0, c->io.timeout_us)) return LEO_SD_TIMEOUT;
+    if ((flags & (CMD_ISDATA | CMD_RSP_48_BUSY)) &&
+        wait_reg(c, STATUS, ST_DAT_INHIBIT, 0, c->io.timeout_us)) return LEO_SD_TIMEOUT;
+    wr(c, INTERRUPT, 0xffffffffU);
+    wr(c, ARG1, arg);
+    wr(c, CMDTM, CMD_INDEX(index) | flags);
+    start = now_us(c);
+    for (;;) {
+        irq = rd(c, INTERRUPT);
+        if (irq & INT_ERROR_MASK) {
+            c->interrupt = irq;
+            c->status = rd(c, STATUS);
+            wr(c, INTERRUPT, irq);
+            reset_lines(c, C1_SRST_CMD | C1_SRST_DATA);
+            return (irq & (1U << 16)) ? LEO_SD_TIMEOUT : LEO_SD_COMMAND;
+        }
+        if (irq & INT_CMD_DONE) break;
+        if (now_us(c) - start > c->io.timeout_us) { c->interrupt = irq; return LEO_SD_TIMEOUT; }
+    }
+    wr(c, INTERRUPT, INT_CMD_DONE);
+    return LEO_SD_OK;
+}
+
+/* R1b and data commands also finish with DATA_DONE. */
+static int wait_data_done(struct rpi3_sd_card *c)
+{
+    uint64_t start = now_us(c);
+    for (;;) {
+        uint32_t irq = rd(c, INTERRUPT);
+        if (irq & INT_ERROR_MASK) {
+            c->interrupt = irq;
+            wr(c, INTERRUPT, irq);
+            reset_lines(c, C1_SRST_CMD | C1_SRST_DATA);
+            return LEO_SD_DATA;
+        }
+        if (irq & INT_DATA_DONE) { wr(c, INTERRUPT, INT_DATA_DONE); return LEO_SD_OK; }
+        if (now_us(c) - start > c->io.timeout_us) { c->interrupt = irq; return LEO_SD_TIMEOUT; }
+    }
+}
+
+static int app_command(struct rpi3_sd_card *c, uint32_t index, uint32_t arg, uint32_t flags)
+{
+    int r = command(c, 55, c->rca << 16, CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK);
+    if (r) return r;
+    return command(c, index, arg, flags);
+}
+
+/* R2 (CID/CSD): the controller drops the CRC byte and right-aligns bits
+ * 127:8 in RESP3..RESP0. Rebuild the 128-bit register, MSW first. */
+static void read_r2(struct rpi3_sd_card *c, uint32_t out[4])
+{
+    uint32_t r0 = rd(c, RESP0), r1 = rd(c, RESP1), r2 = rd(c, RESP2), r3 = rd(c, RESP3);
+    out[0] = (r3 << 8) | (r2 >> 24);
+    out[1] = (r2 << 8) | (r1 >> 24);
+    out[2] = (r1 << 8) | (r0 >> 24);
+    out[3] = r0 << 8;
+}
+
+void rpi3_sd_init(struct rpi3_sd_card *c, const struct rpi3_sd_io *io)
+{
+    unsigned i;
+    unsigned char *p = (unsigned char *)c;
+    for (i = 0; i < sizeof(*c); i++) p[i] = 0;
+    c->io = *io;
+}
+
+#include "IOS7LabSDProtocol.h"
+
+int rpi3_sd_start(struct rpi3_sd_card *c)
+{
+    int r, tries;
+    uint32_t resp;
+
+    c->stage = 1;
+    route_card_to_emmc(c);
+
+    c->stage = 2;
+    wr(c, CONTROL1, C1_SRST_HC);
+    if (wait_reg(c, CONTROL1, C1_SRST_HC | C1_SRST_CMD | C1_SRST_DATA, 0, 100000))
+        return LEO_SD_TIMEOUT;
+    wr(c, CONTROL0, C0_POWER_33V);
+    delay_us(c, 2000);
+
+    c->stage = 3;
+    if ((r = set_clock(c, 400000))) return r;
+    wr(c, IRPT_EN, 0);                  /* no interrupt signalling: polled */
+    wr(c, IRPT_MASK, 0xffffffffU);      /* but latch every status bit */
+    wr(c, INTERRUPT, 0xffffffffU);
+
+    c->stage = 4;                       /* CMD0: GO_IDLE_STATE */
+    if ((r = command(c, 0, 0, CMD_RSP_NONE))) return r;
+    delay_us(c, 1000);
+
+    c->stage = 5;                       /* CMD8: SEND_IF_COND, 2.7-3.6V, pattern AA */
+    r = command(c, 8, 0x1aa, CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK);
+    if (r == LEO_SD_OK && (rd(c, RESP0) & 0xfff) != 0x1aa) return LEO_SD_PROTOCOL;
+    {
+        int v2 = (r == LEO_SD_OK);
+        uint32_t hcs = v2 ? (1U << 30) : 0;
+        c->stage = 6;                   /* ACMD41 until the card leaves busy */
+        for (tries = 0; tries < 1000; tries++) {
+            /* R3 has no CRC or index. */
+            if ((r = app_command(c, 41, hcs | 0x00ff8000U, CMD_RSP_48))) return r;
+            resp = rd(c, RESP0);
+            if (resp & (1U << 31)) break;
+            delay_us(c, 1000);
+        }
+        if (!(resp & (1U << 31))) return LEO_SD_TIMEOUT;
+        c->ocr = resp;
+        c->high_capacity = v2 && (resp & (1U << 30));
+    }
+
+    c->stage = 7;                       /* CMD2: ALL_SEND_CID */
+    if ((r = command(c, 2, 0, CMD_RSP_136 | CMD_CRCCHK))) return r;
+    read_r2(c, c->cid);
+
+    c->stage = 8;                       /* CMD3: SEND_RELATIVE_ADDR */
+    if ((r = command(c, 3, 0, CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK))) return r;
+    c->rca = rd(c, RESP0) >> 16;
+
+    c->stage = 9;                       /* CMD9: SEND_CSD */
+    if ((r = command(c, 9, c->rca << 16, CMD_RSP_136 | CMD_CRCCHK))) return r;
+    read_r2(c, c->csd);
+    if (!ios7lab_sd_capacity(c->csd, c->high_capacity, &c->sectors, &c->csd_write_protected))
+        return LEO_SD_PROTOCOL;
+
+    c->stage = 10;                      /* CMD7: SELECT_CARD (R1b) */
+    if ((r = command(c, 7, c->rca << 16, CMD_RSP_48_BUSY | CMD_CRCCHK | CMD_IXCHK))) return r;
+    if ((r = wait_data_done(c)) && r != LEO_SD_TIMEOUT) return r;
+
+    c->stage = 11;                      /* CMD16: 512-byte blocks (SDSC) */
+    if (!c->high_capacity &&
+        (r = command(c, 16, 512, CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK))) return r;
+
+    c->stage = 12;                      /* ACMD6: 4-bit bus */
+    if ((r = app_command(c, 6, 2, CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK))) return r;
+    wr(c, CONTROL0, rd(c, CONTROL0) | C0_DWIDTH4);
+    c->bus_width = 4;
+
+    c->stage = 13;                      /* default-speed transfer clock */
+    if ((r = set_clock(c, 25000000))) return r;
+    c->stage = 14;
+    return LEO_SD_OK;
+}
+
+static uint32_t card_address(struct rpi3_sd_card *c, uint64_t sector)
+{
+    return c->high_capacity ? (uint32_t)sector : (uint32_t)(sector * 512U);
+}
+
+int rpi3_sd_read_sector(struct rpi3_sd_card *c, uint64_t sector, uint8_t data[512])
+{
+    int r;
+    unsigned i;
+    if (c->faulted) return LEO_SD_FAULTED;
+    if (sector >= c->sectors) return LEO_SD_ARGUMENT;
+    wr(c, BLKSIZECNT, (1U << 16) | 512U);
+    r = command(c, 17, card_address(c, sector),
+                CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK | CMD_ISDATA | TM_DAT_READ | TM_BLKCNT_EN);
+    if (r) return r;
+    {
+        uint64_t start = now_us(c);
+        for (;;) {
+            uint32_t irq = rd(c, INTERRUPT);
+            if (irq & INT_ERROR_MASK) { c->interrupt = irq; wr(c, INTERRUPT, irq);
+                                        reset_lines(c, C1_SRST_CMD | C1_SRST_DATA); return LEO_SD_DATA; }
+            if (irq & INT_READ_RDY) { wr(c, INTERRUPT, INT_READ_RDY); break; }
+            if (now_us(c) - start > c->io.timeout_us) return LEO_SD_TIMEOUT;
+        }
+    }
+    for (i = 0; i < 512; i += 4) {
+        uint32_t w = rd(c, DATA);
+        data[i] = (uint8_t)w; data[i + 1] = (uint8_t)(w >> 8);
+        data[i + 2] = (uint8_t)(w >> 16); data[i + 3] = (uint8_t)(w >> 24);
+    }
+    return wait_data_done(c);
+}
+
+int rpi3_sd_write_sector(struct rpi3_sd_card *c, uint64_t sector, const uint8_t data[512])
+{
+    int r;
+    unsigned i;
+    c->write_attempts++;
+    if (c->faulted) return LEO_SD_FAULTED;
+    if (sector >= c->sectors) return LEO_SD_ARGUMENT;
+    wr(c, BLKSIZECNT, (1U << 16) | 512U);
+    r = command(c, 24, card_address(c, sector),
+                CMD_RSP_48 | CMD_CRCCHK | CMD_IXCHK | CMD_ISDATA | TM_BLKCNT_EN);
+    if (r) return r;
+    {
+        uint64_t start = now_us(c);
+        for (;;) {
+            uint32_t irq = rd(c, INTERRUPT);
+            if (irq & INT_ERROR_MASK) { c->interrupt = irq; wr(c, INTERRUPT, irq);
+                                        reset_lines(c, C1_SRST_CMD | C1_SRST_DATA); return LEO_SD_DATA; }
+            if (irq & INT_WRITE_RDY) { wr(c, INTERRUPT, INT_WRITE_RDY); break; }
+            if (now_us(c) - start > c->io.timeout_us) return LEO_SD_TIMEOUT;
+        }
+    }
+    for (i = 0; i < 512; i += 4) {
+        wr(c, DATA, (uint32_t)data[i] | ((uint32_t)data[i + 1] << 8) |
+                    ((uint32_t)data[i + 2] << 16) | ((uint32_t)data[i + 3] << 24));
+        c->write_words++;
+    }
+    r = wait_data_done(c);
+    if (r == LEO_SD_OK) c->write_completed++;
+    return r;
+}
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.h b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.h
new file mode 100644
index 0000000..0281682
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_sd.h
@@ -0,0 +1,46 @@
+/*
+ * SD card over the Raspberry Pi's Arasan SDHCI controller ("EMMC", at
+ * 0x3f300000), programmed I/O only. Mirrors leo_sdcc.h for the HD2: the
+ * caller supplies register access and timing, results use the LEO_SD_* codes.
+ */
+#ifndef RPI3_SD_H
+#define RPI3_SD_H
+#include <stdint.h>
+#include "leo_sdcc.h"   /* enum leo_sd_result */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RPI3_EMMC_PA    0x3f300000U
+#define RPI3_GPIO_PA    0x3f200000U
+
+struct rpi3_sd_io {
+    void *opaque;
+    volatile uint32_t *emmc;            /* mapped controller registers */
+    volatile uint32_t *gpio;            /* mapped GPIO block */
+    uint64_t (*now_ns)(void *);
+    uint32_t base_clock_hz;             /* EMMC clock from the firmware */
+    uint32_t timeout_us;
+};
+
+struct rpi3_sd_card {
+    struct rpi3_sd_io io;
+    uint32_t rca, ocr, cid[4], csd[4];  /* cid/csd: MSW first */
+    uint64_t sectors;
+    int high_capacity, csd_write_protected, faulted;
+    uint32_t clock_hz, bus_width;
+    /* Last failure, for logs and panics. */
+    uint32_t stage, command, status, interrupt;
+    uint32_t write_attempts, write_words, write_completed;
+    int32_t write_result;
+};
+
+void rpi3_sd_init(struct rpi3_sd_card *, const struct rpi3_sd_io *);
+int rpi3_sd_start(struct rpi3_sd_card *);
+int rpi3_sd_read_sector(struct rpi3_sd_card *, uint64_t sector, uint8_t data[512]);
+int rpi3_sd_write_sector(struct rpi3_sd_card *, uint64_t sector, const uint8_t data[512]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
