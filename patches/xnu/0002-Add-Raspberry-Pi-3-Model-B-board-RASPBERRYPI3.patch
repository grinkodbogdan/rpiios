+/*
+ * Raspberry Pi 3 Model B+ platform expert for the iOS 7 kernel.
+ *
+ * Drop-in for the HTC HD2's pe_qsd8250_leo.c: same exported functions, same
+ * 480x800 RGB565 screen contract, same staged boot/fatal reporting. What
+ * differs is the hardware behind it:
+ *   - the framebuffer is allocated by the VideoCore firmware (via the boot
+ *     shim) and scanned out continuously, so there is no display controller
+ *     to kick or acknowledge; a write to the framebuffer is on screen;
+ *   - interrupts and the timebase come from rpi3_timer.c;
+ *   - console text also goes to the PL011 UART when "rpi3_uart=1" is given.
+ * The GPU scales the 480x800 framebuffer up to the HDMI mode.
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include <mach/mach_types.h>
+#include <mach/host_info.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <pexpert/arm/boot.h>
+#include <pexpert/arm/protos.h>
+#include <pexpert/arm/leo_entry.h>
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include <kern/clock.h>
+#include <mach/vm_param.h>
+#include "rpi3_board.h"
+#include "rpi3_timer.h"
+#include "IOS7LeoDisplayBackend.h"
+#include "leo_scanout.h"
+#include "IOS7LeoDisplayObservation.h"
+#include "IOS7LeoMDPFault.h"
+#include "IOS7LeoMemoryObservation.h"
+
+extern int switch_to_serial_console(void);
+extern host_t host_self(void);
+extern kern_return_t host_statistics64(host_t host, host_flavor_t flavor,
+                                       host_info64_t info,
+                                       mach_msg_type_number_t *count);
+extern uint64_t sane_size;
+extern unsigned int vm_page_free_count, vm_page_free_reserved, vm_page_free_target;
+
+typedef char rpi3_handoff_size[(sizeof(rpi3_handoff) == 128) ? 1 : -1];
+
+static volatile unsigned short *rpi_pixels;   /* 480x800 RGB565 */
+static unsigned int rpi_fb_physical;
+static volatile unsigned int *rpi_uart;       /* PL011, NULL when disabled */
+static unsigned int rpi_uart_wanted;
+
+static unsigned int rpi_stage;
+static volatile unsigned int rpi_final_reason;
+static volatile unsigned int rpi_console_count;
+static volatile char rpi_console[1024];
+static volatile unsigned int rpi_fatal_active;
+static unsigned int rpi_fatal_category;
+static volatile unsigned int rpi_fatal_state[8];
+static volatile unsigned int rpi_graphics_owner;
+static uint64_t rpi_graphics_sequence;
+static volatile LeoMemoryObservation rpi_memory_state;
+static volatile unsigned int rpi_memory_sequence;
+
+/* Presentation counters, reported through the same observation structs the
+ * HD2 logger reads. */
+static volatile uint32_t obs_attempts, obs_rows, obs_last_rows, obs_completed;
+static volatile uint32_t obs_failures, obs_failure_phase;
+static int obs_failed(uint32_t phase)
+{ ++obs_failures; obs_failure_phase = phase; return 0; }
+
+static void sync_writes(void) { __asm__ volatile("dsb sy" ::: "memory"); }
+
+/* ---- UART ------------------------------------------------------------- */
+
+static void rpi_uart_putc(char c)
+{
+    volatile unsigned int *u = rpi_uart;
+    unsigned int spins;
+    if (!u) return;
+    if (c == '\n') rpi_uart_putc('\r');
+    for (spins = 0; spins < 100000U; spins++)
+        if (!(u[RPI3_UART_FR / 4] & RPI3_UART_FR_TXFF)) break;
+    u[RPI3_UART_DR / 4] = (unsigned char)c;
+}
+
+/* ---- Text and digits, as on the HD2 (2x scaled 4x7 / 5x7 glyphs) ------ */
+
+static const unsigned char rpi_hex[16][7] = {
+ {6,9,9,9,9,9,6},{2,6,2,2,2,2,7},{6,9,1,2,4,8,15},{14,1,1,6,1,1,14},
+ {2,6,10,10,15,2,2},{15,8,8,14,1,1,14},{6,8,8,14,9,9,6},{15,1,2,2,4,4,4},
+ {6,9,9,6,9,9,6},{6,9,9,7,1,1,6},{6,9,9,15,9,9,9},{14,9,9,14,9,9,14},
+ {7,8,8,8,8,8,7},{14,9,9,9,9,9,14},{15,8,8,14,8,8,15},{15,8,8,14,8,8,8}
+};
+static const unsigned char rpi_alpha[26][7] = {
+ {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},{15,16,16,16,16,16,15},
+ {30,17,17,17,17,17,30},{31,16,16,30,16,16,31},{31,16,16,30,16,16,16},
+ {15,16,16,19,17,17,15},{17,17,17,31,17,17,17},{14,4,4,4,4,4,14},
+ {1,1,1,1,17,17,14},{17,18,20,24,20,18,17},{16,16,16,16,16,16,31},
+ {17,27,21,21,17,17,17},{17,25,21,19,17,17,17},{14,17,17,17,17,17,14},
+ {30,17,17,30,16,16,16},{14,17,17,17,21,18,13},{30,17,17,30,20,18,17},
+ {15,16,16,14,1,1,30},{31,4,4,4,4,4,4},{17,17,17,17,17,17,14},
+ {17,17,17,17,17,10,4},{17,17,17,21,21,27,17},{17,17,10,4,10,17,17},
+ {17,17,10,4,4,4,4},{31,1,2,4,8,16,31}
+};
+
+static void plot2x(unsigned int x, unsigned int y, unsigned short color)
+{
+    if (x + 1 >= RPI3_FB_WIDTH || y + 1 >= RPI3_FB_HEIGHT) return;
+    rpi_pixels[y * RPI3_FB_WIDTH + x] = color;
+    rpi_pixels[y * RPI3_FB_WIDTH + x + 1] = color;
+    rpi_pixels[(y + 1) * RPI3_FB_WIDTH + x] = color;
+    rpi_pixels[(y + 1) * RPI3_FB_WIDTH + x + 1] = color;
+}
+
+static void draw_digit(unsigned int digit, unsigned int x, unsigned int y,
+                       unsigned short color)
+{
+    unsigned int row, bit;
+    for (row = 0; row < 7; row++)
+        for (bit = 0; bit < 4; bit++)
+            if (rpi_hex[digit & 15][row] & (8U >> bit))
+                plot2x(x + bit * 2, y + row * 2, color);
+}
+
+static void draw_number(unsigned int value, unsigned int digits, unsigned int y,
+                        unsigned short color)
+{
+    unsigned int i;
+    for (i = 0; i < digits; i++)
+        draw_digit((value >> ((digits - i - 1) * 4)) & 15, 8 + i * 10, y, color);
+}
+
+static void draw_text(const char *s, unsigned int limit, unsigned int x,
+                      unsigned int y)
+{
+    static const unsigned char dot[7] = {0,0,0,0,0,12,12};
+    static const unsigned char colon[7] = {0,12,12,0,12,12,0};
+    static const unsigned char dash[7] = {0,0,0,31,0,0,0};
+    static const unsigned char slash[7] = {1,2,2,4,8,8,16};
+    static const unsigned char under[7] = {0,0,0,0,0,0,31};
+    static const unsigned char left[7] = {2,4,8,8,8,4,2};
+    static const unsigned char right[7] = {8,4,2,2,2,4,8};
+    static const unsigned char question[7] = {14,17,1,2,4,0,4};
+    unsigned int n, row, bit;
+    for (n = 0; n < limit; n++) {
+        unsigned char c = (unsigned char)s[n];
+        const unsigned char *glyph;
+        if (!c) break;
+        if (c >= 'a' && c <= 'z') c = (unsigned char)(c - 'a' + 'A');
+        if (c == ' ') continue;
+        if (c >= '0' && c <= '9') { draw_digit(c - '0', x + n * 12, y, 0xffff); continue; }
+        glyph = (c >= 'A' && c <= 'Z') ? rpi_alpha[c - 'A'] :
+                c == '.' ? dot : c == ':' ? colon : c == '-' ? dash : c == '/' ? slash :
+                c == '_' ? under : c == '(' ? left : c == ')' ? right : question;
+        for (row = 0; row < 7; row++)
+            for (bit = 0; bit < 5; bit++)
+                if (glyph[row] & (16U >> bit))
+                    plot2x(x + n * 12 + bit * 2, y + row * 2, 0xffff);
+    }
+}
+
+static void render_stage(unsigned int address, unsigned int stage)
+{
+    unsigned int x, y;
+    if (!rpi_pixels) return;
+    for (y = 8; y < 48; y++)
+        for (x = 8; x < 88; x++)
+            rpi_pixels[y * RPI3_FB_WIDTH + x] = 0;
+    draw_number(address, 8, 8, 0x07ff);
+    draw_number(stage, 4, 28, 0xffff);
+    sync_writes();
+}
+
+static unsigned int callsite(void *returned)
+{ return (((unsigned int)returned) & ~1U) - 4U; }
+
+/* ---- Fatal reporting (same layout as the HD2's red screen) ------------ */
+
+int ios7leo_fatal_report(unsigned int category, unsigned int site,
+                         unsigned int pc, unsigned int lr, unsigned int far,
+                         unsigned int fsr, unsigned int valid_mask,
+                         const char *message)
+{
+    unsigned int x, y, n, hash = 2166136261U;
+    const char *labels[4] = {"PC", "LR", "FAR", "FSR"};
+    unsigned int values[4] = {pc, lr, far, fsr};
+    if (rpi_fatal_active) return 0;
+    rpi_fatal_active = 1;
+    if (gPESocDispatch.uart_putc == ios7leo_debug_putc)
+        (void)switch_to_serial_console();
+    rpi_fatal_category = category;
+    rpi_fatal_state[0] = category; rpi_fatal_state[1] = rpi_stage;
+    rpi_fatal_state[2] = valid_mask & 15U; rpi_fatal_state[3] = pc;
+    rpi_fatal_state[4] = lr; rpi_fatal_state[5] = far; rpi_fatal_state[6] = fsr;
+    if (!rpi_pixels) return 1;
+    for (y = 0; y < RPI3_FB_HEIGHT; y++)
+        for (x = 0; x < RPI3_FB_WIDTH; x++)
+            rpi_pixels[y * RPI3_FB_WIDTH + x] = 0xf800;
+    render_stage(site, category);
+    draw_text("RETURN", 6, 120, 8);
+    draw_text("XNU FATAL", 9, 8, 60);
+    draw_number(rpi_stage, 8, 90, 0xffff);
+    draw_text("STAGE", 5, 120, 90);
+    draw_number(valid_mask & 15U, 8, 120, 0xffff);
+    draw_text("VALID MASK", 10, 120, 120);
+    for (n = 0; n < 4; n++) {
+        draw_number((valid_mask & (1U << n)) ? values[n] : 0xffffffffU, 8, 150 + n * 30, 0xffff);
+        draw_text(labels[n], 3, 120, 150 + n * 30);
+    }
+    if (message) {
+        for (n = 0; n < 64 && message[n]; n++)
+            hash = (hash ^ (unsigned char)message[n]) * 16777619U;
+        draw_text("FORMAT", 6, 120, 290);
+        draw_number(hash, 8, 290, 0xffff);
+        rpi_fatal_state[7] = hash;
+        draw_text(message, 38, 8, 320);
+    }
+    sync_writes();
+    return 1;
+}
+
+static volatile unsigned int panic_text_mode, panic_text_len, panic_text_truncated;
+static char panic_text[384];
+static unsigned int panic_reason, panic_reason_known;
+
+int ios7leo_panic_text_begin(unsigned int reason, unsigned int reason_known,
+                             unsigned int primary)
+{
+    if (!primary || !rpi_fatal_active || panic_text_mode ||
+        (rpi_fatal_category != 0xf101U && rpi_fatal_category != 0xf103U))
+        return 0;
+    panic_text_mode = 1;
+    panic_reason = reason;
+    panic_reason_known = reason_known;
+    return 1;
+}
+
+void ios7leo_panic_text_putc(char c)
+{
+    extern void ios7leo_log_putc(char);
+    if (panic_text_mode != 1) return;
+    ios7leo_log_putc(c);
+    rpi_uart_putc(c);
+    if (panic_text_len < sizeof(panic_text)) panic_text[panic_text_len++] = c;
+    else panic_text_truncated = 1;
+}
+
+void ios7leo_panic_text_end(void)
+{
+    unsigned int x, y, line, n, at = 0;
+    char part[39];
+    if (panic_text_mode != 1) return;
+    panic_text_mode = 2;
+    if (!rpi_pixels) return;
+    for (y = 280; y < 620; y++)
+        for (x = 0; x < RPI3_FB_WIDTH; x++)
+            rpi_pixels[y * RPI3_FB_WIDTH + x] = 0xf800;
+    draw_text("FORMATTED PANIC", 15, 8, 280);
+    draw_number(panic_reason_known ? panic_reason : 0xffffffffU, 8, 310, 0xffff);
+    draw_text("CONTEXT REASON", 14, 120, 310);
+    for (line = 0; line < 12 && at < panic_text_len; line++) {
+        for (n = 0; n < 38 && at < panic_text_len && panic_text[at] != '\n'; at++) {
+            char c = panic_text[at];
+            if (c != '\r') part[n++] = c;
+        }
+        part[n] = 0;
+        draw_text(part, n, 8, 340 + line * 20);
+        if (at < panic_text_len && panic_text[at] == '\n') at++;
+    }
+    if (at < panic_text_len || panic_text_truncated)
+        draw_text("TEXT TRUNCATED", 14, 8, 600);
+    sync_writes();
+}
+
+/* ---- Boot progress ---------------------------------------------------- */
+
+void ios7leo_kernel_continuing(void) {}
+
+void ios7leo_timer_observe(unsigned int ticks, unsigned int irq_count)
+{
+    (void)ticks; (void)irq_count; /* scanout is continuous; nothing to refresh */
+}
+
+void __attribute__((noreturn)) ios7leo_final_boundary(unsigned int reason)
+{
+    rpi_final_reason = reason;
+    if (reason)
+        ios7leo_fatal_report(0xf000U | (reason & 0xfffU),
+                             callsite(__builtin_return_address(0)),
+                             0, 0, 0, 0, 0, "ENTRY GUARD");
+    __asm__ volatile("cpsid if" ::: "memory");
+    for (;;) __asm__ volatile("dsb sy\n\twfi" ::: "memory");
+}
+
+/* ---- Memory observation ----------------------------------------------- */
+
+void ios7leo_memory_observe(LeoMemoryObservation *out)
+{
+    boolean_t enabled;
+    vm_statistics64_data_t stat;
+    mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+    if (!out || out->version != IOS7_LEO_MEMORY_OBS_VERSION) return;
+    *out = *(const LeoMemoryObservation *)&rpi_memory_state;
+    enabled = ml_set_interrupts_enabled(FALSE);
+    out->managed_bytes = sane_size;
+    out->free_pages = vm_page_free_count;
+    out->free_reserved = vm_page_free_reserved;
+    out->free_target = vm_page_free_target;
+    if (host_statistics64(host_self(), HOST_VM_INFO64, (host_info64_t)&stat, &count) == KERN_SUCCESS &&
+        count >= HOST_VM_INFO64_COUNT) {
+        out->pageins = stat.pageins;
+        out->pageouts = stat.pageouts;
+        out->faults = stat.faults;
+        out->known |= LEO_MEMORY_KNOWN_VM_COUNTERS;
+    }
+    ml_set_interrupts_enabled(enabled);
+}
+
+/* ---- Display ---------------------------------------------------------- */
+
+static int video_ok(const boot_args *args)
+{
+    unsigned long long ramend = (unsigned long long)args->physBase + args->memSize;
+    unsigned long long fbend = (unsigned long long)args->Video.v_baseAddr + RPI3_FB_BYTES;
+    return args->Revision == 1 && args->Version == 2 && args->virtBase == 0x80000000U &&
+        args->memSize && !(args->physBase & 0xfffffU) && !(args->memSize & 0xfffffU) &&
+        args->memSize <= 0x40000000U && ramend <= RPI3_PERIPHERAL_BASE &&
+        args->topOfKernelData >= args->physBase && !(args->topOfKernelData & 0x3fffU) &&
+        args->machineType == RPI3_MACHINE_TYPE &&
+        args->Video.v_width == RPI3_FB_WIDTH && args->Video.v_height == RPI3_FB_HEIGHT &&
+        args->Video.v_rowBytes == RPI3_FB_ROW_BYTES && args->Video.v_depth == 16 &&
+        !(args->Video.v_baseAddr & 3U) &&
+        /* The framebuffer is VideoCore memory: above ARM RAM, below MMIO. */
+        args->Video.v_baseAddr >= ramend && fbend <= RPI3_PERIPHERAL_BASE;
+}
+
+int ios7leo_display_ready(void)
+{
+    return rpi_pixels && !rpi_fatal_active &&
+        PE_state.video.v_width == RPI3_FB_WIDTH && PE_state.video.v_height == RPI3_FB_HEIGHT &&
+        PE_state.video.v_rowBytes == RPI3_FB_ROW_BYTES && PE_state.video.v_depth == 16;
+}
+
+int ios7leo_display_completed(uint64_t sequence)
+{
+    return sequence && sequence <= rpi_graphics_sequence && !rpi_fatal_active;
+}
+
+void ios7leo_mdp_observe(LeoMDPFaultObservation *out)
+{
+    if (!out || out->version != IOS7_LEO_MDP_OBS_VERSION) return;
+    bzero(out, sizeof(*out));
+    out->version = IOS7_LEO_MDP_OBS_VERSION;
+    out->known = LEO_MDP_KNOWN_LIVE;   /* no DMA engine: never pending/latched */
+}
+
+/* Source column/row for each framebuffer pixel: the iOS surface is
+ * LEO_RENDER_WIDTH x LEO_RENDER_HEIGHT (320x533), shown at 1.5x. */
+static uint16_t src_x[RPI3_FB_WIDTH], src_y[RPI3_FB_HEIGHT];
+
+static void scale_tables_init(void)
+{
+    unsigned int i;
+    for (i = 0; i < RPI3_FB_WIDTH; i++)
+        src_x[i] = (uint16_t)((i * LEO_RENDER_WIDTH) / RPI3_FB_WIDTH);
+    for (i = 0; i < RPI3_FB_HEIGHT; i++)
+        src_y[i] = (uint16_t)((i * LEO_RENDER_HEIGHT) / RPI3_FB_HEIGHT);
+}
+
+static void copy_row(volatile uint16_t *out, const uint8_t *pixels, uint32_t format)
+{
+    /* 'BGRA' bytes are B,G,R,A; 'RGBA' bytes are R,G,B,A. */
+    const unsigned int r_at = (format == 0x42475241U) ? 2 : 0;
+    const unsigned int b_at = 2 - r_at;
+    unsigned int x;
+    for (x = 0; x < RPI3_FB_WIDTH; x++) {
+        const uint8_t *p = pixels + (uint32_t)src_x[x] * 4U;
+        out[x] = (uint16_t)(((p[r_at] >> 3) << 11) | ((p[1] >> 2) << 5) | (p[b_at] >> 3));
+    }
+}
+
+int ios7leo_display_present(const uint8_t *pixels, uint32_t bytes, uint32_t row,
+                            uint32_t format, uint64_t *completed_sequence)
+{
+    unsigned int y;
+    ++obs_attempts;
+    obs_last_rows = 0;
+    if (!pixels || !completed_sequence || !leo_scanout_geometry(bytes, row, format))
+        return obs_failed(1);
+    if (!ios7leo_display_ready()) return obs_failed(2);
+    if (!rpi_graphics_owner) {
+        boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+        (void)switch_to_serial_console();  /* stop text console drawing */
+        rpi_graphics_owner = 1;
+        ml_set_interrupts_enabled(enabled);
+    }
+    for (y = 0; y < RPI3_FB_HEIGHT; y++) {
+        /* Rows are short; masking per row keeps a fatal painter from
+         * interleaving with a half-written row, as on the HD2. */
+        boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+        if (rpi_fatal_active) { ml_set_interrupts_enabled(enabled); return obs_failed(4); }
+        copy_row(rpi_pixels + y * RPI3_FB_WIDTH, pixels + (uint32_t)src_y[y] * row, format);
+        ++obs_rows; ++obs_last_rows;
+        ml_set_interrupts_enabled(enabled);
+    }
+    sync_writes();
+    ++rpi_graphics_sequence;
+    if (!rpi_graphics_sequence) ++rpi_graphics_sequence;
+    ++obs_completed;
+    *completed_sequence = rpi_graphics_sequence;
+    return 1;
+}
+
+void ios7leo_scanout_observe(LeoDisplayObservation *out)
+{
+    boolean_t enabled;
+    if (!out || out->version != 1) return;
+    enabled = ml_set_interrupts_enabled(FALSE);
+    out->known |= LEO_OBS_PE_COUNTERS;
+    out->present_attempts = obs_attempts;
+    out->conversion_rows = obs_rows;
+    out->last_conversion_rows = obs_last_rows;
+    out->completed = obs_completed;
+    out->failures = obs_failures;
+    out->last_failure = obs_failure_phase;
+    out->graphics_owner = rpi_graphics_owner;
+    out->fatal_active = rpi_fatal_active;
+    out->completed_sequence_before = rpi_graphics_sequence;
+    out->completed_sequence_after = rpi_graphics_sequence;
+    ml_set_interrupts_enabled(enabled);
+}
+
+/* ---- Boot stages ------------------------------------------------------ */
+
+static int cmdline_has(const boot_args *args, const char *word)
+{
+    const char *s = args->CommandLine;
+    unsigned int i, n = 0;
+    while (word[n]) n++;
+    for (i = 0; i + n <= BOOT_LINE_LENGTH && s[i]; i++) {
+        unsigned int k = 0;
+        if (i && s[i - 1] != ' ') continue;
+        while (k < n && s[i + k] == word[k]) k++;
+        if (k == n && (s[i + n] == ' ' || s[i + n] == 0)) return 1;
+    }
+    return 0;
+}
+
+/* arm_init calls this at stages 6, 7 and 8 before the kernel's own VM is up
+ * (locore identity-maps the framebuffer and UART sections for this window),
+ * then at 9 from PE_init_SocSupport_stub and 10 after arm_vm_init. */
+void ios7leo_checkpoint(boot_args *args, unsigned int stage)
+{
+    if (rpi_fatal_active) return;
+    if (stage == 6) {
+        rpi_uart_wanted = cmdline_has(args, "rpi3_uart=1");
+        if (rpi_uart_wanted) rpi_uart = (volatile unsigned int *)RPI3_UART0_PA;
+        if (!video_ok(args)) ios7leo_final_boundary(1);
+        rpi_fb_physical = args->Video.v_baseAddr;
+        rpi_pixels = (volatile unsigned short *)rpi_fb_physical;
+    }
+    if (stage != rpi_stage + 1U || stage < 6 || stage > 10) {
+        if (!(stage == 6 && rpi_stage == 0)) ios7leo_final_boundary(3);
+    }
+    rpi_stage = stage;
+    render_stage(callsite(__builtin_return_address(0)), 0xd000U | stage);
+}
+
+void ios7leo_forget_early_maps(void)
+{
+    rpi_pixels = 0;
+    rpi_uart = 0;
+}
+
+void ios7leo_debug_putc(char c)
+{
+    if (rpi_console_count < sizeof(rpi_console)) rpi_console[rpi_console_count++] = c;
+    rpi_uart_putc(c);
+}
+
+static int rpi_getc(void)
+{
+    volatile unsigned int *u = rpi_uart;
+    if (!u || (u[RPI3_UART_FR / 4] & RPI3_UART_FR_RXFE)) return -1;
+    return (int)(u[RPI3_UART_DR / 4] & 0xffU);
+}
+
+static void rpi_uart_init(void) {}
+
+static unsigned int rpi_emmc_clock_hz;
+unsigned int rpi3_emmc_clock_hz(void) { return rpi_emmc_clock_hz; }
+
+void PE_init_SocSupport_stub(void)
+{
+    DTEntry chosen;
+    rpi3_handoff *h = 0;
+    unsigned int size = 0;
+    boot_args *args = (boot_args *)PE_state.bootArgs;
+    vm_offset_t fb;
+
+    if (!video_ok(args) || DTLookupEntry(0, "/chosen", &chosen) != kSuccess ||
+        DTGetProperty(chosen, RPI3_HANDOFF_PROPERTY, (void **)&h, &size) != kSuccess ||
+        size != sizeof(rpi3_handoff) || !h || h->magic != RPI3_HANDOFF_MAGIC ||
+        h->version != RPI3_HANDOFF_VERSION || h->bytes != sizeof(rpi3_handoff) ||
+        h->fb_physical != args->Video.v_baseAddr || h->fb_pitch != RPI3_FB_ROW_BYTES ||
+        h->fb_width != RPI3_FB_WIDTH || h->fb_height != RPI3_FB_HEIGHT || h->fb_depth != 16 ||
+        h->memory_base != args->physBase || h->memory_bytes != args->memSize ||
+        h->top_of_kernel_data != args->topOfKernelData)
+        ios7leo_final_boundary(4);
+
+    rpi_emmc_clock_hz = h->emmc_clock_hz;
+    bzero((void *)&rpi_memory_state, sizeof(rpi_memory_state));
+    rpi_memory_state.version = IOS7_LEO_MEMORY_OBS_VERSION;
+    rpi_memory_state.status = LEO_MEMORY_STATUS_OK;
+    rpi_memory_state.bank_count = 1;
+    rpi_memory_state.banks[0].base = 0;
+    rpi_memory_state.banks[0].bytes = h->arm_memory_bytes;
+    rpi_memory_state.selected_base = args->physBase;
+    rpi_memory_state.selected_bytes = args->memSize;
+    rpi_memory_state.known = LEO_MEMORY_KNOWN_ATAG;
+    rpi_memory_state.sequence = ++rpi_memory_sequence;
+
+    fb = ml_io_map(rpi_fb_physical, RPI3_FB_BYTES);
+    if (!fb) ios7leo_final_boundary(5);
+    rpi_pixels = (volatile unsigned short *)fb;
+    if (rpi_uart_wanted) rpi_uart = (volatile unsigned int *)ml_io_map(RPI3_UART0_PA, PAGE_SIZE);
+    scale_tables_init();
+
+    PE_state.video.v_baseAddr = fb;
+    PE_state.video.v_rowBytes = RPI3_FB_ROW_BYTES;
+    PE_state.video.v_width = RPI3_FB_WIDTH;
+    PE_state.video.v_height = RPI3_FB_HEIGHT;
+    PE_state.video.v_depth = 16;
+
+    gPESocDispatch.uart_putc = ios7leo_debug_putc;
+    gPESocDispatch.uart_getc = rpi_getc;
+    gPESocDispatch.uart_init = rpi_uart_init;
+    gPESocDispatch.interrupt_init = Rpi3_interrupt_init;
+    gPESocDispatch.timebase_init = Rpi3_timebase_init;
+    gPESocDispatch.handle_interrupt = Rpi3_handle_interrupt;
+    gPESocDispatch.get_timebase = Rpi3_get_timebase;
+    gPESocDispatch.timer_value = Rpi3_timer_value;
+    gPESocDispatch.timer_enabled = Rpi3_timer_enabled;
+    {
+        /* The generic text console owns the screen until iOS presents. */
+        PE_Video console_video = PE_state.video;
+        console_video.v_baseAddr = rpi_fb_physical | 1U;
+        console_video.v_baseAddrHigh = 0;
+        console_video.v_offset = 0;
+        console_video.v_length = RPI3_FB_BYTES;
+        console_video.v_scale = kPEScaleFactor1x;
+        initialize_screen(&console_video, kPETextMode);
+    }
+    ios7leo_checkpoint(args, 9);
+    __asm__ volatile("" ::: "memory");
+}
+
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
diff --git a/xnu/pexpert/arm/rpi3_board.h b/xnu/pexpert/arm/rpi3_board.h
new file mode 100644
index 0000000..8b3b807
--- /dev/null
+++ b/xnu/pexpert/arm/rpi3_board.h
@@ -0,0 +1,84 @@
+/*
+ * Raspberry Pi 3 Model B+ (BCM2837B0) board constants, 32-bit (AArch32) view.
+ *
+ * The Pi 3 runs this kernel the way the HTC HD2 port does: one CPU, one
+ * interrupt source (a free-running timer compare), a firmware-allocated
+ * framebuffer. Register layouts are from the BCM2835 ARM Peripherals manual
+ * and the BCM2836 "ARM local peripherals" note; BCM2837 keeps both at the
+ * same addresses as BCM2836 in 32-bit mode.
+ */
+#ifndef PEXPERT_ARM_RPI3_BOARD_H
+#define PEXPERT_ARM_RPI3_BOARD_H
+
+#define RPI3_PERIPHERAL_BASE    0x3f000000U
+#define RPI3_PERIPHERAL_BYTES   0x01000000U
+
+/* System timer: free-running 64-bit counter at 1 MHz, four 32-bit compares.
+ * Compares 0 and 2 belong to the VideoCore; 1 and 3 are free for the ARM. */
+#define RPI3_SYSTIMER_PA        (RPI3_PERIPHERAL_BASE + 0x003000U)
+#define RPI3_SYSTIMER_CS        0x00U   /* match flags, write 1 to clear */
+#define RPI3_SYSTIMER_CLO       0x04U
+#define RPI3_SYSTIMER_CHI       0x08U
+#define RPI3_SYSTIMER_C3        0x18U
+#define RPI3_SYSTIMER_M3        (1U << 3)
+#define RPI3_SYSTIMER_HZ        1000000U
+
+/* VideoCore/ARM interrupt controller ("armctrl"). GPU IRQ n<32 is bit n of
+ * the bank-1 registers; system timer compare 3 is GPU IRQ 3. */
+#define RPI3_ARMCTRL_PA         (RPI3_PERIPHERAL_BASE + 0x00b000U)
+#define RPI3_ARMCTRL_OFFSET     0x200U
+#define RPI3_IRQ_BASIC_PENDING  0x00U
+#define RPI3_IRQ_PENDING_1      0x04U
+#define RPI3_IRQ_PENDING_2      0x08U
+#define RPI3_FIQ_CONTROL        0x0cU
+#define RPI3_ENABLE_IRQS_1      0x10U
+#define RPI3_ENABLE_IRQS_2      0x14U
+#define RPI3_ENABLE_BASIC       0x18U
+#define RPI3_DISABLE_IRQS_1     0x1cU
+#define RPI3_DISABLE_IRQS_2     0x20U
+#define RPI3_DISABLE_BASIC      0x24U
+#define RPI3_IRQ_SYSTIMER3      3U
+
+/* PL011 UART0 (GPIO 14/15 when Bluetooth is moved off it). Debug only. */
+#define RPI3_UART0_PA           (RPI3_PERIPHERAL_BASE + 0x201000U)
+#define RPI3_UART_DR            0x00U
+#define RPI3_UART_FR            0x18U
+#define RPI3_UART_FR_TXFF       (1U << 5)
+#define RPI3_UART_FR_RXFE       (1U << 4)
+
+/* Display contract shared with the HD2 code: the boot shim asks the firmware
+ * for this exact 16bpp framebuffer, and the GPU scales it to the HDMI mode. */
+#define RPI3_FB_WIDTH           480U
+#define RPI3_FB_HEIGHT          800U
+#define RPI3_FB_ROW_BYTES       960U
+#define RPI3_FB_BYTES           (RPI3_FB_ROW_BYTES * RPI3_FB_HEIGHT)
+
+/* Machine type the shim writes into boot_args (Linux's BCM2709 number). */
+#define RPI3_MACHINE_TYPE       3138U
+
+/* Handoff from the boot shim, published as /chosen/rpi3-handoff. */
+#define RPI3_HANDOFF_MAGIC      0x33495052U /* "RPI3" */
+#define RPI3_HANDOFF_VERSION    1U
+#define RPI3_HANDOFF_PROPERTY   "rpi3-handoff"
+typedef struct rpi3_handoff {
+    unsigned int magic, version, bytes, flags;
+    unsigned int entry_cpsr, entry_sctlr;       /* as the shim found the CPU */
+    unsigned int board_revision, arm_memory_bytes;
+    unsigned int fb_physical, fb_bytes, fb_pitch, fb_width, fb_height, fb_depth;
+    unsigned int display_width, display_height; /* HDMI mode, 0 if unknown */
+    unsigned int memory_base, memory_bytes, top_of_kernel_data;
+    unsigned int shim_start, shim_end, payload_start, payload_end;
+    unsigned int emmc_clock_hz;                 /* SDHCI base clock */
+    unsigned int reserved[8];
+} rpi3_handoff;
+
+/* Values from the handoff for drivers (pe_rpi3.c). */
+#ifdef __cplusplus
+extern "C" {
+#endif
+unsigned int rpi3_emmc_clock_hz(void);
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PEXPERT_ARM_RPI3_BOARD_H */
diff --git a/xnu/pexpert/arm/rpi3_timer.c b/xnu/pexpert/arm/rpi3_timer.c
new file mode 100644
index 0000000..1d8618f
--- /dev/null
+++ b/xnu/pexpert/arm/rpi3_timer.c
@@ -0,0 +1,192 @@
+/*
+ * Raspberry Pi 3 interrupt controller and timebase for the iOS 7 kernel.
+ *
+ * Follows the contract of the HTC HD2's leo_qsd8250_timer.c: a single CPU,
+ * one enabled interrupt (a timer compare) and a free-running hardware counter
+ * as the timebase. Here the counter is the BCM283x system timer (1 MHz, 64-bit)
+ * and the compare is channel 3, which reaches the ARM as GPU IRQ 3 through the
+ * armctrl block. The firmware leaves GPU interrupts routed to core 0's IRQ line.
+ */
+#include <mach/mach_types.h>
+#include <mach/arm/thread_status.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/protos.h>
+#include <machine/machine_routines.h>
+#include <kern/debug.h>
+#include "rpi3_board.h"
+#include "rpi3_timer.h"
+
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+
+extern void rtc_configure(uint64_t hz);
+extern void rtclock_intr(arm_saved_state_t *regs);
+extern void ios7leo_timer_observe(uint32_t raw_ticks, uint32_t irq_count);
+
+uint64_t clock_decrementer;
+
+/* Reprogramming the compare takes a few bus cycles; never schedule closer. */
+#define MIN_MATCH_TICKS     8U
+#define MAX_MATCH_TICKS     0x7fffffffU
+
+static vm_offset_t armctrl, systimer;
+static uint32_t controller_ready, timebase_ready, armed;
+static uint32_t irq_count, last_irq_counter, spurious_irq_count;
+
+static uint32_t rd(vm_offset_t base, uint32_t offset)
+{
+    return *(volatile uint32_t *)(base + offset);
+}
+
+static void wr(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(base + offset) = value;
+}
+
+static void drain(void) { __asm__ volatile("dsb sy" ::: "memory"); }
+
+/* CHI:CLO read with a carry check, as the counter keeps running. */
+static uint64_t counter64(void)
+{
+    uint32_t hi, lo, check;
+    do {
+        hi = rd(systimer, RPI3_SYSTIMER_CHI);
+        lo = rd(systimer, RPI3_SYSTIMER_CLO);
+        check = rd(systimer, RPI3_SYSTIMER_CHI);
+    } while (hi != check);
+    return ((uint64_t)hi << 32) | lo;
+}
+
+void Rpi3_interrupt_init(void)
+{
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+    if (controller_ready) { ml_set_interrupts_enabled(was_enabled); return; }
+
+    vm_offset_t page = ml_io_map(RPI3_ARMCTRL_PA, PAGE_SIZE);
+    systimer = ml_io_map(RPI3_SYSTIMER_PA, PAGE_SIZE);
+    if (!page || !systimer)
+        panic("Rpi3 armctrl/system timer IO mapping failed");
+    armctrl = page + RPI3_ARMCTRL_OFFSET;
+
+    /* Nothing reaches the CPU until the timebase asks for its one source. */
+    wr(armctrl, RPI3_FIQ_CONTROL, 0);
+    wr(armctrl, RPI3_DISABLE_IRQS_1, 0xffffffffU);
+    wr(armctrl, RPI3_DISABLE_IRQS_2, 0xffffffffU);
+    wr(armctrl, RPI3_DISABLE_BASIC, 0xffffffffU);
+    drain();
+    controller_ready = 1;
+    ml_set_interrupts_enabled(was_enabled);
+}
+
+void Rpi3_timebase_init(void)
+{
+    uint32_t before, after, i;
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+    if (!controller_ready) panic("Rpi3 timebase before interrupt controller");
+    if (timebase_ready) { ml_set_interrupts_enabled(was_enabled); return; }
+
+    wr(armctrl, RPI3_DISABLE_IRQS_1, 1U << RPI3_IRQ_SYSTIMER3);
+    wr(systimer, RPI3_SYSTIMER_CS, RPI3_SYSTIMER_M3);
+    drain();
+
+    /* The counter is free-running from power-on; just confirm it moves. */
+    before = rd(systimer, RPI3_SYSTIMER_CLO);
+    after = before;
+    for (i = 0; i < 1000000U && after == before; i++)
+        after = rd(systimer, RPI3_SYSTIMER_CLO);
+    if (after == before) panic("Rpi3 system timer did not advance");
+
+    timebase_ready = 1;
+    clock_decrementer = RPI3_SYSTIMER_HZ / 1000U;   /* 1 ms tick */
+    gPEClockFrequencyInfo.timebase_frequency_hz = RPI3_SYSTIMER_HZ;
+    gPEClockFrequencyInfo.dec_clock_rate_hz = RPI3_SYSTIMER_HZ;
+    rtc_configure(RPI3_SYSTIMER_HZ);
+    Rpi3_timer_enabled(TRUE);
+    ml_set_interrupts_enabled(was_enabled);
+}
+
+void Rpi3_timer_enabled(int enable)
+{
+    uint32_t ticks, attempt, now, match;
+    uint64_t requested;
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+    if (!timebase_ready) panic("Rpi3 timer before timebase initialization");
+
+    wr(armctrl, RPI3_DISABLE_IRQS_1, 1U << RPI3_IRQ_SYSTIMER3);
+    wr(systimer, RPI3_SYSTIMER_CS, RPI3_SYSTIMER_M3);
+    armed = 0;
+    drain();
+
+    requested = clock_decrementer;
+    if (!enable || requested == ~0ULL) {
+        ml_set_interrupts_enabled(was_enabled);
+        return;
+    }
+    ticks = requested > MAX_MATCH_TICKS ? MAX_MATCH_TICKS : (uint32_t)requested;
+    if (ticks < MIN_MATCH_TICKS) ticks = MIN_MATCH_TICKS;
+
+    /* The compare only fires on equality, so a match written into the past
+     * would wait a full 71-minute wrap. Re-read after writing and retry if
+     * the counter got too close. */
+    for (attempt = 0; attempt < 4U; attempt++) {
+        now = rd(systimer, RPI3_SYSTIMER_CLO);
+        match = now + ticks;
+        wr(systimer, RPI3_SYSTIMER_C3, match);
+        drain();
+        if ((int32_t)(match - rd(systimer, RPI3_SYSTIMER_CLO)) > (int32_t)(MIN_MATCH_TICKS / 2)) {
+            armed = 1;
+            wr(armctrl, RPI3_ENABLE_IRQS_1, 1U << RPI3_IRQ_SYSTIMER3);
+            drain();
+            ml_set_interrupts_enabled(was_enabled);
+            return;
+        }
+        ticks *= 2;
+    }
+    panic("Rpi3 system timer compare repeatedly late");
+}
+
+uint64_t Rpi3_get_timebase(void)
+{
+    return timebase_ready ? counter64() : 0; /* 1 MHz ticks; rtclock converts */
+}
+
+uint64_t Rpi3_timer_value(void)
+{
+    int32_t remaining = 0;
+    boolean_t was_enabled = ml_set_interrupts_enabled(FALSE);
+    if (timebase_ready && armed)
+        remaining = (int32_t)(rd(systimer, RPI3_SYSTIMER_C3) - rd(systimer, RPI3_SYSTIMER_CLO));
+    ml_set_interrupts_enabled(was_enabled);
+    return remaining > 0 ? (uint32_t)remaining : 0;
+}
+
+void Rpi3_handle_interrupt(void *context)
+{
+    uint32_t pending, budget;
+    if (!controller_ready || !timebase_ready)
+        panic("Rpi3 IRQ before controller/timebase initialization");
+
+    for (budget = 0; budget < 64U; budget++) {
+        /* Only our one enabled source is looked at: the VideoCore owns the
+         * other GPU interrupt lines, and documentation differs on whether
+         * the pending registers mask out sources the ARM never enabled. */
+        pending = rd(armctrl, RPI3_IRQ_PENDING_1);
+        if (!(pending & (1U << RPI3_IRQ_SYSTIMER3))) {
+            if (budget == 0) spurious_irq_count++;
+            return;
+        }
+        wr(armctrl, RPI3_DISABLE_IRQS_1, 1U << RPI3_IRQ_SYSTIMER3);
+        wr(systimer, RPI3_SYSTIMER_CS, RPI3_SYSTIMER_M3);   /* ack the match */
+        drain();
+        armed = 0;
+        last_irq_counter = rd(systimer, RPI3_SYSTIMER_CLO);
+        irq_count++;
+        rtclock_intr((arm_saved_state_t *)context);
+#if !CONFIG_TICKLESS
+        Rpi3_timer_enabled(TRUE);
+#endif
+        ios7leo_timer_observe(last_irq_counter, irq_count);
+    }
+    panic("Rpi3 IRQ drain budget exceeded");
+}
+
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
