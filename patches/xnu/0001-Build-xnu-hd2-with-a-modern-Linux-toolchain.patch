diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/leo_diag_stubs.c b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/leo_diag_stubs.c
new file mode 100644
index 0000000..9f403da
--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/leo_diag_stubs.c
@@ -0,0 +1,32 @@
+/*
+ * No-op stand-ins for HD2 diagnostic observers that IOS7LeoSDLogger.cpp calls
+ * but whose implementations are not in the public xnu-hd2 tree. They only
+ * feed the on-card boot log; returning "nothing observed" (zeroed records)
+ * leaves the logger writing what it can. QSD8250_LEO only.
+ */
+#if defined(BOARD_CONFIG_QSD8250_LEO)
+#include <stdint.h>
+#include <string.h>
+#include "IOS7LeoPresentCost.h"
+#include "IOS7LeoSurfaceAdmission.h"
+#include "IOS7LeoSwitchObservation.h"
+
+void ios7leo_log_progress(uint32_t stage, uint32_t value) { (void)stage; (void)value; }
+
+void ios7leo_mdp_ack_observe_v2(uint32_t *a, uint32_t *b, uint32_t *c,
+                                uint32_t *d, uint32_t *e, uint32_t *f)
+{
+    uint32_t *outs[] = { a, b, c, d, e, f };
+    for (unsigned i = 0; i < 6; i++)
+        if (outs[i]) *outs[i] = 0;
+}
+
+void ios7leo_present_cost_observe(LeoPresentCostObservation *out)
+{ if (out) memset(out, 0, sizeof(*out)); }
+
+void ios7leo_surface_admission_observe(LeoSurfaceAdmissionObservation *out)
+{ if (out) memset(out, 0, sizeof(*out)); }
+
+void ios7leo_switch_observe(LeoSwitchObservation *out)
+{ if (out) memset(out, 0, sizeof(*out)); }
+#endif
diff --git a/xnu/iokit/IOKit/storage/Makefile b/xnu/iokit/IOKit/storage/Makefile
new file mode 100644
index 0000000..a8d6bcd
--- /dev/null
+++ b/xnu/iokit/IOKit/storage/Makefile
@@ -0,0 +1,36 @@
+export MakeInc_cmd=${SRCROOT}/makedefs/MakeInc.cmd
+export MakeInc_def=${SRCROOT}/makedefs/MakeInc.def
+export MakeInc_rule=${SRCROOT}/makedefs/MakeInc.rule
+export MakeInc_dir=${SRCROOT}/makedefs/MakeInc.dir
+
+IOKIT_FRAMEDIR = $(FRAMEDIR)/IOKit.framework/Versions/A
+export INCDIR = $(IOKIT_FRAMEDIR)/Headers
+export LCLDIR = $(IOKIT_FRAMEDIR)/PrivateHeaders
+
+include $(MakeInc_cmd)
+include $(MakeInc_def)
+
+MI_DIR = storage
+NOT_EXPORT_HEADERS = 
+
+INSTINC_SUBDIRS =
+INSTINC_SUBDIRS_I386 =
+INSTINC_SUBDIRS_X86_64 =
+INSTINC_SUBDIRS_ARM =
+
+EXPINC_SUBDIRS = ${INSTINC_SUBDIRS}
+EXPINC_SUBDIRS_I386 = ${INSTINC_SUBDIRS_I386}
+EXPINC_SUBDIRS_X86_64 = ${INSTINC_SUBDIRS_X86_64}
+EXPINC_SUBDIRS_ARM = ${INSTINC_SUBDIRS_ARM}
+
+ALL_HEADERS = $(shell (cd $(SOURCE); echo *.h))
+
+INSTALL_MI_LIST	= 
+INSTALL_MI_LCL_LIST = ""
+INSTALL_MI_DIR = $(MI_DIR)
+
+EXPORT_MI_LIST	= $(filter-out $(NOT_EXPORT_HEADERS), $(ALL_HEADERS))
+EXPORT_MI_DIR = IOKit/$(MI_DIR)
+
+include $(MakeInc_rule)
+include $(MakeInc_dir)
