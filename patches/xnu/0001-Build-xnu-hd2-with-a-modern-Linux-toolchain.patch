diff --git a/xnu/pexpert/arm/leo_scanout_row.c b/xnu/pexpert/arm/leo_scanout_row.c
new file mode 100644
index 0000000..b1d62e4
--- /dev/null
+++ b/xnu/pexpert/arm/leo_scanout_row.c
@@ -0,0 +1,23 @@
+/*
+ * Stand-in for the HD2 scanout row converter, which is referenced by
+ * pe_qsd8250_leo.c but absent from the public xnu-hd2 tree. Not used on
+ * Raspberry Pi; present so the QSD8250_LEO target links for toolchain checks.
+ *
+ * Contract (IOS7LeoScanoutRow.h): one 320-pixel 32bpp input row becomes
+ * 480 RGB565 output pixels (1.5x horizontal, nearest neighbour).
+ */
+#if defined(BOARD_CONFIG_QSD8250_LEO)
+#include <stdint.h>
+#include "IOS7LeoScanoutRow.h"
+
+void leo_scanout_copy_row(volatile uint16_t *out, const uint8_t *pixels, uint32_t format)
+{
+    /* 0x42475241 'BGRA': bytes B,G,R,A. 0x52474241 'RGBA': bytes R,G,B,A. */
+    const int bgra = (format == 0x42475241U);
+    for (uint32_t x = 0; x < 480; x++) {
+        const uint8_t *p = pixels + (x * 2 / 3) * 4;
+        uint32_t r = bgra ? p[2] : p[0], g = p[1], b = bgra ? p[0] : p[2];
+        out[x] = (uint16_t)(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3));
+    }
+}
+#endif
