+static const char *const cursor_shape[CURSOR_H] = {
+    "1           ", "11          ", "121         ", "1221        ",
+    "12221       ", "122221      ", "1222221     ", "12222221    ",
+    "122222221   ", "1222222221  ", "12222222221 ", "122222111111",
+    "1221221     ", "121 1221    ", "11  1221    ", "1    1221   ",
+    "     1221   ", "      1221  ", "      11    "
+};
+static int cursor_x = -1, cursor_y = -1, cursor_drawn, presenting;
+static uint16_t cursor_under[CURSOR_H][CURSOR_W];
+
+static void cursor_hide_locked(void)
+{
+    int r, c;
+    if (!cursor_drawn || !rpi_pixels) { cursor_drawn = 0; return; }
+    for (r = 0; r < CURSOR_H; r++)
+        for (c = 0; c < CURSOR_W; c++) {
+            int x = cursor_x + c, y = cursor_y + r;
+            if (x < (int)RPI3_FB_WIDTH && y < (int)RPI3_FB_HEIGHT && cursor_shape[r][c] != ' ')
+                rpi_pixels[y * RPI3_FB_WIDTH + x] = cursor_under[r][c];
+        }
+    cursor_drawn = 0;
+}
+
+static void cursor_show_locked(void)
+{
+    int r, c;
+    if (cursor_x < 0 || !rpi_pixels || !rpi_graphics_owner || rpi_fatal_active) return;
+    for (r = 0; r < CURSOR_H; r++)
+        for (c = 0; c < CURSOR_W; c++) {
+            int x = cursor_x + c, y = cursor_y + r;
+            if (x >= (int)RPI3_FB_WIDTH || y >= (int)RPI3_FB_HEIGHT || cursor_shape[r][c] == ' ') continue;
+            cursor_under[r][c] = rpi_pixels[y * RPI3_FB_WIDTH + x];
+            rpi_pixels[y * RPI3_FB_WIDTH + x] = cursor_shape[r][c] == '2' ? 0xffff : 0x0000;
+        }
+    cursor_drawn = 1;
+}
+
+/* Called by the USB mouse transport with screen coordinates (0..479, 0..799). */
+void rpi3_cursor_move(int x, int y)
+{
+    boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+    if (presenting) { cursor_x = x; cursor_y = y; }     /* drawn when the frame lands */
+    else { cursor_hide_locked(); cursor_x = x; cursor_y = y; cursor_show_locked(); }
+    sync_writes();
+    ml_set_interrupts_enabled(enabled);
+}
