--- /dev/null
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/rpi3_usb.h
@@ -0,0 +1,54 @@
+/*
+ * Minimal USB host for the Raspberry Pi's DWC2 controller: enough to find a
+ * HID boot-protocol mouse through the Pi 3B+'s two built-in hub levels and
+ * read its reports. Polled, one host channel, buffer-DMA mode.
+ */
+#ifndef RPI3_USB_H
+#define RPI3_USB_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define RPI3_USB_PA     0x3f980000U
+#define RPI3_USB_BYTES  0x00011000U   /* core, host and power registers */
+
+struct rpi3_usb_io {
+    void *opaque;
+    volatile uint32_t *regs;          /* mapped RPI3_USB_PA */
+    volatile uint8_t *dma;            /* 4 KiB, uncached, physically contiguous */
+    uint32_t dma_physical;
+    uint64_t (*now_ns)(void *);
+    void (*sleep_ms)(void *, uint32_t);
+};
+
+enum {
+    RPI3_USB_OK = 0, RPI3_USB_NAK = 1,
+    RPI3_USB_ERROR = -1, RPI3_USB_TIMEOUT = -2, RPI3_USB_STALL = -3,
+    RPI3_USB_NO_DEVICE = -4, RPI3_USB_NO_MOUSE = -5
+};
+
+struct rpi3_usb_endpoint {
+    uint8_t address, endpoint, speed, max_packet, interval, toggle;
+    uint8_t split, tt_hub, tt_port;   /* transaction translator, if split */
+};
+
+struct rpi3_usb {
+    struct rpi3_usb_io io;
+    uint8_t next_address, root_speed;
+    int mouse_found;
+    struct rpi3_usb_endpoint mouse;
+    uint32_t mouse_interface;
+    uint32_t devices, hubs, errors, naks, reports;
+    int32_t last_result;
+};
+
+int rpi3_usb_init(struct rpi3_usb *, const struct rpi3_usb_io *);
+/* RPI3_USB_OK with a report (buttons, dx, dy), RPI3_USB_NAK when the mouse
+ * had nothing new, negative on errors. */
+int rpi3_usb_mouse_poll(struct rpi3_usb *, uint8_t *buttons, int8_t *dx, int8_t *dy);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
