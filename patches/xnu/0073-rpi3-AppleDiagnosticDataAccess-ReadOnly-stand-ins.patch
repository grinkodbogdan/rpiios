+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3DiagData.cpp
@@ -0,0 +1,98 @@
+/*
+ * Raspberry Pi 3: stand-ins for AppleDiagnosticDataAccess(ReadOnly).
+ *
+ * On an iPhone these kexts read the factory system configuration (serial
+ * number, calibration data). iOS 10's MobileGestalt looks them up, and when
+ * the read-only one is missing it registers for its arrival and waits on a
+ * run loop with no deadline. Its migrator then never finishes, accountsd
+ * holds every client until migration completes, and SpringBoard waits on
+ * accountsd forever. These services exist so the wait ends; their user
+ * clients have no data and refuse every request, which MobileGestalt
+ * treats as an unanswerable question.
+ */
+#if defined(BOARD_CONFIG_RASPBERRYPI3)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+extern "C" int proc_selfpid(void);
+
+class AppleDiagnosticDataAccess : public IOService {
+    OSDeclareDefaultStructors(AppleDiagnosticDataAccess)
+public:
+    virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+                                   OSDictionary *properties, IOUserClient **handler);
+};
+
+class AppleDiagnosticDataAccessReadOnly : public AppleDiagnosticDataAccess {
+    OSDeclareDefaultStructors(AppleDiagnosticDataAccessReadOnly)
+};
+
+class AppleDiagnosticDataAccessUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleDiagnosticDataAccessUserClient)
+public:
+    virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+                                    IOExternalMethodDispatch *dispatch, OSObject *target,
+                                    void *reference);
+    virtual IOReturn clientClose(void);
+};
+
+OSDefineMetaClassAndStructors(AppleDiagnosticDataAccess, IOService)
+OSDefineMetaClassAndStructors(AppleDiagnosticDataAccessReadOnly, AppleDiagnosticDataAccess)
+OSDefineMetaClassAndStructors(AppleDiagnosticDataAccessUserClient, IOUserClient)
+
+IOReturn AppleDiagnosticDataAccess::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+                                                  OSDictionary *properties, IOUserClient **handler)
+{
+    if (!handler) return kIOReturnBadArgument;
+    *handler = 0;
+    AppleDiagnosticDataAccessUserClient *client = new AppleDiagnosticDataAccessUserClient;
+    if (!client) return kIOReturnNoMemory;
+    if (!client->initWithTask(owningTask, securityID, type, properties)) {
+        client->release(); return kIOReturnNoMemory;
+    }
+    if (!client->attach(this)) { client->release(); return kIOReturnError; }
+    if (!client->start(this)) { client->detach(this); client->release(); return kIOReturnError; }
+    *handler = client;
+    return kIOReturnSuccess;
+}
+
+IOReturn AppleDiagnosticDataAccessUserClient::externalMethod(uint32_t selector,
+                                                             IOExternalMethodArguments *args,
+                                                             IOExternalMethodDispatch *,
+                                                             OSObject *, void *)
+{
+    static unsigned logs;
+    if (logs < 16) {
+        ++logs;
+        IOLog("Rpi3 AppleDiagnosticDataAccess pid=%d selector=%u: no factory data\n",
+              proc_selfpid(), selector);
+    }
+    (void)args;
+    return kIOReturnNotFound;
+}
+
+IOReturn AppleDiagnosticDataAccessUserClient::clientClose(void)
+{
+    terminate();
+    return kIOReturnSuccess;
+}
+
+static void rpi3_publish(IOService *service, IOService *platform)
+{
+    if (!service) return;
+    if (service->init() && service->attach(platform)) {
+        if (service->start(platform))
+            service->registerService();
+        else
+            service->detach(platform);
+    }
+    service->release();
+}
+
+extern "C" void rpi3_register_diagdata(IOService *platform)
+{
+    rpi3_publish(new AppleDiagnosticDataAccess, platform);
+    rpi3_publish(new AppleDiagnosticDataAccessReadOnly, platform);
+    IOLog("Rpi3 AppleDiagnosticDataAccess stand-ins published (no factory data)\n");
+}
+#endif /* BOARD_CONFIG_RASPBERRYPI3 */
