From 405532e8aa36930cada0412c40bfd2574900a399 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 15 Oct 2026 18:27:34 +0000
Subject: [PATCH] Raspberry Pi 3: AppleKeyStore reports lock state disabled (no
 passcode)

---
 .../ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp            | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp
index 35fb620..3c16a12 100644
--- a/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp
+++ b/xnu/iokit/Drivers/KernelBuiltIn/ARM/AppleARMPlatform/IOS7Rpi3KeyStore.cpp
@@ -6,9 +6,8 @@
  * MobileKeyBag call fails with kIOReturnError ("Unexpected AppleKeyStore
  * error: -536870212" from SpringBoard), and SpringBoard aborts slide to
  * unlock after asking it for the lock state. This answers every method
- * with success and zeroed outputs: the device has no passcode and is
- * unlocked (lock state 0), which is what a phone without a passcode
- * reports. There is no data protection behind it.
+ * with success and zeroed outputs, and the lock state as "disabled" (3):
+ * what a phone without a passcode reports. There is no data protection behind it.
  */
 #if defined(BOARD_CONFIG_RASPBERRYPI3)
 #include <IOKit/IOService.h>
@@ -65,6 +64,10 @@ IOReturn AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMe
               args->scalarOutputCount, args->structureOutputSize);
     }
     for (i = 0; i < args->scalarOutputCount; i++) args->scalarOutput[i] = 0;
+    /* Selector 17 is the lock state (MKBGetDeviceLockState returns its one
+     * scalar): 3 = kMobileKeyBagDisabled, no passcode. 0 would mean
+     * "unlocked, but a passcode exists". */
+    if (selector == 17 && args->scalarOutputCount >= 1) args->scalarOutput[0] = 3;
     if (args->structureOutput && args->structureOutputSize)
         bzero(args->structureOutput, args->structureOutputSize);
     if (args->structureOutputDescriptor) args->structureOutputDescriptorSize = 0;
-- 
2.43.0

