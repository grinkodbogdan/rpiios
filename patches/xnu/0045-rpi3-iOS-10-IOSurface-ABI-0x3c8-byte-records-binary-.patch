+/*
+ * iOS 10 sends surface properties in the kernel's binary serialization
+ * (signature 0xd3; each object a 32-bit header: type in bits 24-30, length
+ * below). This kernel only reads XML, so pick out the top-level
+ * symbol -> number pairs, which is all a surface request needs.
+ */
+static OSDictionary *rpi3_unserialize_binary_numbers(const void *buf, uint32_t bytes)
+{
+    const uint32_t *w = (const uint32_t *)buf;
+    uint32_t n = bytes / 4, i = 1;
+    OSDictionary *d;
+    const OSSymbol *key = 0;
+
+    if (n < 2 || w[0] != 0xd3 || !(d = OSDictionary::withCapacity(16)))
+        return 0;
+    while (i < n) {
+        uint32_t h = w[i++], type = (h >> 24) & 0x7f, len = h & 0xffffff;
+
+        switch (type) {
+        case 0x08: {	/* symbol: key */
+            uint32_t words = (len + 3) / 4;
+            if (i + words > n || !len) goto out;
+            if (key) key->release();
+            char name[64];
+            uint32_t l = len < sizeof(name) ? len : sizeof(name) - 1;
+            memcpy(name, &w[i], l);
+            name[l] = 0;
+            key = OSSymbol::withCString(name);
+            i += words;
+            continue;
+        }
+        case 0x04: {	/* number: 64-bit value follows */
+            if (i + 2 > n) goto out;
+            if (key) {
+                OSNumber *num = OSNumber::withNumber(((uint64_t)w[i + 1] << 32) | w[i], 64);
+                if (num) { d->setObject(key, num); num->release(); }
+            }
+            i += 2;
+            break;
+        }
+        case 0x09: case 0x0a:	/* string, data */
+            i += (len + 3) / 4;
+            break;
+        case 0x0c:		/* reference */
+            i += 1;
+            break;
+        default:		/* dictionary, array, set, boolean: no payload */
+            break;
+        }
+        if (key) { key->release(); key = 0; }
+    }
+out:
+    if (key) key->release();
+    return d;
+}
