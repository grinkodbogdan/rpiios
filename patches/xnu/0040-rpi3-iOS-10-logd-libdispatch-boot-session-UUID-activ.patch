+				return 0;
 			}
 		}
 	} else {
@@ -555,6 +560,9 @@ filt_machport(
 	if (kbuf) {
 		kn->kn_hookid |= FILT_MACHPORT_KBUF;
 		kn->kn_ext[0] = self->ith_msg_addr;
+		/* too large for the space left: say which port to receive from */
+		if (kn->kn_fflags == MACH_RCV_TOO_LARGE)
+			kn->kn_data = self->ith_receiver_name;
 		if (kn->kn_fflags == MACH_MSG_SUCCESS) {
 			/* message plus the largest trailer, kept 16-byte aligned */
 			rpi3_kevent_data_used((mach_msg_size_t)
