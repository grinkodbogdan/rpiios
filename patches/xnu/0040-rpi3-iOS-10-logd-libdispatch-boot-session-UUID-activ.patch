+	if (proc_pid(rp) != 1 && !strncmp(proc_name_address(sp), name, strlen(name))) {
+		if (logs++ < 300)
+			kprintf("rpi3 send: %s -> %s[%d] id=%d size=%u bits=%x\n", proc_name_address(sp),
+			    proc_name_address(rp), proc_pid(rp), kmsg->ikm_header->msgh_id, size,
+			    kmsg->ikm_header->msgh_bits);
+		return;
+	}
 	if (!((proc_pid(sp) == 1 && !strncmp(proc_name_address(rp), name, strlen(name))) ||
 	    (proc_pid(rp) == 1 && !strncmp(proc_name_address(sp), name, strlen(name)))))
 		return;
diff --git a/xnu/osfmk/kern/syscall_sw.c b/xnu/osfmk/kern/syscall_sw.c
index 841d122..1a71588 100644
--- a/xnu/osfmk/kern/syscall_sw.c
+++ b/xnu/osfmk/kern/syscall_sw.c
@@ -99,6 +99,7 @@ int kern_invalid_debug = 0;
 #include <kern/clock.h>
 #include <mach/mk_timer.h>
 #include <arm/ios7_compat.h>
+#include <libkern/OSAtomic.h>
 #if IOS7_COMPAT_PLATFORM
 extern int ios7lab_mach_vm_map_trap(void *saved_registers);
 extern int ios7lab_mach_port_construct_trap(void *saved_registers);
@@ -168,7 +169,9 @@ const mach_trap_t	mach_trap_table[MACH_TRAP_TABLE_COUNT] = {
 /* 41 */	MACH_TRAP(kern_invalid, 0, NULL, NULL),
 /* 42 */	MACH_TRAP(kern_invalid, 0, NULL, NULL),
 #endif
-#if	!defined(CONFIG_EMBEDDED)
+#if BOARD_CONFIG_RASPBERRYPI3
+/* 43 */	MACH_TRAP(rpi3_mach_generate_activity_id_trap, 3, NULL, NULL),
+#elif	!defined(CONFIG_EMBEDDED)
 /* 43 */	MACH_TRAP(map_fd, 5, munge_wwwww, munge_ddddd),
 #else
 /* 43 */	MACH_TRAP(kern_invalid, 0, NULL, NULL),
@@ -406,6 +409,25 @@ int	mach_trap_count = (sizeof(mach_trap_table) / sizeof(mach_trap_table[0]));
  * hand back MACH_VOUCHER_NULL ("no voucher"), which libdispatch accepts,
  * rather than an error it treats as fatal.
  */
+/*
+ * mach_generate_activity_id (trap 43 in later kernels; map_fd here):
+ * libdispatch and libsystem_trace take activity IDs from it and abort
+ * if it fails. IDs only need to be unique and non-zero.
+ */
+kern_return_t
+rpi3_mach_generate_activity_id_trap(struct rpi3_mach_generate_activity_id_args *args)
+{
+	static volatile SInt64 rpi3_activity_id_next = 1;
+	uint64_t id;
+
+	if (args->count <= 0 || args->count > 4096 || args->activity_id == 0)
+		return KERN_INVALID_ARGUMENT;
+	id = (uint64_t)OSAddAtomic64(args->count, &rpi3_activity_id_next);
+	if (copyout(&id, (user_addr_t)args->activity_id, sizeof(id)))
+		return KERN_INVALID_ADDRESS;
+	return KERN_SUCCESS;
+}
+
 kern_return_t
 rpi3_host_create_mach_voucher_trap(struct rpi3_host_create_mach_voucher_args *args)
 {
