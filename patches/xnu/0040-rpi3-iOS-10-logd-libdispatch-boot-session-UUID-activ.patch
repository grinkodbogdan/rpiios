index 37fcd08..ba9bc19 100644
--- a/.rpiios-patches
+++ b/.rpiios-patches
@@ -1 +1 @@
-c52a121ef54bcda7
+49f3b435dfabc2f9
diff --git a/xnu/bsd/kern/kern_event.c b/xnu/bsd/kern/kern_event.c
index 23d729f..8bc9570 100644
--- a/xnu/bsd/kern/kern_event.c
+++ b/xnu/bsd/kern/kern_event.c
@@ -1852,6 +1852,14 @@ kevent_register(struct kqueue *kq, struct kevent64_s *kev, __unused struct proc
 			kev->fflags = 0;
 			kev->data = 0;
 			kn->kn_kevent = *kev;
+#if BOARD_CONFIG_RASPBERRYPI3
+			/*
+			 * EV_VANISHED (0x0200) on registration only says the
+			 * caller copes with vanishing sources; it must not come
+			 * back on delivered events (libdispatch aborts on it).
+			 */
+			kn->kn_flags &= ~0x0200;
+#endif
 			kn->kn_inuse = 1;  /* for f_attach() */
 			kn->kn_status = KN_ATTACHING;
 
diff --git a/xnu/bsd/kern/kern_sysctl.c b/xnu/bsd/kern/kern_sysctl.c
index e8b7f9d..ab8c100 100644
--- a/xnu/bsd/kern/kern_sysctl.c
+++ b/xnu/bsd/kern/kern_sysctl.c
@@ -2321,6 +2321,39 @@ SYSCTL_PROC(_kern, OID_AUTO, bootargs,
 	NULL, 0,
 	sysctl_sysctl_bootargs, "A", "bootargs");
 
+#if BOARD_CONFIG_RASPBERRYPI3
+/*
+ * kern.bootsessionuuid (later kernels): a UUID made fresh at each boot.
+ * iOS 10's libsystem_trace stamps logs with it and aborts without it,
+ * which leaves logd unable to serve anyone.
+ */
+#include <sys/random.h>
+STATIC int
+sysctl_bootsessionuuid
+(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	static char uuid_string[37];
+
+	if (!uuid_string[0]) {
+		uint8_t u[16];
+
+		read_random(u, sizeof(u));
+		u[6] = (u[6] & 0x0f) | 0x40;	/* version 4 */
+		u[8] = (u[8] & 0x3f) | 0x80;
+		snprintf(uuid_string, sizeof(uuid_string),
+		    "%02X%02X%02X%02X-%02X%02X-%02X%02X-%02X%02X-%02X%02X%02X%02X%02X%02X",
+		    u[0], u[1], u[2], u[3], u[4], u[5], u[6], u[7], u[8], u[9],
+		    u[10], u[11], u[12], u[13], u[14], u[15]);
+	}
+	return (sysctl_io_string(req, uuid_string, sizeof(uuid_string), 0, NULL));
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, bootsessionuuid,
+	CTLFLAG_LOCKED | CTLFLAG_RD | CTLFLAG_KERN | CTLTYPE_STRING,
+	NULL, 0,
+	sysctl_bootsessionuuid, "A", "");
+#endif
+
 SYSCTL_INT(_kern, KERN_MAXFILES, maxfiles, 
 		CTLFLAG_RW | CTLFLAG_KERN | CTLFLAG_LOCKED,
 		&maxfiles, 0, "");
diff --git a/xnu/osfmk/arm/trap.c b/xnu/osfmk/arm/trap.c
index 9d1ff8d..e389089 100644
--- a/xnu/osfmk/arm/trap.c
+++ b/xnu/osfmk/arm/trap.c
@@ -404,11 +404,31 @@ static void rpi3_watchdog(__unused void *arg, __unused wait_result_t wr)
                        s->pc, s->lr, s->r[12], s->r[0]);
                 if ((round % 6) == 5 &&
                     (!strncmp(proc_name_address(task->bsd_info), "backboardd", 10) ||
+                     !strcmp(proc_name_address(task->bsd_info), "logd") ||
                      !strncmp(proc_name_address(task->bsd_info), "SpringBoard", 11)))
                     kprintf("rpi3 wd: %s[%d].%u st=%x ev=%08x k=%08x pc=%08x lr=%08x sp=%08x r12=%x r0=%x\n",
                             proc_name_address(task->bsd_info), proc_pid(task->bsd_info), k,
                             th->state, (uint32_t) th->wait_event, (uint32_t) th->continuation,
                             s->pc, s->lr, s->sp, s->r[12], s->r[0]);
+                if ((round % 6) == 5 &&
+                    (!strncmp(proc_name_address(task->bsd_info), "backboardd", 10) ||
+                     !strcmp(proc_name_address(task->bsd_info), "logd") ||
+                     !strncmp(proc_name_address(task->bsd_info), "SpringBoard", 11))) {
+                    uint32_t fp = s->r[7], frame[2];
+                    unsigned f;
+
+                    kprintf("rpi3 wd bt: %s[%d].%u", proc_name_address(task->bsd_info),
+                            proc_pid(task->bsd_info), k);
+                    for (f = 0; f < 14 && fp; f++) {
+                        if (copyinmap(task->map, fp, frame, sizeof(frame)) != KERN_SUCCESS)
+                            break;
+                        kprintf(" %08x", frame[1]);
+                        if (frame[0] <= fp)
+                            break;
+                        fp = frame[0];
+                    }
+                    kprintf("\n");
+                }
                 if (k == 1 &&
                     ((proc_pid(task->bsd_info) == 1 && (th->state & TH_RUN)) ||
                      !strncmp(proc_name_address(task->bsd_info), "SpringBoard", 11)))
@@ -1133,6 +1153,30 @@ void sleh_undef(arm_saved_state_t * state)
          * dyld's faulting one. I really just need to redo all of the VFP detection
          * code, which will happen one day... I just hate myself for this.
          */
+#if BOARD_CONFIG_RASPBERRYPI3
+        /*
+         * Permanently undefined encodings (Thumb "trap" 0xdeXX, ARM UDF), or
+         * any undefined instruction while VFP is already on, are real
+         * faults: iOS 10's libraries crash this way on purpose. Treating
+         * them as a VFP-enable request re-ran the instruction forever.
+         */
+        {
+            uint32_t fpexc, word = 0;
+            uint16_t half = 0;
+            int udf;
+
+            if (arm_ctx->cpsr & (1 << 5)) {
+                udf = copyin((user_addr_t) arm_ctx->pc, &half, sizeof(half)) == 0 &&
+                    (half & 0xff00) == 0xde00;
+            } else {
+                udf = copyin((user_addr_t) arm_ctx->pc, &word, sizeof(word)) == 0 &&
+                    (word & 0x0ff000f0) == 0x07f000f0;
+            }
+            __asm__ volatile("mrc p10, 7, %0, c8, c0, 0" : "=r"(fpexc));
+            if (udf || (fpexc & (1U << 30)))
+                instruction = 0xfedeffe7;
+        }
+#endif
         if(instruction != 0xfedeffe7)
         {
             /*
@@ -1189,6 +1233,11 @@ void sleh_undef(arm_saved_state_t * state)
          */
         exception_type = EXC_BAD_INSTRUCTION;
         exception_subcode = 0;
+#if BOARD_CONFIG_RASPBERRYPI3
+        kprintf("rpi3: %s[%d] undefined instruction pc 0x%08x lr 0x%08x r7 0x%08x r8 0x%08x\n",
+                proc_name_address(thread->task->bsd_info), proc_pid(thread->task->bsd_info),
+                arm_ctx->pc, arm_ctx->lr, arm_ctx->r[7], arm_ctx->r[8]);
+#endif
     } else if (cpsr == 0x17) {
         panic("sleh_undef: undefined instruction in system mode");
     }
